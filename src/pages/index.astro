---
import SiteHeader from "../components/SiteHeader.astro";
import PageFooter from "../components/PageFooter.astro";
import GoogleAnalytics from "../components/GoogleAnalytics.astro";
import Fonts from "../components/Fonts.astro";
import SiteSchema from "../components/SiteSchema.astro";
import "../styles/global.css";

const siteTitle = "Insurance Calculator – Estimate Insurance Costs | InsureEstimate";
const siteDescription = "Estimate insurance costs with free online calculators for renters and small businesses. Explore coverage costs by state, profession, and industry.";
const canonicalUrl = "https://insureestimate.com/";
const ogImageUrl = "https://insureestimate.com/images/og-image.png";

const popularStates = [
  { name: "California", slug: "california" },
  { name: "Texas", slug: "texas" },
  { name: "Florida", slug: "florida" },
  { name: "New York", slug: "new-york" },
  { name: "Pennsylvania", slug: "pennsylvania" },
  { name: "Ohio", slug: "ohio" },
  { name: "North Carolina", slug: "north-carolina" },
  { name: "Illinois", slug: "illinois" },
];

const popularProfessions = [
  { name: "Freelance Photographer", slug: "freelance-photographer" },
  { name: "Web Designer", slug: "web-designer" },
  { name: "General Contractor", slug: "general-contractor" },
  { name: "Graphic Designer", slug: "graphic-designer" },
  { name: "Business Consultant", slug: "business-consultant" },
  { name: "Electrician", slug: "electrician" },
  { name: "Personal Trainer", slug: "personal-trainer" },
  { name: "Handyman", slug: "handyman" },
];

const faqList = [
  {
    question: "What is an online insurance calculator?",
    answer: "An online insurance calculator is an independent digital tool that helps consumers and small business owners estimate potential insurance costs based on state location, coverage choices, annual revenue, and property values. It offers an estimated price range before you begin shopping for binding quotes."
  },
  {
    question: "How does the InsureEstimate insurance cost calculator work?",
    answer: "Our engine evaluates public actuarial filings, state baseline averages, and industry-specific risk benchmarks. You select your state or profession, adjust coverage limits and deductibles, and the tool models a dynamic premium range tailored to your selections."
  },
  {
    question: "Is this an official insurance quote?",
    answer: "No. InsureEstimate provides non-binding price estimates for planning purposes, not official insurance quotes. Actual policy premiums depend on individual carrier underwriting guidelines, credit history, claims background, and specific endorsements."
  },
  {
    question: "Why do insurance costs vary by state and profession?",
    answer: "Insurance rates reflect localized risk exposure. Renters insurance rates depend on state weather perils (such as severe storms, wildfires, or flood risk) and local property replacement costs. Business insurance premiums vary by industry risk tier, annual revenue, and workforce count."
  },
  {
    question: "Why are insurance estimates presented as a range rather than an exact price?",
    answer: "Insurance carriers utilize proprietary underwriting criteria that factor in credit history, safety discount programs, loss history, and specific endorsements. Presenting an estimated range accurately reflects real-world market variance across top carriers."
  },
  {
    question: "Is InsureEstimate free and compliant with privacy standards?",
    answer: "Yes. InsureEstimate is completely free to use. We do not require account registration, personal contact details, or financial background checks to model insurance estimates."
  }
];

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "InsureEstimate Insurance Cost Calculator",
  "operatingSystem": "All",
  "applicationCategory": "FinanceApplication",
  "url": canonicalUrl,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqList.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<!doctype html>
<html lang="en">
  <head>
    <GoogleAnalytics />

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{siteTitle}</title>
    <meta name="description" content={siteDescription} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph Meta Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="InsureEstimate" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="InsureEstimate insurance cost calculator" />

    <!-- Twitter / X Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={siteDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content="InsureEstimate insurance cost calculator" />

    <Fonts />

    <SiteSchema />

    <!-- JSON-LD Structured Data (Organization + WebSite schema is site-wide via PageFooter.astro) -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </head>
  <body class="bg-canvas font-sans text-ink antialiased">
    <SiteHeader active="Home" />

    <main class="w-full pt-16">
      <!-- Hero -->
      <section class="relative overflow-hidden border-b border-hairline">
        <div class="hero-mesh pointer-events-none absolute inset-x-0 -top-24 h-[560px]" aria-hidden="true"></div>

        <div class="container-page relative pb-16 pt-16 md:pb-24 md:pt-24">
          <div class="mx-auto flex max-w-3xl flex-col items-center gap-6 text-center">
            <span class="badge bg-elevated/80 backdrop-blur">
              <span class="h-1.5 w-1.5 rounded-full bg-brand" aria-hidden="true"></span>
              Actuarial Cost Modeling
            </span>
            <h1 class="title-display">
              <span class="block">Insurance Cost Calculator</span>
              <span class="block">Estimate Premiums with Confidence</span>
            </h1>
            <p class="lead max-w-2xl">
              Model renters and small business insurance premiums using public actuarial filings and localized risk benchmarks. Calculate estimates by state or profession with zero sales pressure.
            </p>
          </div>

          <!-- Entry points -->
          <div class="relative z-10 mx-auto mt-12 grid max-w-4xl grid-cols-1 gap-4 md:mt-16 md:grid-cols-2">
            <a href="/renters-insurance-calculator/" class="card-link group flex flex-col p-6 shadow-md md:p-8">
              <div class="mb-8 flex items-center justify-between">
                <span class="icon-tile h-10 w-10">
                  <span class="material-symbols-outlined text-[22px]">home_work</span>
                </span>
                <span class="badge">50 States Covered</span>
              </div>
              <h2 class="text-2xl font-semibold leading-8 tracking-[-0.9px] text-ink">Renters Insurance Calculator</h2>
              <p class="mt-2 text-body-md text-body">
                Estimate monthly renters insurance costs tailored by state, personal belongings coverage, deductible choices, and liability protection caps.
              </p>
              <div class="mt-8 flex flex-wrap items-end justify-between gap-4 border-t border-hairline pt-5">
                <div class="flex flex-col gap-1">
                  <span class="eyebrow">Avg Rate</span>
                  <span class="num whitespace-nowrap text-[28px] font-semibold leading-8 tracking-[-1px] text-ink">$15 – $22<span class="ml-1 text-body-md font-normal tracking-normal text-mute">/mo</span></span>
                </div>
                <span class="btn-sm pointer-events-none">Calculate Now</span>
              </div>
            </a>

            <a href="/business-insurance-calculator/" class="card-link group flex flex-col p-6 shadow-md md:p-8">
              <div class="mb-8 flex items-center justify-between">
                <span class="icon-tile h-10 w-10">
                  <span class="material-symbols-outlined text-[22px]">business_center</span>
                </span>
                <span class="badge">35+ Professions</span>
              </div>
              <h2 class="text-2xl font-semibold leading-8 tracking-[-0.9px] text-ink">Business Insurance Calculator</h2>
              <p class="mt-2 text-body-md text-body">
                Project General Liability and Professional E&amp;O premiums based on industry risk tier, annual revenue, and employee headcount.
              </p>
              <div class="mt-8 flex flex-wrap items-end justify-between gap-4 border-t border-hairline pt-5">
                <div class="flex flex-col gap-1">
                  <span class="eyebrow">Avg Rate</span>
                  <span class="num whitespace-nowrap text-[28px] font-semibold leading-8 tracking-[-1px] text-ink">$400 – $850<span class="ml-1 text-body-md font-normal tracking-normal text-mute">/yr</span></span>
                </div>
                <span class="btn-sm pointer-events-none">Calculate Now</span>
              </div>
            </a>
          </div>

          <!-- Financial / YMYL disclosure -->
          <p class="mx-auto mt-6 max-w-3xl text-center text-body-sm text-mute">
            <span class="material-symbols-outlined mr-1 align-[-3px] text-[15px] text-brand-ink">verified_user</span><strong class="font-medium text-body">Financial Planning Notice:</strong> Estimates generated on this platform are non-binding projections based on state baseline data and industry risk factors. InsureEstimate is an independent educational calculation tool and does not sell insurance directly.
          </p>
        </div>
      </section>

      <!-- How it works (editorial) -->
      <section class="section">
        <div class="container-page grid grid-cols-1 gap-10 lg:grid-cols-[320px_minmax(0,1fr)] lg:gap-16">
          <div class="flex flex-col gap-3 lg:sticky lg:top-28 lg:self-start">
            <span class="eyebrow">Underwriting Framework</span>
            <h2 class="title-section">How Our Insurance Cost Calculator Works</h2>
          </div>

          <div class="flex flex-col gap-16">
            <div class="prose-body">
              <p>
                InsureEstimate.com provides a free, independent <strong>insurance calculator online</strong> designed to help tenants and small business owners understand potential coverage expenses. Securing transparent insurance estimates traditionally required submitting personal contact information or speaking with aggressive sales brokers. Our <strong>insurance cost estimator</strong> simplifies this process by evaluating published regulatory filings to model realistic premium expectations in seconds.
              </p>
              <p>
                When you adjust coverage parameters on our site, the calculation engine evaluates baseline pricing metrics derived from statutory rate filings submitted to state insurance departments. By fine-tuning settings such as personal belongings value, annual business revenue, deductible thresholds, and liability coverage limits, you can project an <strong>estimated premium</strong> range that aligns with your specific risk profile.
              </p>
            </div>

            <div class="flex flex-col gap-6">
              <div class="flex flex-col gap-3">
                <h2 class="text-2xl font-semibold leading-8 tracking-[-0.9px] text-ink">Key Factors That Determine Your Premium</h2>
                <p class="prose-body">
                  Insurance premiums vary across carriers because underwriting algorithms evaluate statistical loss probabilities. Key factors influencing your <strong>insurance cost estimate</strong> include:
                </p>
              </div>
              <div class="grid grid-cols-1 overflow-hidden rounded-xl border border-hairline bg-hairline sm:grid-cols-2" style="gap: 1px;">
                <div class="flex flex-col gap-3 bg-elevated p-6">
                  <span class="icon-tile"><span class="material-symbols-outlined text-[20px]">location_on</span></span>
                  <h3 class="text-body-lg font-semibold text-ink">Geographic Risk &amp; Location</h3>
                  <p class="text-body-md text-body">Regional weather perils (such as severe hail, coastal hurricanes, or winter pipe bursts), localized crime statistics, and regional replacement costs directly calibrate state base rates.</p>
                </div>
                <div class="flex flex-col gap-3 bg-elevated p-6">
                  <span class="icon-tile"><span class="material-symbols-outlined text-[20px]">shield</span></span>
                  <h3 class="text-body-lg font-semibold text-ink">Selected Coverage Limits</h3>
                  <p class="text-body-md text-body">Higher personal property limits or increased commercial General Liability caps raise the maximum potential payout for insurers, adjusting recurring monthly premiums.</p>
                </div>
                <div class="flex flex-col gap-3 bg-elevated p-6">
                  <span class="icon-tile"><span class="material-symbols-outlined text-[20px]">tune</span></span>
                  <h3 class="text-body-lg font-semibold text-ink">Deductible Selection</h3>
                  <p class="text-body-md text-body">Opting for a higher out-of-pocket deductible ($1,000 vs $500) reduces recurring premium costs, whereas a lower deductible increases monthly payments.</p>
                </div>
                <div class="flex flex-col gap-3 bg-elevated p-6">
                  <span class="icon-tile"><span class="material-symbols-outlined text-[20px]">domain</span></span>
                  <h3 class="text-body-lg font-semibold text-ink">Industry Risk Classification</h3>
                  <p class="text-body-md text-body">For small businesses, high-risk trades (such as roofing or electrical contracting) carry higher baseline liability premiums than low-risk office professions like consulting.</p>
                </div>
              </div>
            </div>

            <!-- Renters & business summaries -->
            <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
              <div class="well flex flex-col gap-2 p-6">
                <h3 class="text-body-lg font-semibold text-ink">Renters Insurance Projections</h3>
                <p class="text-body-md text-body">
                  Across the US, average renters rates range between $15 and $22 per month for baseline policy limits ($20k property, $100k liability, $500 deductible). Modeling state-specific baseline rates helps tenants budget accurately.
                </p>
              </div>
              <div class="well flex flex-col gap-2 p-6">
                <h3 class="text-body-lg font-semibold text-ink">Small Business Projections</h3>
                <p class="text-body-md text-body">
                  Commercial policies scale with annual revenue, employee count, and industry risk rating. Solo freelancers typically pay $350–$600/yr for General Liability, while active trade contractors average $800–$1,500/yr.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Popular states & professions -->
      <section class="section border-y border-hairline bg-elevated">
        <div class="container-page flex flex-col gap-16">
          <div>
            <div class="mb-6 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
              <div class="flex flex-col gap-2">
                <h2 class="text-2xl font-semibold leading-8 tracking-[-0.9px] text-ink">Renters Insurance Cost by State</h2>
                <p class="text-body-md text-body">Explore localized baseline rates and coverage guidelines across popular states.</p>
              </div>
              <a href="/renters-insurance-calculator/" class="btn-ghost-sm self-start sm:self-auto">View All 50 States</a>
            </div>
            <div class="grid grid-cols-2 gap-2 sm:grid-cols-4 sm:gap-3">
              {popularStates.map((state) => (
                <a href={`/renters-insurance-calculator/${state.slug}/`} class="row-link group">
                  <span class="truncate">{state.name}</span>
                  <span class="material-symbols-outlined shrink-0 text-[18px] text-faint group-hover:text-ink">chevron_right</span>
                </a>
              ))}
            </div>
          </div>

          <div>
            <div class="mb-6 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
              <div class="flex flex-col gap-2">
                <h2 class="text-2xl font-semibold leading-8 tracking-[-0.9px] text-ink">Business Insurance Cost by Profession</h2>
                <p class="text-body-md text-body">Find commercial coverage estimates tailored for your specific industry.</p>
              </div>
              <a href="/business-insurance-calculator/" class="btn-ghost-sm self-start sm:self-auto">View All Professions</a>
            </div>
            <div class="grid grid-cols-1 gap-2 min-[420px]:grid-cols-2 sm:grid-cols-4 sm:gap-3">
              {popularProfessions.map((profession) => (
                <a href={`/business-insurance-calculator/${profession.slug}/`} class="row-link group">
                  <span class="truncate">{profession.name}</span>
                  <span class="material-symbols-outlined shrink-0 text-[18px] text-faint group-hover:text-ink">chevron_right</span>
                </a>
              ))}
            </div>
          </div>

          <!-- Governance quick links -->
          <nav class="flex flex-wrap items-center gap-x-6 gap-y-2 border-t border-hairline pt-8 text-body-md" aria-label="Governance and legal">
            <span class="font-medium text-ink">Governance &amp; Legal</span>
            <a href="/about/" class="link-quiet">About InsureEstimate</a>
            <a href="/contact/" class="link-quiet">Contact Support</a>
            <a href="/privacy-policy/" class="link-quiet">Privacy Policy</a>
            <a href="/terms-and-conditions/" class="link-quiet">Terms &amp; Conditions</a>
          </nav>
        </div>
      </section>

      <!-- FAQ -->
      <section class="section pb-0">
        <div class="container-page grid grid-cols-1 gap-10 lg:grid-cols-[320px_minmax(0,1fr)] lg:gap-16">
          <div class="flex flex-col gap-3">
            <h2 class="title-section">Frequently Asked Questions</h2>
            <p class="text-body-md text-body">Common queries regarding insurance estimation models and policy choices.</p>
          </div>

          <div class="flex flex-col gap-6">
            <div class="faq-list">
              {faqList.map((faq) => (
                <details class="faq-item">
                  <summary>
                    <span>{faq.question}</span>
                    <span class="material-symbols-outlined faq-icon">add</span>
                  </summary>
                  <p class="faq-body">{faq.answer}</p>
                </details>
              ))}
            </div>

            <div class="flex flex-col gap-1 text-body-sm text-mute">
              <p class="font-medium text-body">Reviewed by InsureEstimate Actuarial &amp; Risk Research Team</p>
              <p>Last Updated: Q3 2026 • Published under State Insurance Department Regulatory Guidelines</p>
            </div>
          </div>
        </div>
      </section>
    </main>

    <PageFooter />
  </body>
</html>
