---
import { getCollection, getEntry } from 'astro:content';
import SiteHeader from '../../components/SiteHeader.astro';
import PageFooter from '../../components/PageFooter.astro';
import EntityHero from '../../components/EntityHero.astro';
import CalculatorCard from '../../components/CalculatorCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import {
  getBusinessStandardPremium,
  calculateNationalBusinessAverage
} from '../../lib/calculators/standardProfile';
import { siteCopy } from '../../lib/site';
import GoogleAnalytics from '../../components/GoogleAnalytics.astro';
import Fonts from '../../components/Fonts.astro';
import SiteSchema from '../../components/SiteSchema.astro';
import { BUSINESS_FACTORS } from '../../lib/calculators/factors';
import { professionMetaDescription } from '../../lib/seo';
import '../../styles/global.css';

export async function getStaticPaths() {
  return (await getCollection('professions')).map(({ data }) => ({ params: { profession: data.slug } }));
}

const profession = await getEntry('professions', Astro.params.profession!);
if (!profession) return Astro.redirect('/');
const { data } = profession;
const title = data.seoTitle || `Business Insurance Cost for ${data.name}`;

const allProfessions = await getCollection('professions');
const nationalAvgAnnual = calculateNationalBusinessAverage(allProfessions.map(p => p.data.riskFactor));

const standardEst = getBusinessStandardPremium(data.riskFactor);
const derivedAnnualCost = standardEst.annual;
const derivedMonthlyCost = standardEst.monthly;

// Hand-written seoDescription wins; otherwise build one from this profession's own numbers and risks.
const description = data.seoDescription?.trim() || professionMetaDescription({
  name: data.name,
  glAnnual: derivedAnnualCost,
  glEoAnnual: derivedAnnualCost + BUSINESS_FACTORS.eoAddonFlat,
  riskTitles: (data.riskFactors || []).map(rf => rf.title),
});

const industryContext = data.industryContext || {
  typicalRevenueTier: "0-50k",
  typicalEmployeeCount: data.typicalEmployeeRange || "1",
  contextNote: ""
};

const validRiskFactors = (data.riskFactors || []).filter(
  rf => (rf.title && rf.title.trim() !== '') || (rf.description && rf.description.trim() !== '')
);

const claimScenarios = (data.claimScenarios || []).filter(
  cs => cs.title.trim() !== '' && cs.scenario.trim() !== ''
);

const validFaqs = (data.faqs || []).filter(
  f => f.question && f.question.trim() !== '' && f.answer && f.answer.trim() !== ''
);

const blogContent = data.blogContent || { whyThisRiskFactor: "", howCalculated: "", comparisonNote: "" };
const hasBlogContent = Boolean(
  blogContent.whyThisRiskFactor?.trim() ||
  blogContent.howCalculated?.trim() ||
  blogContent.comparisonNote?.trim()
);

const isDev = import.meta.env.DEV;

const ICON_MAP: Record<string, string> = {
  // Weather & Perils
  wind: 'air',
  waves: 'waves',
  droplet: 'water_drop',
  drop: 'water_drop',
  water: 'water_drop',
  rain: 'water_drop',
  storm: 'thunderstorm',
  hurricane: 'cyclone',
  tornado: 'tornado',
  fire: 'local_fire_department',
  flood: 'flood',
  hail: 'ac_unit',
  snow: 'ac_unit',
  snowflake: 'ac_unit',
  cold: 'ac_unit',
  earthquake: 'landslide',
  seismic: 'landslide',
  activity: 'landslide',

  // Logistics & Business
  package: 'package_2',
  box: 'package_2',
  shipping: 'local_shipping',
  truck: 'local_shipping',
  gavel: 'gavel',
  security: 'security',
  description: 'description',
  volcano: 'volcano',
  water_damage: 'water_damage',
  shield: 'shield',
  briefcase: 'work',
  tool: 'construction',
  building: 'domain',
  person: 'person',
  medical: 'medical_services'
};

function getIconName(iconName?: string): string {
  if (!iconName || !iconName.trim()) return 'shield';
  const key = iconName.toLowerCase().trim();
  return ICON_MAP[key] || key;
}

const maxRate = Math.max(derivedAnnualCost, nationalAvgAnnual) * 1.2;
const professionPct = Math.min(100, Math.max(10, Math.round((derivedAnnualCost / maxRate) * 100)));
---

<!DOCTYPE html>
<html lang="en">
<head>
  <GoogleAnalytics />
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title} | InsureEstimate</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={`https://insureestimate.com/business-insurance-calculator/${data.slug}/`} />
  <Fonts />
  <SiteSchema />
</head>
<body class="bg-canvas font-sans text-ink antialiased">
  <SiteHeader active="Business Insurance" />

  <main class="w-full pt-16">
    <!-- Breadcrumbs Navigation -->
    <div class="container-page pt-8">
      <Breadcrumbs items={[
        { label: 'Business Insurance Calculator', href: '/business-insurance-calculator/' },
        { label: data.name }
      ]} />
    </div>

    <!-- Shared Entity Hero -->
    <EntityHero
      title={`Business Insurance Cost for ${data.name}`}
      subtitle={`Model General Liability and Professional E&O coverage requirements tailored to ${data.name.toLowerCase()} operations.`}
      category={data.category || 'Professional Services'}
      badgeText="2026 Actuarial Model"
      statValue={`$${derivedAnnualCost} /yr`}
      statLabel="Derived Baseline Premium"
    />

    <!-- Shared Calculator Card (Connected to Real Engine) -->
    <section id="calculator" class="container-page relative z-10 scroll-mt-24">
      <CalculatorCard
        title={`${data.name} Insurance Estimator`}
        subtitle="Select annual revenue and coverage parameters to compute real-time cost projections."
        type="business"
        entityName={data.name}
        riskFactor={data.riskFactor}
      />
    </section>

    <div class="container-page relative z-10 flex flex-col gap-16 pt-16 md:gap-24 md:pt-24">
      <!-- Market Data & Industry Context Section -->
      <section class="grid grid-cols-1 gap-4 md:grid-cols-2">
        <!-- Market Data Headline Card -->
        <div class="card flex flex-col justify-between p-6 md:p-8">
          <div>
            <span class="eyebrow mb-2 block">Market Data</span>
            <h2 class="title-card mb-4">Average Annual Cost</h2>
            <div class="num mb-4 flex items-baseline gap-2">
              <span class="text-[40px] font-semibold leading-none tracking-[-1.8px] text-ink">${derivedAnnualCost}</span>
              <span class="text-body-md text-mute">/year (${derivedMonthlyCost}/mo)</span>
            </div>
            <p class="text-body-md text-body">
              Derived average premium for a standard solo {data.name.toLowerCase()} policy ($0-50k revenue tier, General Liability coverage).
            </p>
          </div>
          <div class="mt-6 border-t border-hairline pt-4">
            <div class="num mb-2 flex justify-between gap-4 font-mono text-[12px] text-mute">
              <span class="text-ink">{data.name} Benchmark (${derivedAnnualCost})</span>
              <span class="text-right">National Industry Avg (${nationalAvgAnnual})</span>
            </div>
            <div class="flex h-1.5 w-full overflow-hidden rounded-full bg-hairline">
              <div class="rounded-full bg-ink" style={`width: ${professionPct}%`}></div>
            </div>
          </div>
        </div>

        <!-- Industry Context Card -->
        <div class="card flex flex-col justify-between p-6 md:p-8">
          <div>
            <span class="eyebrow mb-2 block">Operational Context</span>
            <h2 class="title-card mb-4">Industry Profile</h2>
            <ul class="num mb-4 flex flex-col divide-y divide-hairline text-body-md">
              <li class="flex justify-between py-2.5 first:pt-0">
                <span class="text-body">Typical Revenue Tier</span>
                <span class="font-mono text-[13px] font-medium text-ink">{industryContext.typicalRevenueTier}</span>
              </li>
              <li class="flex justify-between py-2.5">
                <span class="text-body">Typical Team Size</span>
                <span class="font-mono text-[13px] font-medium text-ink">{industryContext.typicalEmployeeCount}</span>
              </li>
              <li class="flex justify-between py-2.5">
                <span class="text-body">Actuarial Risk Rating</span>
                <span class="font-mono text-[13px] font-medium text-ink">{data.riskFactor} multiplier</span>
              </li>
            </ul>
          </div>
          {industryContext.contextNote?.trim() ? (
            <p class="border-t border-hairline pt-4 text-body-md text-body">
              {industryContext.contextNote}
            </p>
          ) : isDev ? (
            <p class="border-t border-hairline pt-4 text-body-sm italic text-mute">
              [Dev Mode] Industry context note coming soon.
            </p>
          ) : (
            <p class="border-t border-hairline pt-4 text-body-md text-body">
              Baseline profiles reflect common operational structures for small-to-midsize {data.name.toLowerCase()} businesses.
            </p>
          )}
        </div>
      </section>

      <!-- Risk Factors Section -->
      {(validRiskFactors.length > 0 || isDev) && (
        <section class="flex flex-col gap-8">
          <div class="flex flex-col gap-3">
            <span class="eyebrow">Exposure Analysis</span>
            <h2 class="title-section">Key Risk Factors for {data.name}</h2>
          </div>

          {validRiskFactors.length > 0 ? (
            <div class={`grid gap-4 ${
              validRiskFactors.length === 2 ? 'grid-cols-1 sm:grid-cols-2' :
              validRiskFactors.length === 4 ? 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-4' :
              'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3'
            }`}>
              {validRiskFactors.map(rf => (
                <div class="card flex flex-col gap-3 p-6">
                  <span class="icon-tile">
                    <span class="material-symbols-outlined text-[20px]">{getIconName(rf.icon)}</span>
                  </span>
                  {rf.title && <h3 class="text-body-lg font-semibold text-ink">{rf.title}</h3>}
                  {rf.description && <p class="text-body-md text-body">{rf.description}</p>}
                </div>
              ))}
            </div>
          ) : (
            <div class="rounded-xl border border-dashed border-hairline bg-canvas p-6 text-body-sm italic text-mute">
              [Dev Mode] Specific risk factors for {data.name} will appear here once written.
            </div>
          )}
        </section>
      )}

      <!-- Claim Scenarios Section -->
      {claimScenarios.length > 0 && (
        <section class="flex flex-col gap-8">
          <div class="flex flex-col gap-3">
            <span class="eyebrow">Claim Scenarios</span>
            <h2 class="title-section">How {data.name} Claims Typically Happen</h2>
            <p class="text-body-md text-body">Illustrative examples of common claim patterns, not records of specific claims.</p>
          </div>
          <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
            {claimScenarios.map(cs => (
              <div class="card flex flex-col gap-3 p-6">
                <h3 class="text-body-lg font-semibold text-ink">{cs.title}</h3>
                <p class="text-body-md text-body">{cs.scenario}</p>
                <p class="mt-auto rounded-lg bg-canvas p-3 text-body-md text-body">
                  <span class="font-medium text-ink">Coverage that responds:</span> {cs.coverage}
                </p>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Recommended Coverage Fallback / Complement -->
      {data.recommendedCoverage && data.recommendedCoverage.length > 0 && validRiskFactors.length === 0 && !isDev && (
        <section class="flex flex-col gap-8">
          <div class="flex flex-col gap-3">
            <span class="eyebrow">Recommended Policies</span>
            <h2 class="title-section">Standard Coverage for {data.name}</h2>
          </div>
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {data.recommendedCoverage.map((item: string) => (
              <div class="card flex flex-col gap-2 p-6">
                <span class="material-symbols-outlined text-[20px] text-brand-ink">check_circle</span>
                <h3 class="text-body-lg font-semibold text-ink">{item}</h3>
                <p class="text-body-md text-body">
                  Standard baseline coverage for active {data.name.toLowerCase()} commercial contracts.
                </p>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Blog Section -->
      {(hasBlogContent || isDev) && (
        <section class="flex w-full flex-col gap-8">
          <div class="flex flex-col gap-3">
            <span class="eyebrow">Industry Insights</span>
            <h2 class="title-section">Understanding {data.name} Insurance Rates</h2>
          </div>
          {hasBlogContent ? (
            <div class="panel flex flex-col divide-y divide-hairline">
              {blogContent.whyThisRiskFactor?.trim() && (
                <div class="grid grid-cols-1 gap-3 p-6 md:grid-cols-[260px_minmax(0,1fr)] md:gap-10 md:p-8">
                  <h3 class="text-body-lg font-semibold text-ink">Why {data.name} Has a Risk Multiplier of {data.riskFactor}</h3>
                  <p class="prose-body">{blogContent.whyThisRiskFactor}</p>
                </div>
              )}
              {blogContent.howCalculated?.trim() && (
                <div class="grid grid-cols-1 gap-3 p-6 md:grid-cols-[260px_minmax(0,1fr)] md:gap-10 md:p-8">
                  <h3 class="text-body-lg font-semibold text-ink">How Premium Projections Are Modeled</h3>
                  <p class="prose-body">{blogContent.howCalculated}</p>
                </div>
              )}
              {blogContent.comparisonNote?.trim() && (
                <div class="grid grid-cols-1 gap-3 p-6 md:grid-cols-[260px_minmax(0,1fr)] md:gap-10 md:p-8">
                  <h3 class="text-body-lg font-semibold text-ink">Industry &amp; Peer Comparison</h3>
                  <p class="prose-body">{blogContent.comparisonNote}</p>
                </div>
              )}
            </div>
          ) : (
            <div class="rounded-xl border border-dashed border-hairline bg-canvas p-6 text-body-sm italic text-mute">
              [Dev Mode] Editorial insights for {data.name} will appear here once written.
            </div>
          )}
        </section>
      )}

      <!-- FAQ Section -->
      {(validFaqs.length > 0 || isDev) && (
        <section class="grid w-full grid-cols-1 gap-10 lg:grid-cols-[320px_minmax(0,1fr)] lg:gap-16">
          <div class="flex flex-col gap-3">
            <h2 class="title-section">Frequently Asked Questions</h2>
            <p class="text-body-md text-body">Common insurance questions for {data.name} businesses.</p>
          </div>
          {validFaqs.length > 0 ? (
            <>
              <script type="application/ld+json" is:inline set:html={JSON.stringify({
                "@context": "https://schema.org",
                "@type": "FAQPage",
                "mainEntity": validFaqs.map(faq => ({
                  "@type": "Question",
                  "name": faq.question,
                  "acceptedAnswer": {
                    "@type": "Answer",
                    "text": faq.answer
                  }
                }))
              })} />
              <div class="faq-list">
                {validFaqs.map(faq => (
                  <details class="faq-item">
                    <summary>
                      <span>{faq.question}</span>
                      <span class="material-symbols-outlined faq-icon">add</span>
                    </summary>
                    <p class="faq-body">{faq.answer}</p>
                  </details>
                ))}
              </div>
            </>
          ) : (
            <div class="rounded-xl border border-dashed border-hairline bg-canvas p-6 text-center text-body-sm italic text-mute">
              [Dev Mode] FAQ content for {data.name} will appear here once written.
            </div>
          )}
        </section>
      )}

      <!-- Shared Methodology Block -->
      <section id="methodology" class="grid scroll-mt-24 grid-cols-1 items-start gap-10 border-t border-hairline pt-16 md:pt-24 lg:grid-cols-2 lg:gap-16">
        <div class="flex flex-col gap-4">
          <span class="eyebrow">Transparency</span>
          <h2 class="title-section">Actuarial Methodology</h2>
          <p class="prose-body">
            {siteCopy.methodology}
          </p>
          <div class="well mt-4 flex flex-col gap-4 p-6 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex flex-col gap-1">
              <h3 class="text-body-lg font-semibold text-ink">Need a custom estimate?</h3>
              <p class="text-body-md text-body">Explore our full index of profession calculators or review state requirements.</p>
            </div>
            <a href="/business-insurance-calculator/" class="btn-sm shrink-0">
              View All Profession Calculators
            </a>
          </div>
        </div>

        <!-- The actual model, shown as a spec -->
        <div class="overflow-hidden rounded-xl border border-hairline bg-elevated shadow-md">
          <div class="flex items-center justify-between border-b border-hairline bg-canvas px-4 py-2.5">
            <span class="font-mono text-[12px] text-mute">{data.slug}.model</span>
            <span class="badge">GL baseline</span>
          </div>
          <div class="num overflow-x-auto p-4 font-mono text-[13px] leading-7 md:p-5">
            <div class="text-mute">// Business premium for {data.name}</div>
            <div><span class="text-ink">risk</span>&nbsp;&nbsp; <span class="text-faint">=</span> risk_factor <span class="text-faint">×</span> revenue_tier <span class="text-faint">×</span> 100</div>
            <div><span class="text-ink">annual</span> <span class="text-faint">=</span> risk <span class="text-faint">+</span> employees <span class="text-faint">×</span> ${BUSINESS_FACTORS.perEmployeeAddon} <span class="text-faint">+</span> ${BUSINESS_FACTORS.flatAdminBaseline} admin <span class="text-faint">[+</span> ${BUSINESS_FACTORS.eoAddonFlat} E&amp;O<span class="text-faint">]</span></div>
            <div><span class="text-ink">range</span>&nbsp; <span class="text-faint">=</span> annual <span class="text-faint">±</span> {Math.round(BUSINESS_FACTORS.estimateRangePercent * 100)}%</div>
            <div class="mt-4 text-mute">// Standard profile: $0–50k revenue, 1 employee, GL only</div>
            <div>risk_factor&nbsp; <span class="text-faint">=</span> <span class="font-medium text-brand-ink">{data.riskFactor}</span></div>
            <div>revenue_tier <span class="text-faint">=</span> ×{BUSINESS_FACTORS.revenueTier['0-50k'].toFixed(2)}</div>
            <div>employees&nbsp;&nbsp;&nbsp; <span class="text-faint">=</span> 1</div>
            <div class="mt-4 border-t border-dashed border-hairline pt-4"><span class="text-ink">annual</span> <span class="text-faint">≈</span> <span class="font-semibold text-ink">${derivedAnnualCost}/yr</span> <span class="text-mute">(${derivedMonthlyCost}/mo)</span></div>
          </div>
        </div>
      </section>
    </div>
  </main>

  <PageFooter />
</body>
</html>
