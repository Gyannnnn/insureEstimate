---
import { getCollection } from 'astro:content';
import SiteHeader from '../../components/SiteHeader.astro';
import PageFooter from '../../components/PageFooter.astro';
import CalculatorCard from '../../components/CalculatorCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import GoogleAnalytics from '../../components/GoogleAnalytics.astro';
import Fonts from '../../components/Fonts.astro';
import SiteSchema from '../../components/SiteSchema.astro';
import { getBusinessStandardPremium } from '../../lib/calculators/standardProfile';
import '../../styles/global.css';

const professions = await getCollection('professions');

// Group by the categories that actually exist in the content, largest groups first.
const categoriesMap: Record<string, typeof professions> = {};

professions.forEach(p => {
  const cat = p.data.category || 'Professional & Other';
  if (!categoriesMap[cat]) {
    categoriesMap[cat] = [];
  }
  categoriesMap[cat].push(p);
});

const categories = Object.entries(categoriesMap)
  .map(([name, items]) => ({
    name,
    id: `cat-${name.toLowerCase().replace(/[^a-z0-9]/g, '-')}`,
    items: items.sort((a, b) => a.data.name.localeCompare(b.data.name)),
  }))
  .sort((a, b) => b.items.length - a.items.length || a.name.localeCompare(b.name));

const CATEGORY_ICONS: Record<string, string> = {
  'Creative Services': 'palette',
  'Professional Services': 'work',
  'Trades & Construction': 'construction',
  'Personal Care & Beauty': 'content_cut',
  'Fitness & Wellness': 'fitness_center',
  'Food & Hospitality': 'restaurant',
  'Events & Hospitality': 'celebration',
  'Pet Services': 'pets',
  'Educational Services': 'school',
  'Residential & Commercial Services': 'cleaning_services',
};
const iconFor = (category?: string) => CATEGORY_ICONS[category || ''] || 'badge';
const baselineFor = (riskFactor: number) => getBusinessStandardPremium(riskFactor).annual;

const featuredSlugs = ['freelance-photographer', 'it-consultant', 'general-contractor'];
const featuredProfessions = professions.filter(p => featuredSlugs.includes(p.data.slug));
---

<!DOCTYPE html>
<html lang="en">
<head>
  <GoogleAnalytics />
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Business Insurance Cost Estimator by Profession | InsureEstimate</title>
  <meta name="description" content="Estimate small business insurance cost projections by profession. Compare General Liability and Professional Liability rates tailored to your industry.">
  <link rel="canonical" href="https://insureestimate.com/business-insurance-calculator/" />
  <Fonts />
  <SiteSchema />
</head>
<body class="bg-canvas font-sans text-ink antialiased">
  <SiteHeader active="Business Insurance" />

  <main class="w-full pt-16">
    <!-- Hero Section -->
    <section class="container-page relative z-10 flex flex-col gap-8 pb-16 pt-8">
      <!-- Breadcrumbs Navigation -->
      <Breadcrumbs items={[{ label: 'Business Insurance Calculator' }]} />

      <div class="grid grid-cols-1 items-end gap-6 lg:grid-cols-[minmax(0,1fr)_320px] lg:gap-12">
        <div class="flex max-w-3xl flex-col gap-4">
          <div class="flex flex-wrap items-center gap-2">
            <span class="badge">Commercial Risk Directory</span>
            <span class="font-mono text-body-sm text-mute">35+ Profession Actuarial Models</span>
          </div>

          <h1 class="title-page">
            Business Insurance Cost Estimator
          </h1>

          <p class="lead">
            Select your industry or profession to calculate localized General Liability, Professional E&amp;O, and property coverage cost projections based on data-backed actuarial risk models.
          </p>
        </div>

        <!-- Stat Highlight Card -->
        <div class="card flex flex-col justify-between gap-4 p-5 sm:p-6">
          <div class="flex flex-col gap-2">
            <span class="eyebrow">Average Small Business Premium</span>
            <div class="num text-[32px] font-semibold leading-9 tracking-[-1.28px] text-ink lg:text-[36px] lg:leading-10">
              $400 – $850 <span class="text-body-md font-normal tracking-normal text-mute">/ yr</span>
            </div>
          </div>
          <div class="flex items-center gap-2 border-t border-hairline pt-3 text-body-md text-body">
            <span class="material-symbols-outlined text-[16px] text-brand-ink">verified</span>
            Industry Actuarial Benchmarks
          </div>
        </div>
      </div>

      <!-- Shared Calculator Card (Connected to Real Engine) -->
      <div id="calculator" class="w-full scroll-mt-24">
        <CalculatorCard
          title="Interactive Commercial Estimator"
          subtitle="Select annual revenue and team parameters to compute real-time cost projections."
          type="business"
          entityName="All Business Types"
        />
      </div>
    </section>

    <!-- Search & Filter Controls -->
    <section id="profession-search-section" class="relative z-30 scroll-mt-24 border-y md:sticky md:top-16 border-hairline bg-canvas/85 backdrop-blur-md">
      <div class="container-page flex flex-col gap-3 py-3 md:flex-row md:items-center md:gap-6">
        <div class="relative w-full md:w-96 md:shrink-0">
          <span class="material-symbols-outlined pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-[18px] text-mute">search</span>
          <label for="profession-search" class="sr-only">Search professions</label>
          <input id="profession-search" type="search" autocomplete="off" placeholder="Search professions (e.g. Photographer, Contractor)..." class="field-control h-10 pl-9 pr-14" />
          <kbd id="search-shortcut" class="pointer-events-none absolute right-2.5 top-1/2 hidden -translate-y-1/2 rounded border border-hairline bg-canvas px-1.5 py-0.5 font-mono text-[10px] text-mute sm:inline-flex">⌘K</kbd>
        </div>
        <nav class="-mx-4 flex items-center gap-2 overflow-x-auto px-4 pb-1 md:mx-0 md:px-0 md:pb-0" aria-label="Jump to category">
          {categories.map(cat => (
            <a href={`#${cat.id}`} class="chip">{cat.name}</a>
          ))}
        </nav>
      </div>
    </section>

    <!-- Popular / High Intent Section -->
    <section class="container-page relative z-10 pt-16">
      <div class="mb-6 flex items-center gap-4">
        <h2 class="text-2xl font-semibold leading-8 tracking-[-0.9px] text-ink">Popular &amp; High Intent Profiles</h2>
      </div>

      <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
        {featuredProfessions.map(p => (
          <a href={`/business-insurance-calculator/${p.data.slug}/`} class="card-link group flex flex-col justify-between p-6">
            <div>
              <div class="mb-6 flex items-center justify-between gap-2">
                <span class="icon-tile h-10 w-10">
                  <span class="material-symbols-outlined text-[22px]">{iconFor(p.data.category)}</span>
                </span>
                <span class="badge">{p.data.category}</span>
              </div>
              <h3 class="text-heading-md text-ink">{p.data.name}</h3>
              <p class="mt-1 line-clamp-2 text-body-md text-body">Tailored liability models for independent {p.data.name.toLowerCase()} businesses.</p>
            </div>
            <div class="mt-6 flex items-center justify-between border-t border-hairline pt-4">
              <span class="num text-body-md text-mute"><span class="font-semibold text-ink">${baselineFor(p.data.riskFactor)}</span> /yr baseline</span>
              <span class="inline-flex items-center gap-0.5 text-body-md font-medium text-ink">
                View Cost Model
                <span class="material-symbols-outlined text-[18px] text-mute group-hover:text-ink">chevron_right</span>
              </span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Category Directory Grid -->
    <section class="container-page relative z-10 pt-16">
      <div class="flex flex-col gap-12">
        {categories.map(cat => (
          <div id={cat.id} class="profession-category-block scroll-mt-40">
            <div class="mb-4 flex items-baseline gap-3 border-b border-hairline pb-3">
              <h2 class="text-heading-md text-ink">{cat.name}</h2>
              <span class="font-mono text-body-sm text-mute">({cat.items.length} profiles)</span>
            </div>

            <div class="grid grid-cols-1 gap-2 sm:grid-cols-2 sm:gap-3 xl:grid-cols-3">
              {cat.items.map(p => (
                <a href={`/business-insurance-calculator/${p.data.slug}/`} class="profession-card card-link group flex items-center gap-3 p-3" data-name={p.data.name.toLowerCase()}>
                  <span class="icon-tile text-body group-hover:text-ink">
                    <span class="material-symbols-outlined text-[20px]">{iconFor(p.data.category)}</span>
                  </span>
                  <span class="flex min-w-0 flex-1 flex-col">
                    <span class="truncate text-body-md font-medium text-ink">{p.data.name}</span>
                    <span class="num text-body-sm text-mute">From ${baselineFor(p.data.riskFactor)}/yr baseline</span>
                  </span>
                  <span class="material-symbols-outlined shrink-0 text-[18px] text-faint group-hover:text-ink">chevron_right</span>
                </a>
              ))}
            </div>
          </div>
        ))}

        <div id="profession-empty" hidden class="rounded-xl border border-dashed border-hairline bg-elevated p-10 text-center">
          <p class="text-body-lg font-medium text-ink">No professions match your search.</p>
          <p class="mt-1 text-body-md text-body">Try a broader term, or use the estimator above with your revenue and team size.</p>
        </div>
      </div>
    </section>

    <!-- Missing Profession CTA -->
    <section class="mt-24 w-full border-y border-hairline bg-elevated py-20 md:py-24">
      <div class="container-page flex max-w-3xl flex-col items-center text-center">
        <h2 class="title-section">Don't see your specific profession?</h2>
        <p class="lead mt-4 max-w-xl">
          Our proprietary modeling engine can generate a custom risk profile and estimate for nearly any small business type.
        </p>
        <div class="mt-8 flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
          <a class="btn-primary" href="#calculator">
            Build Custom Estimate
          </a>
          <a class="btn-secondary" href="/renters-insurance-calculator/">
            Explore Renters Calculators
          </a>
        </div>
      </div>
    </section>
  </main>

  <PageFooter />

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // Search Filter Script
      const searchInput = document.getElementById('profession-search') as HTMLInputElement;
      const cards = document.querySelectorAll('.profession-card');
      const blocks = document.querySelectorAll<HTMLElement>('.profession-category-block');
      const emptyState = document.getElementById('profession-empty');

      searchInput?.addEventListener('input', (e) => {
        const query = (e.target as HTMLInputElement).value.toLowerCase().trim();
        cards.forEach((card) => {
          const name = card.getAttribute('data-name') || '';
          if (name.includes(query)) {
            (card as HTMLElement).style.display = 'flex';
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });

        // Hide category groups left empty by the filter, and say so when nothing matches.
        let visibleBlocks = 0;
        blocks.forEach((block) => {
          const hasMatch = Array.from(block.querySelectorAll<HTMLElement>('.profession-card')).some(c => c.style.display !== 'none');
          block.hidden = !hasMatch;
          if (hasMatch) visibleBlocks++;
        });
        if (emptyState) emptyState.hidden = visibleBlocks > 0;
      });

      // Show the right shortcut hint for the platform.
      const shortcut = document.getElementById('search-shortcut');
      if (shortcut && !/Mac|iPhone|iPad/.test(navigator.userAgent)) shortcut.textContent = 'Ctrl K';

      document.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
          e.preventDefault();
          searchInput?.focus();
        }
      });
    });
  </script>
</body>
</html>
