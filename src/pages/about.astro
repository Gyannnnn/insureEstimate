---
import SiteHeader from '../components/SiteHeader.astro';
import PageFooter from '../components/PageFooter.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import '../styles/global.css';

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'About Us' }
];

const coreValues = [
  {
    icon: 'calculate',
    title: 'Actuarial Transparency',
    description: 'We demystify complex insurance rate structures by exposing base state rates, risk multipliers, and coverage tier factors derived from statutory filings.'
  },
  {
    icon: 'shield',
    title: 'Unbiased & Independent',
    description: 'InsureEstimate is 100% independent. We are not owned by any insurance carrier or lead generator, ensuring our benchmark projections remain neutral.'
  },
  {
    icon: 'bar_chart',
    title: 'Data-Driven Accuracy',
    description: 'Our engine continually calibrates local property replacement values, state loss ratios, and commercial risk classifications across 35+ industry profiles.'
  },
  {
    icon: 'lock',
    title: 'Consumer Privacy First',
    description: 'Your financial information stays private. Our calculations run client-side without requiring SSNs, credit checks, or aggressive sales agent calls.'
  }
];

const methodologySteps = [
  {
    step: '01',
    title: 'State Statutory Base Rates',
    description: 'We aggregate baseline rate filings submitted by licensed insurers to state departments of insurance across all 50 US states.'
  },
  {
    step: '02',
    title: 'Commercial Risk Classification',
    description: 'For business insurance, we map industry codes (NAICS/SIC) to actuarial risk factors based on historic loss ratios and claims exposure.'
  },
  {
    step: '03',
    title: 'Coverage & Deductible Calibrations',
    description: 'Our algorithms apply mathematical curve adjustments for personal property coverage tiers ($15k–$100k+), liability limits, and deductible selections.'
  },
  {
    step: '04',
    title: 'Range Confidence Intervals',
    description: 'Rather than displaying an unrealistic single quote, we project realistic low-to-high premium confidence ranges based on underwriting variability.'
  }
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>About Us - Actuarial Cost Intelligence | InsureEstimate</title>
  <meta name="description" content="Learn about InsureEstimate's mission to provide independent, actuarial-backed renters and commercial business insurance cost intelligence across all 50 US states.">
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet">
</head>
<body class="bg-background font-body-md text-slate-800 antialiased selection:bg-emerald-100 selection:text-emerald-900">
  <SiteHeader active="" />

  <main class="w-full pt-20 md:pt-24 min-h-[calc(100vh-300px)]">
    <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-6">
      <Breadcrumbs items={breadcrumbItems} />

      <!-- HERO SECTION -->
      <section class="mt-6 py-12 md:py-16 bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 text-white rounded-3xl p-8 md:p-14 relative overflow-hidden shadow-xl">
        <div class="absolute -right-20 -bottom-20 w-96 h-96 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>
        
        <div class="max-w-3xl flex flex-col gap-5 relative z-10">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/20 text-emerald-300 text-xs font-semibold uppercase tracking-wider w-max border border-emerald-500/30">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            Independent Insurance Intelligence
          </div>

          <h1 class="font-['Plus_Jakarta_Sans',sans-serif] text-3xl md:text-5xl font-extrabold tracking-tight text-white leading-tight">
            Demystifying Insurance Premiums Through Data Transparency
          </h1>

          <p class="text-slate-300 text-base md:text-lg leading-relaxed font-normal">
            InsureEstimate was built to solve a simple problem: insurance pricing shouldn't be a mystery. We provide objective, actuarial-backed premium estimates for renters and small businesses across all 50 US states without high-pressure sales calls or hidden agendas.
          </p>

          <div class="grid grid-cols-2 sm:grid-cols-3 gap-6 pt-6 border-t border-slate-700/80">
            <div>
              <span class="block text-2xl md:text-3xl font-extrabold text-emerald-400 font-['Plus_Jakarta_Sans',sans-serif]">50 States</span>
              <span class="text-xs text-slate-400 font-medium">Localized Statutory Rates</span>
            </div>
            <div>
              <span class="block text-2xl md:text-3xl font-extrabold text-emerald-400 font-['Plus_Jakarta_Sans',sans-serif]">35+ Profiles</span>
              <span class="text-xs text-slate-400 font-medium">Commercial Risk Models</span>
            </div>
            <div>
              <span class="block text-2xl md:text-3xl font-extrabold text-emerald-400 font-['Plus_Jakarta_Sans',sans-serif]">100% Free</span>
              <span class="text-xs text-slate-400 font-medium">No Lead Capture Wall</span>
            </div>
          </div>
        </div>
      </section>

      <!-- OUR MISSION & VISION -->
      <section class="my-16 grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
        <div class="flex flex-col gap-4">
          <span class="text-xs font-bold text-emerald-700 uppercase tracking-widest">Our Mission</span>
          <h2 class="font-['Plus_Jakarta_Sans',sans-serif] text-2xl md:text-3xl font-bold text-slate-900">
            Empowering Policyholders with Real Financial Clarity
          </h2>
          <p class="text-slate-600 text-sm md:text-base leading-relaxed">
            Traditionally, finding out how much renters insurance or business liability coverage should cost meant filling out long forms, handing over personal phone numbers, and enduring relentless sales outreach from agencies.
          </p>
          <p class="text-slate-600 text-sm md:text-base leading-relaxed">
            At InsureEstimate, we changed the paradigm. By reverse-engineering public insurance department rate filings, risk classifications, and regional loss ratios into deterministic mathematical models, we give you accurate, localized cost ranges in seconds.
          </p>
        </div>

        <div class="bg-slate-50 p-8 rounded-2xl border border-slate-200/80 shadow-sm flex flex-col gap-6">
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-800 flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined text-[22px]">verified_user</span>
            </div>
            <div>
              <h3 class="font-bold text-slate-900 text-base">Consumer Advocacy</h3>
              <p class="text-xs text-slate-600 mt-1 leading-relaxed">We advocate for fair pricing by educating consumers on how coverage limits, deductibles, and location directly impact carrier risk formulas.</p>
            </div>
          </div>

          <div class="flex items-start gap-4 pt-4 border-t border-slate-200/60">
            <div class="w-10 h-10 rounded-xl bg-slate-200 text-slate-800 flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined text-[22px]">hub</span>
            </div>
            <div>
              <h3 class="font-bold text-slate-900 text-base">Strict Unbiased Stand</h3>
              <p class="text-xs text-slate-600 mt-1 leading-relaxed">Our estimation algorithms treat all carriers equally. We do not inflate rates or alter pricing metrics for partner preferences.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- CORE VALUES -->
      <section class="my-16 bg-slate-900 text-white rounded-3xl p-8 md:p-12 shadow-md">
        <div class="text-center max-w-2xl mx-auto mb-12 flex flex-col gap-2">
          <span class="text-xs font-bold text-emerald-400 uppercase tracking-widest">Guiding Principles</span>
          <h2 class="font-['Plus_Jakarta_Sans',sans-serif] text-2xl md:text-3xl font-bold">Why Users Trust InsureEstimate</h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {coreValues.map((val) => (
            <div class="bg-slate-800/90 p-6 rounded-2xl border border-slate-700/80 flex flex-col gap-3 hover:border-emerald-500/50 transition-all">
              <div class="w-10 h-10 rounded-xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center">
                <span class="material-symbols-outlined text-[22px]">{val.icon}</span>
              </div>
              <h3 class="font-bold text-white text-base font-['Plus_Jakarta_Sans',sans-serif]">{val.title}</h3>
              <p class="text-xs text-slate-300 leading-relaxed">{val.description}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- METHODOLOGY EXPLAINER -->
      <section class="my-16">
        <div class="flex flex-col gap-2 mb-10 text-center max-w-2xl mx-auto">
          <span class="text-xs font-bold text-emerald-700 uppercase tracking-widest">Underwriting Architecture</span>
          <h2 class="font-['Plus_Jakarta_Sans',sans-serif] text-2xl md:text-3xl font-bold text-slate-900">How Our Calculation Engine Works</h2>
          <p class="text-xs md:text-sm text-slate-600">Our calculations follow standardized insurance mathematical guidelines used by certified actuaries.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          {methodologySteps.map((step) => (
            <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm flex flex-col gap-3 relative">
              <span class="text-3xl font-extrabold text-slate-200 font-['Plus_Jakarta_Sans',sans-serif]">{step.step}</span>
              <h3 class="font-bold text-slate-900 text-base">{step.title}</h3>
              <p class="text-xs text-slate-600 leading-relaxed">{step.description}</p>
            </div>
          ))}
        </div>
      </section>

    </div>
  </main>

  <PageFooter />
</body>
</html>
