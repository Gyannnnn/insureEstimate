---
import SiteHeader from '../components/SiteHeader.astro';
import PageFooter from '../components/PageFooter.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import Fonts from '../components/Fonts.astro';
import '../styles/global.css';

const breadcrumbItems = [
  { label: 'About Us' }
];

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Gyanaranjan Patra',
  jobTitle: 'Founder & Lead Engineer',
  url: 'https://insureestimate.com/about/',
  sameAs: ['https://www.linkedin.com/in/higyan/'],
  worksFor: {
    '@type': 'Organization',
    name: 'InsureEstimate',
    url: 'https://insureestimate.com/',
  },
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'Veer Surendra Sai University of Technology',
  },
};

const coreValues = [
  {
    icon: 'calculate',
    title: 'Actuarial Transparency',
    description: 'We demystify complex insurance rate structures by exposing base state rates, risk multipliers, and coverage tier factors derived from statutory filings.'
  },
  {
    icon: 'shield',
    title: 'Unbiased & Independent',
    description: 'InsureEstimate is 100% independent. We are not owned by any insurance carrier or lead generator, ensuring our benchmark projections remain neutral.'
  },
  {
    icon: 'bar_chart',
    title: 'Data-Driven Accuracy',
    description: 'Our engine continually calibrates local property replacement values, state loss ratios, and commercial risk classifications across 35+ industry profiles.'
  },
  {
    icon: 'lock',
    title: 'Consumer Privacy First',
    description: 'Your financial information stays private. Our calculations run client-side without requiring SSNs, credit checks, or aggressive sales agent calls.'
  }
];

const methodologySteps = [
  {
    step: '01',
    title: 'State Statutory Base Rates',
    description: 'We aggregate baseline rate filings submitted by licensed insurers to state departments of insurance across all 50 US states.'
  },
  {
    step: '02',
    title: 'Commercial Risk Classification',
    description: 'For business insurance, we map industry codes (NAICS/SIC) to actuarial risk factors based on historic loss ratios and claims exposure.'
  },
  {
    step: '03',
    title: 'Coverage & Deductible Calibrations',
    description: 'Our algorithms apply mathematical curve adjustments for personal property coverage tiers ($15k–$100k+), liability limits, and deductible selections.'
  },
  {
    step: '04',
    title: 'Range Confidence Intervals',
    description: 'Rather than displaying an unrealistic single quote, we project realistic low-to-high premium confidence ranges based on underwriting variability.'
  }
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <GoogleAnalytics />
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>About Us - Actuarial Cost Intelligence | InsureEstimate</title>
  <meta name="description" content="Learn about InsureEstimate's mission to provide independent, actuarial-backed renters and commercial business insurance cost intelligence across all 50 US states.">
  <link rel="canonical" href="https://insureestimate.com/about/" />
  <Fonts />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
</head>
<body class="bg-canvas font-sans text-ink antialiased">
  <SiteHeader active="" />

  <main class="w-full pt-16">
    <div class="container-page pt-8">
      <Breadcrumbs items={breadcrumbItems} />
    </div>

    <!-- HERO SECTION -->
    <section class="container-page pb-16 pt-12 md:pb-24 md:pt-16">
      <div class="flex max-w-3xl flex-col gap-6">
        <span class="badge self-start">
          <span class="h-1.5 w-1.5 rounded-full bg-brand" aria-hidden="true"></span>
          Independent Insurance Intelligence
        </span>

        <h1 class="title-display">
          Demystifying Insurance Premiums Through Data Transparency
        </h1>

        <p class="lead">
          InsureEstimate was built to solve a simple problem: insurance pricing shouldn't be a mystery. We provide objective, actuarial-backed premium estimates for renters and small businesses across all 50 US states without high-pressure sales calls or hidden agendas.
        </p>
      </div>

      <dl class="mt-12 grid grid-cols-1 overflow-hidden rounded-xl border border-hairline bg-hairline sm:grid-cols-3" style="gap: 1px;">
        <div class="flex flex-col gap-1 bg-elevated p-6">
          <dt class="order-2 text-body-md text-mute">Localized Statutory Rates</dt>
          <dd class="num order-1 text-[32px] font-semibold leading-10 tracking-[-1.28px] text-ink">50 States</dd>
        </div>
        <div class="flex flex-col gap-1 bg-elevated p-6">
          <dt class="order-2 text-body-md text-mute">Commercial Risk Models</dt>
          <dd class="num order-1 text-[32px] font-semibold leading-10 tracking-[-1.28px] text-ink">35+ Profiles</dd>
        </div>
        <div class="flex flex-col gap-1 bg-elevated p-6">
          <dt class="order-2 text-body-md text-mute">No Lead Capture Wall</dt>
          <dd class="num order-1 text-[32px] font-semibold leading-10 tracking-[-1.28px] text-ink">100% Free</dd>
        </div>
      </dl>
    </section>

    <!-- OUR MISSION & VISION -->
    <section class="border-y border-hairline bg-elevated">
      <div class="container-page grid grid-cols-1 items-start gap-10 py-16 md:grid-cols-2 md:gap-16 md:py-24">
        <div class="flex flex-col gap-4">
          <span class="eyebrow">Our Mission</span>
          <h2 class="title-section">
            Empowering Policyholders with Real Financial Clarity
          </h2>
          <div class="prose-body mt-2">
            <p>
              Traditionally, finding out how much renters insurance or business liability coverage should cost meant filling out long forms, handing over personal phone numbers, and enduring relentless sales outreach from agencies.
            </p>
            <p>
              At InsureEstimate, we changed the paradigm. By reverse-engineering public insurance department rate filings, risk classifications, and regional loss ratios into deterministic mathematical models, we give you accurate, localized cost ranges in seconds.
            </p>
          </div>
        </div>

        <div class="well flex flex-col divide-y divide-hairline">
          <div class="flex items-start gap-4 p-6">
            <span class="icon-tile h-10 w-10">
              <span class="material-symbols-outlined text-[22px]">verified_user</span>
            </span>
            <div>
              <h3 class="text-body-lg font-semibold text-ink">Consumer Advocacy</h3>
              <p class="mt-1 text-body-md text-body">We advocate for fair pricing by educating consumers on how coverage limits, deductibles, and location directly impact carrier risk formulas.</p>
            </div>
          </div>

          <div class="flex items-start gap-4 p-6">
            <span class="icon-tile h-10 w-10">
              <span class="material-symbols-outlined text-[22px]">hub</span>
            </span>
            <div>
              <h3 class="text-body-lg font-semibold text-ink">Strict Unbiased Stand</h3>
              <p class="mt-1 text-body-md text-body">Our estimation algorithms treat all carriers equally. We do not inflate rates or alter pricing metrics for partner preferences.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="container-page flex flex-col gap-24 pt-16 md:pt-24">
      <!-- CORE VALUES -->
      <section class="flex flex-col gap-8">
        <div class="flex max-w-2xl flex-col gap-3">
          <span class="eyebrow">Guiding Principles</span>
          <h2 class="title-section">Why Users Trust InsureEstimate</h2>
        </div>

        <div class="grid grid-cols-1 overflow-hidden rounded-xl border border-hairline bg-hairline sm:grid-cols-2 lg:grid-cols-4" style="gap: 1px;">
          {coreValues.map((val) => (
            <div class="flex flex-col gap-3 bg-elevated p-6">
              <span class="icon-tile">
                <span class="material-symbols-outlined text-[20px]">{val.icon}</span>
              </span>
              <h3 class="text-body-lg font-semibold text-ink">{val.title}</h3>
              <p class="text-body-md text-body">{val.description}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- METHODOLOGY EXPLAINER -->
      <section class="flex flex-col gap-8">
        <div class="flex max-w-2xl flex-col gap-3">
          <span class="eyebrow">Underwriting Architecture</span>
          <h2 class="title-section">How Our Calculation Engine Works</h2>
          <p class="text-body-lg text-body">Our calculations follow standardized insurance mathematical conventions, built on publicly filed state rate data rather than a single carrier's proprietary formula.</p>
        </div>

        <ol class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-4">
          {methodologySteps.map((step) => (
            <li class="card flex flex-col gap-3 p-6">
              <span class="num font-mono text-body-md font-medium text-mute">{step.step}</span>
              <h3 class="text-body-lg font-semibold text-ink">{step.title}</h3>
              <p class="text-body-md text-body">{step.description}</p>
            </li>
          ))}
        </ol>
      </section>

      <!-- METHODOLOGY OWNER / E-E-A-T -->
      <section class="flex flex-col gap-8">
        <div class="flex max-w-2xl flex-col gap-3">
          <span class="eyebrow">Who's Behind This</span>
          <h2 class="title-section">Methodology Owner &amp; Lead Engineer</h2>
        </div>

        <div class="panel flex max-w-3xl flex-col items-start gap-6 p-6 sm:flex-row md:p-8">
          <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-2xl bg-ink text-xl font-semibold tracking-[-0.5px] text-white" aria-hidden="true">
            GP
          </div>
          <div class="flex flex-col gap-3">
            <div class="flex flex-col gap-0.5">
              <h3 class="text-heading-md text-ink">Gyanaranjan Patra</h3>
              <span class="text-body-md text-mute">Founder &amp; Lead Engineer</span>
            </div>
            <p class="text-body-lg text-body">
              Gyanaranjan holds an engineering degree in Information Technology from Veer Surendra Sai University of Technology (VSSUT), Burla, Sambalpur, India. He designed and built InsureEstimate's estimation engine, sourcing the underlying base rates and risk-classification data from public state insurance department filings and translating them into the transparent, deterministic calculators used across this site.
            </p>
            <p class="text-body-lg text-body">
              He personally reviews and maintains the state and profession rate factors published on InsureEstimate to keep them aligned with publicly available filings.
            </p>
            <a href="https://www.linkedin.com/in/higyan/" target="_blank" rel="noopener noreferrer" class="btn-ghost-sm mt-1 self-start">
              <span class="material-symbols-outlined text-[18px]">open_in_new</span>
              View LinkedIn Profile
            </a>
          </div>
        </div>
      </section>
    </div>
  </main>

  <PageFooter />
</body>
</html>
