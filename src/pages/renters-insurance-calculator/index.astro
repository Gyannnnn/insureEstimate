                <div class="w-7 h-7 rounded-full bg-surface-container-low flex items-center justify-center shrink-0 group-open:rotate-180 transition-transform duration-300 text-on-surface-variant">
                  <span class="material-symbols-outlined text-[18px]">expand_more</span>
                </div>
