---
import fs from 'node:fs';
import path from 'node:path';
import { getCollection, getEntry } from 'astro:content';
import SiteHeader from '../../components/SiteHeader.astro';
import PageFooter from '../../components/PageFooter.astro';
import CalculatorCard from '../../components/CalculatorCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import RelatedStates from '../../components/RelatedStates.astro';
import { linkStateNamesInText } from '../../lib/relatedStates';
import {
  getRentersStandardPremium,
  calculateNationalRentersAverage
} from '../../lib/calculators/standardProfile';
import GoogleAnalytics from '../../components/GoogleAnalytics.astro';
import Fonts from '../../components/Fonts.astro';
import SiteSchema from '../../components/SiteSchema.astro';
import { RENTERS_FACTORS } from '../../lib/calculators/factors';
import { stateMetaDescription } from '../../lib/seo';
import '../../styles/global.css';

export async function getStaticPaths() {
  return (await getCollection('states')).map(({ data }) => ({ params: { state: data.slug } }));
}

const stateEntry = await getEntry('states', Astro.params.state!);
if (!stateEntry) return Astro.redirect('/');
const { data } = stateEntry;
const title = data.seoTitle || `Renters Insurance Cost in ${data.name}`;

const allStates = await getCollection('states');
const nationalAvgAnnual = calculateNationalRentersAverage(allStates.map(s => s.data.baseRate));

const standardEst = getRentersStandardPremium(data.baseRate);
const derivedAnnualCost = standardEst.annual;
const derivedMonthlyCost = standardEst.monthly;

// Hand-written seoDescription wins; otherwise build one from this state's own numbers and risks.
const description = data.seoDescription?.trim() || stateMetaDescription({
  name: data.name,
  monthly: derivedMonthlyCost,
  annual: derivedAnnualCost,
  riskTitles: (data.riskFactors || []).map(rf => rf.title),
});

const defaultImage = '/images/states/default.jpg';
let stateImage = data.image || `/images/states/${data.slug}.jpg`;

const relativePath = stateImage.startsWith('/') ? stateImage.slice(1) : stateImage;
const absoluteImagePath = path.join(process.cwd(), 'public', relativePath);

if (!fs.existsSync(absoluteImagePath)) {
  stateImage = defaultImage;
}

const demographics = data.demographics || {
  typicalPersonalProperty: 30000,
  typicalLiability: 100000,
  typicalDeductible: 500,
  demographicNote: ""
};

const validRiskFactors = (data.riskFactors || []).filter(
  rf => (rf.title && rf.title.trim() !== '') || (rf.description && rf.description.trim() !== '')
);

const validFaqs = (data.faqs || []).filter(
  f => f.question && f.question.trim() !== '' && f.answer && f.answer.trim() !== ''
);

const blogContent = data.blogContent || { whyThisRate: "", howCalculated: "", comparisonNote: "" };
const hasBlogContent = Boolean(
  blogContent.whyThisRate?.trim() ||
  blogContent.howCalculated?.trim() ||
  blogContent.comparisonNote?.trim()
);

const isDev = import.meta.env.DEV;

const ICON_MAP: Record<string, string> = {
  // Weather & Perils
  wind: 'air',
  waves: 'waves',
  droplet: 'water_drop',
  drop: 'water_drop',
  water: 'water_drop',
  rain: 'water_drop',
  storm: 'thunderstorm',
  hurricane: 'cyclone',
  tornado: 'tornado',
  fire: 'local_fire_department',
  flood: 'flood',
  hail: 'ac_unit',
  snow: 'ac_unit',
  snowflake: 'ac_unit',
  cold: 'ac_unit',
  earthquake: 'landslide',
  seismic: 'landslide',
  activity: 'landslide',

  // Logistics & Business
  package: 'package_2',
  box: 'package_2',
  shipping: 'local_shipping',
  truck: 'local_shipping',
  gavel: 'gavel',
  security: 'security',
  description: 'description',
  volcano: 'volcano',
  water_damage: 'water_damage',
  shield: 'shield',
  briefcase: 'work',
  tool: 'construction',
  building: 'domain',
  person: 'person',
  medical: 'medical_services'
};

function getIconName(iconName?: string): string {
  if (!iconName || !iconName.trim()) return 'shield';
  const key = iconName.toLowerCase().trim();
  return ICON_MAP[key] || key;
}

const maxRate = Math.max(derivedAnnualCost, nationalAvgAnnual) * 1.2;
const statePct = Math.min(100, Math.max(10, Math.round((derivedAnnualCost / maxRate) * 100)));
---

<!DOCTYPE html>
<html lang="en">
<head>
  <GoogleAnalytics />
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title} | InsureEstimate</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={`https://insureestimate.com/renters-insurance-calculator/${data.slug}/`} />
  <Fonts />
  <SiteSchema />
</head>
<body class="bg-canvas font-sans text-ink antialiased">
  <SiteHeader active="Renters Insurance" />

  <main class="w-full pt-16">
    <div class="container-page relative z-10 flex flex-col gap-8 pb-8 pt-8">
      <!-- Breadcrumbs Navigation -->
      <Breadcrumbs items={[
        { label: 'Renters Insurance Calculator', href: '/renters-insurance-calculator/' },
        { label: data.name }
      ]} />

      <!-- Hero Section -->
      <section class="grid grid-cols-1 items-center gap-8 md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:gap-12">
        <div class="flex max-w-2xl flex-col gap-5">
          <span class="eyebrow">{data.name} State Data</span>
          <h1 class="title-page">Renters Insurance Cost in {data.name}</h1>
          <p class="lead">
            Estimate your monthly renters insurance premium in {data.name}. Adjust coverage limits and deductibles to see how they impact your projected costs based on localized data models.
          </p>
          <div class="mt-2 flex flex-col gap-3 sm:flex-row">
            <a class="btn-primary" href="#calculator">
              Calculate Estimate
            </a>
            <a class="btn-secondary" href="#methodology">
              View Methodology
            </a>
          </div>
        </div>
        <div class="relative hidden h-[320px] w-full overflow-hidden rounded-2xl border border-hairline bg-hairline-soft md:block">
          <img src={stateImage} alt={data.imageAlt || `${data.name} state profile`} class="h-full w-full object-cover" loading="eager" decoding="async" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/0 to-transparent"></div>
          <div class="absolute bottom-5 left-5 flex flex-col gap-0.5 text-white">
            <span class="font-mono text-[11px] uppercase text-white/75">State Profile</span>
            <span class="text-heading-md">{data.name} ({data.abbreviation})</span>
          </div>
        </div>
      </section>

      <!-- Calculator Section -->
      <div id="calculator" class="w-full scroll-mt-24">
        <CalculatorCard
          title={`${data.name} Renters Insurance Estimator`}
          subtitle={`Model monthly premium ranges for ${data.name} based on state actuarial benchmarks.`}
          type="renters"
          entityName={data.name}
          baseRate={data.baseRate}
        />
      </div>
    </div>

    <div class="container-page relative z-10 flex flex-col gap-16 pb-8 pt-8 md:gap-24">
      <!-- Data Grid Section -->
      <section class="flex flex-col gap-8">
        <h2 class="title-section">{data.name} Market Data</h2>
        <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
          <!-- Card 1: Derived Average Cost -->
          <div class="card flex flex-col p-6">
            <span class="eyebrow mb-2">State Benchmark</span>
            <h3 class="title-card mb-4">Average Cost</h3>
            <div class="num mb-4 flex items-baseline gap-2">
              <span class="text-[40px] font-semibold leading-none tracking-[-1.8px] text-ink">${derivedAnnualCost}</span>
              <span class="text-body-md text-mute">/year (${derivedMonthlyCost}/mo)</span>
            </div>
            <p class="mb-6 text-body-md text-body">
              The average cost of renters insurance in {data.name} is derived as ${derivedAnnualCost} per year (${derivedMonthlyCost}/month) based on standard coverage inputs ($20k property, $100k liability, $500 deductible).
            </p>
            <div class="mt-auto border-t border-hairline pt-4">
              <div class="num mb-2 flex justify-between font-mono text-[12px] text-mute">
                <span class="text-ink">{data.abbreviation} Avg (${derivedAnnualCost})</span>
                <span>National Avg (${nationalAvgAnnual})</span>
              </div>
              <div class="flex h-1.5 w-full overflow-hidden rounded-full bg-hairline">
                <div class="rounded-full bg-ink" style={`width: ${statePct}%`}></div>
              </div>
            </div>
          </div>

          <!-- Card 2: Typical Coverage -->
          <div class="card flex flex-col p-6">
            <span class="eyebrow mb-2">Demographics</span>
            <h3 class="title-card mb-4">Typical Coverage</h3>
            <ul class="num mb-4 flex flex-col divide-y divide-hairline text-body-md">
              <li class="flex justify-between py-2.5 first:pt-0">
                <span class="text-body">Personal Property</span>
                <span class="font-medium text-ink">${demographics.typicalPersonalProperty.toLocaleString('en-US')}</span>
              </li>
              <li class="flex justify-between py-2.5">
                <span class="text-body">Liability</span>
                <span class="font-medium text-ink">${demographics.typicalLiability.toLocaleString('en-US')}</span>
              </li>
              <li class="flex justify-between py-2.5">
                <span class="text-body">Deductible</span>
                <span class="font-medium text-ink">${demographics.typicalDeductible.toLocaleString('en-US')}</span>
              </li>
            </ul>
            {demographics.demographicNote?.trim() ? (
              <p class="mt-auto border-t border-hairline pt-4 text-body-md text-body">
                {demographics.demographicNote}
              </p>
            ) : isDev ? (
              <p class="mt-auto border-t border-hairline pt-4 text-body-sm italic text-mute">
                [Dev Mode] Demographic note coming soon.
              </p>
            ) : (
              <p class="mt-auto border-t border-hairline pt-4 text-body-md text-body">
                Standard coverage limits balance adequate personal asset protection with affordable monthly premiums.
              </p>
            )}
          </div>

          <!-- Card 3: Risk Factors Overview -->
          <div class="card flex flex-col justify-between p-6">
            <div>
              <span class="eyebrow mb-2 block">Risk Factors</span>
              <h3 class="title-card mb-4">{data.abbreviation} Considerations</h3>
              {validRiskFactors.length > 0 ? (
                <div class="flex flex-col gap-4">
                  {validRiskFactors.slice(0, 3).map(rf => (
                    <div class="flex items-start gap-3">
                      <span class="icon-tile h-8 w-8">
                        <span class="material-symbols-outlined text-[18px]">{getIconName(rf.icon)}</span>
                      </span>
                      <div class="flex min-w-0 flex-col">
                        <span class="truncate text-body-md font-medium text-ink">{rf.title}</span>
                        {rf.description && <span class="line-clamp-2 text-body-sm text-mute">{rf.description}</span>}
                      </div>
                    </div>
                  ))}
                </div>
              ) : isDev ? (
                <div class="rounded-lg border border-dashed border-hairline p-3 text-body-sm italic text-mute">
                  [Dev Mode] Risk factors content coming soon.
                </div>
              ) : (
                <div class="flex items-start gap-3">
                  <span class="icon-tile h-8 w-8">
                    <span class="material-symbols-outlined text-[18px]">shield</span>
                  </span>
                  <div class="flex flex-col">
                    <span class="text-body-md font-medium text-ink">Standard Perils</span>
                    <span class="text-body-sm text-mute">Fire, theft, and water damage from plumbing are standard perils.</span>
                  </div>
                </div>
              )}
            </div>
            {validRiskFactors.length > 0 && (
              <a href="#risk-profile" class="group mt-6 inline-flex items-center justify-between border-t border-hairline pt-4 text-body-md font-medium text-ink hover:text-brand-ink">
                <span>View full risk profile ({validRiskFactors.length})</span>
                <span class="material-symbols-outlined text-[18px] text-mute group-hover:text-brand-ink">arrow_downward</span>
              </a>
            )}
          </div>
        </div>
      </section>

      <!-- Risk Factors Full Grid Section -->
      {(validRiskFactors.length > 0 || isDev) && (
        <section id="risk-profile" class="flex scroll-mt-24 flex-col gap-8">
          <div class="flex flex-col gap-3">
            <span class="eyebrow">Localized Risk</span>
            <h2 class="title-section">{data.name} Risk Profile</h2>
          </div>
          {validRiskFactors.length > 0 ? (
            <div class={`grid gap-4 ${
              validRiskFactors.length === 2 ? 'grid-cols-1 md:grid-cols-2' :
              validRiskFactors.length === 4 ? 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-4' :
              'grid-cols-1 md:grid-cols-3'
            }`}>
              {validRiskFactors.map(rf => (
                <div class="card flex flex-col gap-3 p-6">
                  <span class="icon-tile">
                    <span class="material-symbols-outlined text-[20px]">{getIconName(rf.icon)}</span>
                  </span>
                  {rf.title && <h3 class="text-body-lg font-semibold text-ink">{rf.title}</h3>}
                  {rf.description && <p class="text-body-md text-body">{rf.description}</p>}
                </div>
              ))}
            </div>
          ) : (
            <div class="rounded-xl border border-dashed border-hairline bg-canvas p-6 text-body-sm italic text-mute">
              [Dev Mode] Risk factors details for {data.name} will be rendered here once content is populated.
            </div>
          )}
        </section>
      )}

      <!-- Split Section: Methodology & Formula -->
      <section class="grid scroll-mt-24 grid-cols-1 items-start gap-10 border-t border-hairline pt-16 md:pt-24 lg:grid-cols-2 lg:gap-16" id="methodology">
        <div class="flex flex-col gap-6">
          <div class="flex flex-col gap-3">
            <span class="eyebrow">Process</span>
            <h2 class="title-section">How we calculate estimates</h2>
          </div>
          <ol class="flex flex-col">
            <li class="relative flex gap-4 pb-8 before:absolute before:bottom-0 before:left-[13px] before:top-8 before:w-px before:bg-hairline">
              <span class="num flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-hairline bg-elevated font-mono text-[12px] font-medium text-ink">1</span>
              <div class="flex flex-col gap-1 pt-0.5">
                <h3 class="text-body-lg font-semibold text-ink">Data Aggregation</h3>
                <p class="text-body-md text-body">We collect anonymized quoting data from top carriers across {data.name} ZIP codes, updated quarterly.</p>
              </div>
            </li>
            <li class="relative flex gap-4 pb-8 before:absolute before:bottom-0 before:left-[13px] before:top-8 before:w-px before:bg-hairline">
              <span class="num flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-hairline bg-elevated font-mono text-[12px] font-medium text-ink">2</span>
              <div class="flex flex-col gap-1 pt-0.5">
                <h3 class="text-body-lg font-semibold text-ink">Actuarial Modeling</h3>
                <p class="text-body-md text-body">Base rates are adjusted using proprietary multipliers for coverage limits, deductibles, and local risk factors.</p>
              </div>
            </li>
            <li class="relative flex gap-4">
              <span class="num flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-ink font-mono text-[12px] font-medium text-white">3</span>
              <div class="flex flex-col gap-1 pt-0.5">
                <h3 class="text-body-lg font-semibold text-ink">Estimate Generation</h3>
                <p class="text-body-md text-body">The calculator outputs a localized projection, designed to give you a realistic baseline before seeking official quotes.</p>
              </div>
            </li>
          </ol>
        </div>

        <!-- The actual model, shown as a spec rather than an illustration -->
        <div class="flex flex-col gap-3">
          <div class="overflow-hidden rounded-xl border border-hairline bg-elevated shadow-md">
            <div class="flex items-center justify-between border-b border-hairline bg-canvas px-4 py-2.5">
              <span class="font-mono text-[12px] text-mute">{data.slug}.model</span>
              <span class="badge">{data.abbreviation}</span>
            </div>
            <div class="num overflow-x-auto p-4 font-mono text-[13px] leading-7 md:p-5">
              <div class="text-mute">// Renters premium for {data.name}</div>
              <div><span class="text-ink">annual</span> <span class="text-faint">=</span> base_rate <span class="text-faint">×</span> property <span class="text-faint">×</span> liability <span class="text-faint">×</span> deductible</div>
              <div><span class="text-ink">range</span>&nbsp; <span class="text-faint">=</span> annual <span class="text-faint">±</span> {Math.round(RENTERS_FACTORS.estimateRangePercent * 100)}%</div>
              <div class="mt-4 text-mute">// Standard profile: $20k property, $100k liability, $500 deductible</div>
              <div>base_rate <span class="text-faint">=</span> <span class="font-medium text-brand-ink">${data.baseRate}</span></div>
              <div>property&nbsp; <span class="text-faint">=</span> ×{RENTERS_FACTORS.propertyValue[20000].toFixed(2)}</div>
              <div>liability <span class="text-faint">=</span> ×{RENTERS_FACTORS.liability[100000].toFixed(2)}</div>
              <div>deductible <span class="text-faint">=</span> ×{RENTERS_FACTORS.deductible[500].toFixed(2)}</div>
              <div class="mt-4 border-t border-dashed border-hairline pt-4"><span class="text-ink">annual</span> <span class="text-faint">≈</span> <span class="font-semibold text-ink">${derivedAnnualCost}/yr</span> <span class="text-mute">(${derivedMonthlyCost}/mo)</span></div>
            </div>
          </div>
          <p class="flex items-start gap-2 text-body-sm text-mute">
            <span class="material-symbols-outlined mt-px shrink-0 text-[16px]">database</span>
            <span><strong class="font-medium text-body">Model Integrity:</strong> Estimates are non-binding projections based on historical rate filings and aggregated quote data.</span>
          </p>
        </div>
      </section>

      <!-- Blog / Rate Analysis Section -->
      {(hasBlogContent || isDev) && (
        <section class="flex w-full flex-col gap-8 border-t border-hairline pt-16 md:pt-24">
          <div class="flex flex-col gap-3">
            <span class="eyebrow">Underwriting Analysis</span>
            <h2 class="title-section">How Renters Insurance Works in {data.name}</h2>
          </div>
          {hasBlogContent ? (
            <div class="panel flex flex-col divide-y divide-hairline">
              {blogContent.whyThisRate?.trim() && (
                <div class="grid grid-cols-1 gap-3 p-6 md:grid-cols-[260px_minmax(0,1fr)] md:gap-10 md:p-8">
                  <h3 class="text-body-lg font-semibold text-ink">Why Renters Rates in {data.name} Average ${derivedAnnualCost}/yr</h3>
                  <p class="prose-body" set:html={linkStateNamesInText(blogContent.whyThisRate, allStates, data.slug)} />
                </div>
              )}
              {blogContent.howCalculated?.trim() && (
                <div class="grid grid-cols-1 gap-3 p-6 md:grid-cols-[260px_minmax(0,1fr)] md:gap-10 md:p-8">
                  <h3 class="text-body-lg font-semibold text-ink">Calculating Premium Estimates</h3>
                  <p class="prose-body" set:html={linkStateNamesInText(blogContent.howCalculated, allStates, data.slug)} />
                </div>
              )}
              {blogContent.comparisonNote?.trim() && (
                <div class="grid grid-cols-1 gap-3 p-6 md:grid-cols-[260px_minmax(0,1fr)] md:gap-10 md:p-8">
                  <h3 class="text-body-lg font-semibold text-ink">Regional &amp; National Rate Comparison</h3>
                  <p class="prose-body" set:html={linkStateNamesInText(blogContent.comparisonNote, allStates, data.slug)} />
                </div>
              )}
            </div>
          ) : (
            <div class="rounded-xl border border-dashed border-hairline bg-canvas p-6 text-body-sm italic text-mute">
              [Dev Mode] Detailed rate analysis content for {data.name} will appear here once written.
            </div>
          )}
        </section>
      )}

      <!-- FAQ Section -->
      {(validFaqs.length > 0 || isDev) && (
        <section class="grid w-full grid-cols-1 gap-10 border-t border-hairline pt-16 md:pt-24 lg:grid-cols-[320px_minmax(0,1fr)] lg:gap-16">
          <div class="flex flex-col gap-3">
            <h2 class="title-section">Frequently Asked Questions</h2>
            <p class="text-body-md text-body">Common queries regarding {data.name} renters insurance.</p>
          </div>
          {validFaqs.length > 0 ? (
            <>
              <script type="application/ld+json" is:inline set:html={JSON.stringify({
                "@context": "https://schema.org",
                "@type": "FAQPage",
                "mainEntity": validFaqs.map(faq => ({
                  "@type": "Question",
                  "name": faq.question,
                  "acceptedAnswer": {
                    "@type": "Answer",
                    "text": faq.answer
                  }
                }))
              })} />
              <div class="faq-list">
                {validFaqs.map(faq => (
                  <details class="faq-item">
                    <summary>
                      <span>{faq.question}</span>
                      <span class="material-symbols-outlined faq-icon">add</span>
                    </summary>
                    <p class="faq-body">{faq.answer}</p>
                  </details>
                ))}
              </div>
            </>
          ) : (
            <div class="rounded-xl border border-dashed border-hairline bg-canvas p-6 text-center text-body-sm italic text-mute">
              [Dev Mode] Frequently asked questions for {data.name} will appear here once written.
            </div>
          )}
        </section>
      )}

      <!-- Related States Cross-Linking Section -->
      <RelatedStates currentState={stateEntry} allStates={allStates} />
    </div>
  </main>

  <PageFooter />
</body>
</html>
