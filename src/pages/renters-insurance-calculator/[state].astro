---
import fs from 'node:fs';
import path from 'node:path';
import { getCollection, getEntry } from 'astro:content';
import SiteHeader from '../../components/SiteHeader.astro';
import PageFooter from '../../components/PageFooter.astro';
import CalculatorCard from '../../components/CalculatorCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import RelatedStates from '../../components/RelatedStates.astro';
import { linkStateNamesInText } from '../../lib/relatedStates';
import {
  getRentersStandardPremium,
  calculateNationalRentersAverage
} from '../../lib/calculators/standardProfile';
import GoogleAnalytics from '../../components/GoogleAnalytics.astro';
import '../../styles/global.css';

export async function getStaticPaths() {
  return (await getCollection('states')).map(({ data }) => ({ params: { state: data.slug } }));
}

const stateEntry = await getEntry('states', Astro.params.state!);
if (!stateEntry) return Astro.redirect('/');
const { data } = stateEntry;
const title = data.seoTitle || `Renters Insurance Cost in ${data.name}`;
const description = data.seoDescription || `Estimate your monthly renters insurance premium in ${data.name}.`;

const allStates = await getCollection('states');
const nationalAvgAnnual = calculateNationalRentersAverage(allStates.map(s => s.data.baseRate));

const standardEst = getRentersStandardPremium(data.baseRate);
const derivedAnnualCost = standardEst.annual;
const derivedMonthlyCost = standardEst.monthly;

const defaultImage = '/images/states/default.jpg';
let stateImage = data.image || `/images/states/${data.slug}.jpg`;

const relativePath = stateImage.startsWith('/') ? stateImage.slice(1) : stateImage;
const absoluteImagePath = path.join(process.cwd(), 'public', relativePath);

if (!fs.existsSync(absoluteImagePath)) {
  stateImage = defaultImage;
}

const demographics = data.demographics || {
  typicalPersonalProperty: 30000,
  typicalLiability: 100000,
  typicalDeductible: 500,
  demographicNote: ""
};

const validRiskFactors = (data.riskFactors || []).filter(
  rf => (rf.title && rf.title.trim() !== '') || (rf.description && rf.description.trim() !== '')
);

const validFaqs = (data.faqs || []).filter(
  f => f.question && f.question.trim() !== '' && f.answer && f.answer.trim() !== ''
);

const blogContent = data.blogContent || { whyThisRate: "", howCalculated: "", comparisonNote: "" };
const hasBlogContent = Boolean(
  blogContent.whyThisRate?.trim() ||
  blogContent.howCalculated?.trim() ||
  blogContent.comparisonNote?.trim()
);

const isDev = import.meta.env.DEV;

const ICON_MAP: Record<string, string> = {
  // Weather & Perils
  wind: 'air',
  waves: 'waves',
  droplet: 'water_drop',
  drop: 'water_drop',
  water: 'water_drop',
  rain: 'water_drop',
  storm: 'thunderstorm',
  hurricane: 'cyclone',
  tornado: 'tornado',
  fire: 'local_fire_department',
  flood: 'flood',
  hail: 'ac_unit',
  snow: 'ac_unit',
  snowflake: 'ac_unit',
  cold: 'ac_unit',
  earthquake: 'landslide',
  seismic: 'landslide',
  activity: 'landslide',

  // Logistics & Business
  package: 'package_2',
  box: 'package_2',
  shipping: 'local_shipping',
  truck: 'local_shipping',
  gavel: 'gavel',
  security: 'security',
  description: 'description',
  volcano: 'volcano',
  water_damage: 'water_damage',
  shield: 'shield',
  briefcase: 'work',
  tool: 'construction',
  building: 'domain',
  person: 'person',
  medical: 'medical_services'
};

function getIconName(iconName?: string): string {
  if (!iconName || !iconName.trim()) return 'shield';
  const key = iconName.toLowerCase().trim();
  return ICON_MAP[key] || key;
}

const maxRate = Math.max(derivedAnnualCost, nationalAvgAnnual) * 1.2;
const statePct = Math.min(100, Math.max(10, Math.round((derivedAnnualCost / maxRate) * 100)));
---

<!DOCTYPE html>
<html lang="en">
<head>
  <GoogleAnalytics />
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title} | InsureEstimate</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={`https://insureestimate.com/renters-insurance-calculator/${data.slug}/`} />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap" rel="stylesheet">
</head>
<body class="bg-background font-body-md text-on-surface">
  <SiteHeader active="Renters Insurance" />

  <main class="w-full pt-20 md:pt-24 min-h-[calc(100vh-300px)]">
    <div class="flex flex-col w-full relative">
      <!-- Gradient mesh & blur decorations -->
      <div aria-hidden="true" class="absolute inset-0 pointer-events-none -z-10 overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-br from-surface to-surface-container-low"></div>
        <div class="absolute top-0 right-0 w-[800px] h-[800px] bg-secondary-container/10 rounded-full blur-[120px] -translate-y-1/2 translate-x-1/3"></div>
        <div class="absolute bottom-0 left-0 w-[600px] h-[600px] bg-primary-fixed/20 rounded-full blur-[100px] translate-y-1/3 -translate-x-1/4"></div>
      </div>

      <!-- Main Layout Container -->
      <div class="max-w-[1280px] mx-auto w-full px-margin-mobile md:px-margin-desktop pt-2 sm:pt-3 pb-stack-lg lg:pb-[72px] relative z-10 flex flex-col gap-2.5 sm:gap-3 lg:gap-4">
        <!-- Breadcrumbs Navigation -->
        <Breadcrumbs items={[
          { label: 'Renters Insurance', href: '/renters-insurance-calculator/' },
          { label: data.name }
        ]} />

        <!-- Hero Section -->
        <section class="flex flex-col md:flex-row gap-4 md:gap-gutter items-start">
          <div class="flex-1 flex flex-col gap-2.5 sm:gap-stack-md max-w-2xl">
            <div class="flex items-center gap-2 sm:gap-base">
              <span class="w-6 sm:w-8 h-[2px] bg-primary"></span>
              <span class="font-label-sm text-[11px] sm:text-label-sm tracking-widest uppercase text-on-surface-variant">{data.name} State Data</span>
            </div>
            <h1 class="font-display-lg text-2xl sm:text-3xl md:text-4xl lg:text-[38px] text-primary text-balance font-semibold leading-tight">Renters Insurance Cost in {data.name}</h1>
            <p class="font-body-lg text-sm sm:text-base lg:text-base text-on-surface-variant text-balance leading-relaxed">
              Estimate your monthly renters insurance premium in {data.name}. Adjust coverage limits and deductibles to see how they impact your projected costs based on localized data models.
            </p>
            <div class="flex flex-col sm:flex-row gap-stack-sm mt-stack-sm">
              <a class="inline-flex items-center justify-center bg-primary text-on-primary px-6 py-3 rounded hover:bg-primary/90 transition-colors h-12 font-data-tabular text-data-tabular tracking-wide shadow-sm" href="#calculator">
                Calculate Estimate
              </a>
              <a class="inline-flex items-center justify-center bg-surface-container-lowest text-primary border border-outline-variant px-6 py-3 rounded hover:bg-surface-container-low transition-colors h-12 font-data-tabular text-data-tabular tracking-wide shadow-sm" href="#methodology">
                View Methodology
              </a>
            </div>
          </div>
          <div class="flex-1 hidden md:block w-full h-[320px] rounded-lg overflow-hidden shadow-lg relative group">
            <div class="absolute inset-0 bg-gradient-to-t from-primary/80 via-primary/20 to-transparent z-10 mix-blend-multiply"></div>
            <div class="bg-cover bg-center w-full h-full transition-transform duration-700 group-hover:scale-105" style={`background-image: url('${stateImage}')`}></div>
            <div class="absolute bottom-6 left-6 z-20 flex flex-col gap-1">
              <span class="font-data-tabular text-data-tabular text-on-primary/80">State Profile</span>
              <span class="font-headline-md text-headline-md text-on-primary">{data.name} ({data.abbreviation})</span>
            </div>
          </div>
        </section>

        <!-- Calculator Section -->
        <div id="calculator" class="w-full scroll-mt-[100px] mt-2 sm:mt-4">
          <CalculatorCard
            title={`${data.name} Renters Insurance Estimator`}
            subtitle={`Model monthly premium ranges for ${data.name} based on state actuarial benchmarks.`}
            type="renters"
            entityName={data.name}
            baseRate={data.baseRate}
          />
        </div>

        <!-- Data Grid Section -->
        <section class="flex flex-col gap-4 sm:gap-stack-md mt-stack-md">
          <h2 class="font-headline-lg text-xl sm:text-2xl lg:text-3xl text-primary font-bold border-b border-outline-variant/50 pb-3 sm:pb-4">{data.name} Market Data</h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-gutter">
            <!-- Card 1: Derived Average Cost -->
            <div class="bg-surface-container-lowest rounded-lg p-5 sm:p-stack-md shadow-sm border border-outline-variant/30 flex flex-col relative group hover:shadow-md transition-shadow">
              <div class="absolute top-0 right-0 w-16 h-16 bg-primary/5 rounded-bl-full -z-10 transition-transform group-hover:scale-110"></div>
              <span class="font-label-sm text-[11px] sm:text-label-sm text-on-surface-variant uppercase tracking-wider mb-1.5 sm:mb-2">State Benchmark</span>
              <h3 class="font-headline-md text-lg sm:text-xl md:text-headline-md text-primary font-bold mb-3 sm:mb-4">Average Cost</h3>
              <div class="flex items-baseline gap-2 mb-3 sm:mb-4">
                <span class="font-display-lg text-2xl sm:text-3xl md:text-[40px] text-primary leading-none font-bold">${derivedAnnualCost}</span>
                <span class="font-data-tabular text-xs sm:text-data-tabular text-on-surface-variant">/year (${derivedMonthlyCost}/mo)</span>
              </div>
              <p class="font-body-md text-xs sm:text-[14px] text-on-surface-variant leading-relaxed mb-4 sm:mb-6">
                The average cost of renters insurance in {data.name} is derived as ${derivedAnnualCost} per year (${derivedMonthlyCost}/month) based on standard coverage inputs ($20k property, $100k liability, $500 deductible).
              </p>
              <div class="mt-auto pt-4 border-t border-outline-variant/20">
                <div class="flex justify-between font-data-tabular text-[12px] text-on-surface-variant mb-2">
                  <span>{data.abbreviation} Avg (${derivedAnnualCost})</span>
                  <span>National Avg (${nationalAvgAnnual})</span>
                </div>
                <div class="w-full h-2 bg-surface-container-high rounded-full overflow-hidden flex">
                  <div class="bg-primary rounded-full transition-all duration-500" style={`width: ${statePct}%`}></div>
                </div>
              </div>
            </div>

            <!-- Card 2: Typical Coverage -->
            <div class="bg-surface-container-lowest rounded-lg p-stack-md shadow-sm border border-outline-variant/30 flex flex-col relative group hover:shadow-md transition-shadow">
              <div class="absolute top-0 right-0 w-16 h-16 bg-primary/5 rounded-bl-full -z-10 transition-transform group-hover:scale-110"></div>
              <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider mb-2">Demographics</span>
              <h3 class="font-headline-md text-headline-md text-primary mb-4">Typical Coverage</h3>
              <ul class="flex flex-col gap-3 font-data-tabular text-[14px] mb-4">
                <li class="flex justify-between border-b border-outline-variant/30 pb-2">
                  <span class="text-on-surface-variant">Personal Property</span>
                  <span class="text-primary font-medium">${demographics.typicalPersonalProperty.toLocaleString()}</span>
                </li>
                <li class="flex justify-between border-b border-outline-variant/30 pb-2">
                  <span class="text-on-surface-variant">Liability</span>
                  <span class="text-primary font-medium">${demographics.typicalLiability.toLocaleString()}</span>
                </li>
                <li class="flex justify-between pb-2">
                  <span class="text-on-surface-variant">Deductible</span>
                  <span class="text-primary font-medium">${demographics.typicalDeductible.toLocaleString()}</span>
                </li>
              </ul>
              {demographics.demographicNote?.trim() ? (
                <p class="font-body-md text-[14px] text-on-surface-variant leading-relaxed mt-auto pt-2 border-t border-outline-variant/20">
                  {demographics.demographicNote}
                </p>
              ) : isDev ? (
                <p class="font-body-md text-xs text-on-surface-variant/60 italic mt-auto pt-2 border-t border-outline-variant/20">
                  [Dev Mode] Demographic note coming soon.
                </p>
              ) : (
                <p class="font-body-md text-[14px] text-on-surface-variant leading-relaxed mt-auto pt-2 border-t border-outline-variant/20">
                  Standard coverage limits balance adequate personal asset protection with affordable monthly premiums.
                </p>
              )}
            </div>

            <!-- Card 3: Risk Factors Overview -->
            <div class="bg-surface-container-lowest rounded-lg p-stack-md shadow-sm border border-outline-variant/30 flex flex-col justify-between relative group hover:shadow-md transition-shadow">
              <div class="absolute top-0 right-0 w-16 h-16 bg-primary/5 rounded-bl-full -z-10 transition-transform group-hover:scale-110"></div>
              <div>
                <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider mb-2 block">Risk Factors</span>
                <h3 class="font-headline-md text-headline-md text-primary mb-4">{data.abbreviation} Considerations</h3>
                {validRiskFactors.length > 0 ? (
                  <div class="flex flex-col gap-3">
                    {validRiskFactors.slice(0, 3).map(rf => (
                      <div class="flex gap-2.5 items-start">
                        <div class="w-6 h-6 rounded bg-primary/10 text-primary flex items-center justify-center shrink-0 mt-0.5">
                          <span class="material-symbols-outlined text-[16px] not-italic normal-case select-none">{getIconName(rf.icon)}</span>
                        </div>
                        <div class="flex flex-col min-w-0">
                          <span class="font-data-tabular text-[13px] text-primary font-semibold truncate">{rf.title}</span>
                          {rf.description && <span class="font-body-md text-[12px] text-on-surface-variant line-clamp-2 leading-tight">{rf.description}</span>}
                        </div>
                      </div>
                    ))}
                  </div>
                ) : isDev ? (
                  <div class="p-3 border border-dashed border-outline-variant/60 rounded text-xs text-on-surface-variant/60 italic">
                    [Dev Mode] Risk factors content coming soon.
                  </div>
                ) : (
                  <div class="flex flex-col gap-3">
                    <div class="flex gap-2.5 items-start">
                      <div class="w-6 h-6 rounded bg-primary/10 text-primary flex items-center justify-center shrink-0 mt-0.5">
                        <span class="material-symbols-outlined text-[16px] not-italic normal-case select-none">shield</span>
                      </div>
                      <div class="flex flex-col">
                        <span class="font-data-tabular text-[13px] text-primary font-semibold">Standard Perils</span>
                        <span class="font-body-md text-[12px] text-on-surface-variant">Fire, theft, and water damage from plumbing are standard perils.</span>
                      </div>
                    </div>
                  </div>
                )}
              </div>
              {validRiskFactors.length > 0 && (
                <a href="#risk-profile" class="mt-4 pt-3 border-t border-outline-variant/20 inline-flex items-center justify-between text-xs font-semibold text-primary hover:text-secondary transition-colors">
                  <span>View full risk profile ({validRiskFactors.length})</span>
                  <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
                </a>
              )}
            </div>
          </div>
        </section>

        <!-- Risk Factors Full Grid Section -->
        {(validRiskFactors.length > 0 || isDev) && (
          <section id="risk-profile" class="mt-stack-md pt-stack-md border-t border-outline-variant/40 scroll-mt-24">
            <div class="flex flex-col gap-2 sm:gap-stack-sm mb-4 sm:mb-6">
              <span class="font-label-sm text-[11px] sm:text-xs text-secondary uppercase tracking-widest font-semibold">Localized Risk</span>
              <h2 class="font-headline-lg text-xl sm:text-2xl lg:text-3xl text-primary font-bold">{data.name} Risk Profile</h2>
            </div>
            {validRiskFactors.length > 0 ? (
              <div class={`grid gap-4 md:gap-gutter ${
                validRiskFactors.length === 2 ? 'grid-cols-1 md:grid-cols-2' :
                validRiskFactors.length === 4 ? 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-4' :
                'grid-cols-1 md:grid-cols-3'
              }`}>
                {validRiskFactors.map(rf => (
                  <div class="bg-surface-container-lowest p-4 sm:p-5 rounded-xl border border-outline-variant/30 flex flex-col gap-2.5 sm:gap-3 shadow-sm hover:shadow-md hover:border-primary/40 transition-all">
                    <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-lg bg-primary/10 text-primary flex items-center justify-center shrink-0">
                      <span class="material-symbols-outlined text-[20px] sm:text-[22px] not-italic normal-case select-none">{getIconName(rf.icon)}</span>
                    </div>
                    {rf.title && <h3 class="font-headline-sm font-bold text-primary text-sm sm:text-base lg:text-lg">{rf.title}</h3>}
                    {rf.description && <p class="font-body-md text-xs sm:text-sm text-on-surface-variant leading-relaxed">{rf.description}</p>}
                  </div>
                ))}
              </div>
            ) : (
              <div class="bg-surface-container-low p-6 rounded-xl border border-dashed border-outline-variant/60 text-xs text-on-surface-variant/70 italic">
                [Dev Mode] Risk factors details for {data.name} will be rendered here once content is populated.
              </div>
            )}
          </section>
        )}

        <!-- Split Section: Methodology & Image -->
        <section class="grid grid-cols-1 lg:grid-cols-2 gap-stack-lg items-center mt-stack-md pt-stack-lg border-t border-outline-variant/50 scroll-mt-24" id="methodology">
          <div class="flex flex-col gap-stack-md">
            <div class="flex items-center gap-2 mb-1 sm:mb-2">
              <span class="w-6 sm:w-8 h-[2px] bg-outline-variant"></span>
              <span class="font-label-sm text-[11px] sm:text-label-sm tracking-widest uppercase text-on-surface-variant">Process</span>
            </div>
            <h2 class="font-display-lg text-xl sm:text-2xl lg:text-3xl leading-tight text-primary tracking-tight font-bold">How we calculate estimates</h2>
            <div class="flex flex-col gap-4 sm:gap-6 mt-3 sm:mt-4 relative">
              <div class="absolute left-[11px] top-2 bottom-2 w-[1px] bg-outline-variant/50 -z-10"></div>
              <div class="flex gap-3.5 sm:gap-4 items-start bg-surface-container-lowest p-3.5 sm:p-4 rounded-lg shadow-sm border border-outline-variant/30">
                <div class="w-6 h-6 rounded-full bg-primary text-on-primary flex items-center justify-center font-data-tabular text-[12px] shrink-0 mt-0.5">1</div>
                <div class="flex flex-col">
                  <h4 class="font-data-tabular text-sm sm:text-[15px] lg:text-base text-primary font-medium">Data Aggregation</h4>
                  <p class="font-body-md text-xs sm:text-[14px] text-on-surface-variant mt-1">We collect anonymized quoting data from top carriers across {data.name} ZIP codes, updated quarterly.</p>
                </div>
              </div>
              <div class="flex gap-3.5 sm:gap-4 items-start bg-surface-container-lowest p-3.5 sm:p-4 rounded-lg shadow-sm border border-outline-variant/30">
                <div class="w-6 h-6 rounded-full bg-primary text-on-primary flex items-center justify-center font-data-tabular text-[12px] shrink-0 mt-0.5">2</div>
                <div class="flex flex-col">
                  <h4 class="font-data-tabular text-sm sm:text-[15px] lg:text-base text-primary font-medium">Actuarial Modeling</h4>
                  <p class="font-body-md text-xs sm:text-[14px] text-on-surface-variant mt-1">Base rates are adjusted using proprietary multipliers for coverage limits, deductibles, and local risk factors.</p>
                </div>
              </div>
              <div class="flex gap-3.5 sm:gap-4 items-start bg-surface-container-lowest p-4 rounded-lg shadow-sm border border-outline-variant/30">
                <div class="w-6 h-6 rounded-full bg-primary text-on-primary flex items-center justify-center font-data-tabular text-[12px] shrink-0 mt-0.5">3</div>
                <div class="flex flex-col">
                  <h4 class="font-data-tabular text-sm sm:text-[15px] lg:text-base text-primary font-medium">Estimate Generation</h4>
                  <p class="font-body-md text-xs sm:text-[14px] text-on-surface-variant mt-1">The calculator outputs a localized projection, designed to give you a realistic baseline before seeking official quotes.</p>
                </div>
              </div>
            </div>
          </div>

          <div class="w-full h-full min-h-[300px] sm:min-h-[400px] bg-surface-container-low rounded-xl shadow-inner relative overflow-hidden flex items-center justify-center">
            <div class="absolute inset-0 bg-cover bg-center opacity-80 mix-blend-luminosity" style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuCV5XOuzo2X2Wf_QBYeMa5HNavdHTJRmHpwzpiDxVw_oMSwJXOwPxKIr0oAvYSWMGMT0sMW-sDKc9-g2y_-GitkYFs-7XeCh_YCkS3p6f4Q4Bvk96ivBo_7wpwmAmhu7tb91SIQ_GWmldWgwb7kaHbo-LK9a62Ov4JhgdLl56SvFW-uFRAAb0Ha32OlKJc3LwvjqPYmppmi4MekXyI7cjXeAqty0jL18uMC3qt6MmNOunVysAbrUsib')"></div>
            <div class="absolute inset-0 bg-gradient-to-br from-primary/10 via-transparent to-primary/5 mix-blend-overlay"></div>
            <div class="relative z-10 bg-white/90 backdrop-blur-md p-5 sm:p-6 rounded-lg shadow-xl border border-white/20 max-w-xs transform rotate-1">
              <span class="material-symbols-outlined text-secondary text-[22px] sm:text-[24px] mb-2">database</span>
              <h5 class="font-data-tabular text-xs sm:text-[14px] text-primary font-semibold mb-1">Model Integrity</h5>
              <p class="font-body-md text-[11px] sm:text-[12px] text-on-surface-variant">Estimates are non-binding projections based on historical rate filings and aggregated quote data.</p>
            </div>
          </div>
        </section>

        <!-- Blog / Rate Analysis Section -->
        {(hasBlogContent || isDev) && (
          <section class="mt-stack-md pt-stack-lg border-t border-outline-variant/40 w-full">
            <div class="flex flex-col gap-2 sm:gap-stack-sm mb-4 sm:mb-6">
              <span class="font-label-sm text-[11px] sm:text-xs text-secondary uppercase tracking-widest font-semibold">Underwriting Analysis</span>
              <h2 class="font-headline-lg text-xl sm:text-2xl lg:text-3xl text-primary font-bold">How Renters Insurance Works in {data.name}</h2>
            </div>
            {hasBlogContent ? (
              <div class="w-full bg-surface-container-lowest p-5 sm:p-6 md:p-8 rounded-2xl border border-outline-variant/30 shadow-sm flex flex-col gap-5 sm:gap-6">
                {blogContent.whyThisRate?.trim() && (
                  <div class="flex flex-col gap-2">
                    <div class="flex items-center gap-2">
                      <div class="w-2 h-2 rounded-full bg-secondary"></div>
                      <h3 class="font-headline-sm text-base sm:text-lg lg:text-xl text-primary font-bold">Why Renters Rates in {data.name} Average ${derivedAnnualCost}/yr</h3>
                    </div>
                    <p class="font-body-md text-xs sm:text-sm lg:text-base text-on-surface-variant leading-relaxed pl-4" set:html={linkStateNamesInText(blogContent.whyThisRate, allStates, data.slug)} />
                  </div>
                )}
                {blogContent.howCalculated?.trim() && (
                  <div class="flex flex-col gap-2 pt-4 sm:pt-5 border-t border-outline-variant/20">
                    <div class="flex items-center gap-2">
                      <div class="w-2 h-2 rounded-full bg-primary"></div>
                      <h3 class="font-headline-sm text-base sm:text-lg lg:text-xl text-primary font-bold">Calculating Premium Estimates</h3>
                    </div>
                    <p class="font-body-md text-xs sm:text-sm lg:text-base text-on-surface-variant leading-relaxed pl-4" set:html={linkStateNamesInText(blogContent.howCalculated, allStates, data.slug)} />
                  </div>
                )}
                {blogContent.comparisonNote?.trim() && (
                  <div class="flex flex-col gap-2 pt-4 sm:pt-5 border-t border-outline-variant/20">
                    <div class="flex items-center gap-2">
                      <div class="w-2 h-2 rounded-full bg-outline"></div>
                      <h3 class="font-headline-sm text-base sm:text-lg lg:text-xl text-primary font-bold">Regional & National Rate Comparison</h3>
                    </div>
                    <p class="font-body-md text-xs sm:text-sm lg:text-base text-on-surface-variant leading-relaxed pl-4" set:html={linkStateNamesInText(blogContent.comparisonNote, allStates, data.slug)} />
                  </div>
                )}
              </div>
            ) : (
              <div class="bg-surface-container-low p-6 rounded-2xl border border-dashed border-outline-variant/60 text-xs text-on-surface-variant/70 italic">
                [Dev Mode] Detailed rate analysis content for {data.name} will appear here once written.
              </div>
            )}
          </section>
        )}

        <!-- FAQ Section -->
        {(validFaqs.length > 0 || isDev) && (
          <section class="mt-stack-md pt-stack-lg border-t border-outline-variant/50 w-full">
            <div class="text-center mb-4 sm:mb-stack-md max-w-2xl mx-auto">
              <h2 class="font-headline-lg text-xl sm:text-2xl lg:text-3xl text-primary font-bold mb-1.5 sm:mb-2">Frequently Asked Questions</h2>
              <p class="font-body-md text-xs sm:text-sm lg:text-base text-on-surface-variant">Common queries regarding {data.name} renters insurance.</p>
            </div>
            {validFaqs.length > 0 ? (
              <>
                <script type="application/ld+json" is:inline set:html={JSON.stringify({
                  "@context": "https://schema.org",
                  "@type": "FAQPage",
                  "mainEntity": validFaqs.map(faq => ({
                    "@type": "Question",
                    "name": faq.question,
                    "acceptedAnswer": {
                      "@type": "Answer",
                      "text": faq.answer
                    }
                  }))
                })} />
                <div class="flex flex-col gap-3.5 max-w-4xl mx-auto">
                  {validFaqs.map(faq => (
                    <details class="group bg-surface-container-lowest rounded-2xl border border-outline-variant/30 shadow-sm overflow-hidden transition-all duration-200 hover:border-primary/40 hover:shadow-md">
                      <summary class="p-5 flex justify-between items-center font-headline-sm font-bold text-primary hover:text-secondary cursor-pointer list-none select-none gap-4 text-base">
                        <div class="flex items-center gap-3">
                          <div class="w-8 h-8 rounded-lg bg-surface-container-low text-primary flex items-center justify-center shrink-0 group-hover:bg-primary group-hover:text-on-primary transition-colors">
                            <span class="material-symbols-outlined text-[18px]">help_outline</span>
                          </div>
                          <span>{faq.question}</span>
                        </div>
                        <div class="w-7 h-7 rounded-full bg-surface-container-low flex items-center justify-center shrink-0 group-open:rotate-180 transition-transform duration-300 text-on-surface-variant">
                          <span class="material-symbols-outlined text-[18px]">expand_more</span>
                        </div>
                      </summary>
                      <div class="px-5 pb-5 pt-0">
                        <div class="pt-3 border-t border-outline-variant/15 text-sm text-on-surface-variant leading-relaxed">
                          {faq.answer}
                        </div>
                      </div>
                    </details>
                  ))}
                </div>
              </>
            ) : (
              <div class="bg-surface-container-low p-6 rounded-2xl border border-dashed border-outline-variant/60 text-xs text-on-surface-variant/70 text-center italic max-w-4xl mx-auto">
                [Dev Mode] Frequently asked questions for {data.name} will appear here once written.
              </div>
            )}
          </section>
        )}

        <!-- Related States Cross-Linking Section -->
        <RelatedStates currentState={stateEntry} allStates={allStates} />
      </div>
    </div>
  </main>

  <PageFooter />
</body>
</html>
