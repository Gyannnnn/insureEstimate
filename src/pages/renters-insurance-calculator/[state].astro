---
import fs from 'node:fs';
import path from 'node:path';
import { getCollection, getEntry } from 'astro:content';
import SiteHeader from '../../components/SiteHeader.astro';
import PageFooter from '../../components/PageFooter.astro';
import CalculatorCard from '../../components/CalculatorCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import '../../styles/global.css';

export async function getStaticPaths() {
  return (await getCollection('states')).map(({ data }) => ({ params: { state: data.slug } }));
}
const stateEntry = await getEntry('states', Astro.params.state!);
if (!stateEntry) return Astro.redirect('/');
const { data } = stateEntry;
const title = data.seoTitle || `Renters Insurance Cost in ${data.name}`;
const description = data.seoDescription || `Estimate your monthly renters insurance premium in ${data.name}.`;

const baseMonthlyRate = data.baseRate ? Math.round(data.baseRate / 12) : 15;

const defaultImage = '/images/states/default.jpg';
let stateImage = data.image || `/images/states/${data.slug}.jpg`;

const relativePath = stateImage.startsWith('/') ? stateImage.slice(1) : stateImage;
const absoluteImagePath = path.join(process.cwd(), 'public', relativePath);

if (!fs.existsSync(absoluteImagePath)) {
  stateImage = defaultImage;
}
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title} | InsureEstimate</title>
  <meta name="description" content={description}>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap" rel="stylesheet">
</head>
<body class="bg-background font-body-md text-on-surface">
  <SiteHeader active="Renters Insurance" />

  <main class="w-full pt-20 md:pt-24 min-h-[calc(100vh-300px)]">
    <div class="flex flex-col w-full relative">
      <!-- Gradient mesh & blur decorations -->
      <div aria-hidden="true" class="absolute inset-0 pointer-events-none -z-10 overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-br from-surface to-surface-container-low"></div>
        <div class="absolute top-0 right-0 w-[800px] h-[800px] bg-secondary-container/10 rounded-full blur-[120px] -translate-y-1/2 translate-x-1/3"></div>
        <div class="absolute bottom-0 left-0 w-[600px] h-[600px] bg-primary-fixed/20 rounded-full blur-[100px] translate-y-1/3 -translate-x-1/4"></div>
      </div>

      <!-- Main Layout Container -->
      <div class="max-w-[1280px] mx-auto w-full px-margin-mobile md:px-margin-desktop pt-4 pb-stack-lg lg:pb-[72px] relative z-10 flex flex-col gap-stack-lg lg:gap-[96px]">
        <!-- Breadcrumbs Navigation -->
        <Breadcrumbs items={[
          { label: 'Renters Insurance', href: '/renters-insurance-calculator/' },
          { label: data.name }
        ]} />

        <!-- Hero Section -->
        <section class="flex flex-col md:flex-row gap-gutter items-start">
          <div class="flex-1 flex flex-col gap-stack-md max-w-2xl">
            <div class="flex items-center gap-base">
              <span class="w-8 h-[2px] bg-primary"></span>
              <span class="font-label-sm text-label-sm tracking-widest uppercase text-on-surface-variant">{data.name} State Data</span>
            </div>
            <h1 class="font-display-lg text-display-lg text-primary text-balance">Renters Insurance Cost in {data.name}</h1>
            <p class="font-body-lg text-body-lg text-on-surface-variant text-balance leading-relaxed">
              Estimate your monthly renters insurance premium in {data.name}. Adjust coverage limits and deductibles to see how they impact your projected costs based on localized data models.
            </p>
            <div class="flex flex-col sm:flex-row gap-stack-sm mt-stack-sm">
              <a class="inline-flex items-center justify-center bg-primary text-on-primary px-6 py-3 rounded hover:bg-primary/90 transition-colors h-12 font-data-tabular text-data-tabular tracking-wide shadow-sm" href="#calculator">
                Calculate Estimate
              </a>
              <a class="inline-flex items-center justify-center bg-surface-container-lowest text-primary border border-outline-variant px-6 py-3 rounded hover:bg-surface-container-low transition-colors h-12 font-data-tabular text-data-tabular tracking-wide shadow-sm" href="#methodology">
                View Methodology
              </a>
            </div>
          </div>
          <div class="flex-1 hidden md:block w-full h-[320px] rounded-lg overflow-hidden shadow-lg relative group">
            <div class="absolute inset-0 bg-gradient-to-t from-primary/80 via-primary/20 to-transparent z-10 mix-blend-multiply"></div>
            <div class="bg-cover bg-center w-full h-full transition-transform duration-700 group-hover:scale-105" style={`background-image: url('${stateImage}')`}></div>
            <div class="absolute bottom-6 left-6 z-20 flex flex-col gap-1">
              <span class="font-data-tabular text-data-tabular text-on-primary/80">State Profile</span>
              <span class="font-headline-md text-headline-md text-on-primary">{data.name} ({data.abbreviation})</span>
            </div>
          </div>
        </section>

        <!-- Calculator Section -->
        <div id="calculator" class="w-full scroll-mt-[100px]">
          <CalculatorCard
            title={`${data.name} Renters Insurance Estimator`}
            subtitle={`Model monthly premium ranges for ${data.name} based on state actuarial benchmarks.`}
            type="renters"
            entityName={data.name}
            baseRate={data.baseRate}
          />
        </div>

        <!-- Data Grid Section -->
        <section class="flex flex-col gap-stack-md mt-stack-md">
          <h2 class="font-headline-lg text-headline-lg text-primary border-b border-outline-variant/50 pb-4">{data.name} Market Data</h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-gutter">
            <!-- Card 1: Average Cost -->
            <div class="bg-surface-container-lowest rounded-lg p-stack-md shadow-sm border border-outline-variant/30 flex flex-col relative group hover:shadow-md transition-shadow">
              <div class="absolute top-0 right-0 w-16 h-16 bg-primary/5 rounded-bl-full -z-10 transition-transform group-hover:scale-110"></div>
              <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider mb-2">State Average</span>
              <h3 class="font-headline-md text-headline-md text-primary mb-4">Average Cost</h3>
              <div class="flex items-baseline gap-2 mb-4">
                <span class="font-display-lg text-[40px] text-primary leading-none">${data.baseRate || 194}</span>
                <span class="font-data-tabular text-data-tabular text-on-surface-variant">/year</span>
              </div>
              <p class="font-body-md text-[14px] text-on-surface-variant leading-relaxed">
                The average cost of renters insurance in {data.name} is approximately ${data.baseRate || 194} per year, or roughly ${baseMonthlyRate} per month.
              </p>
              <div class="mt-auto pt-6">
                <div class="flex justify-between font-data-tabular text-[12px] text-on-surface-variant mb-1">
                  <span>{data.abbreviation} Average</span>
                  <span>National Average ($212)</span>
                </div>
                <div class="w-full h-2 bg-surface-container-high rounded-full overflow-hidden flex">
                  <div class="bg-secondary w-[91%] h-full rounded-l-full"></div>
                  <div class="bg-outline-variant w-[9%] h-full"></div>
                </div>
              </div>
            </div>

            <!-- Card 2: Typical Coverage -->
            <div class="bg-surface-container-lowest rounded-lg p-stack-md shadow-sm border border-outline-variant/30 flex flex-col relative group hover:shadow-md transition-shadow">
              <div class="absolute top-0 right-0 w-16 h-16 bg-primary/5 rounded-bl-full -z-10 transition-transform group-hover:scale-110"></div>
              <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider mb-2">Demographics</span>
              <h3 class="font-headline-md text-headline-md text-primary mb-4">Typical Coverage</h3>
              <ul class="flex flex-col gap-3 font-data-tabular text-[14px] mb-4">
                <li class="flex justify-between border-b border-outline-variant/30 pb-2">
                  <span class="text-on-surface-variant">Personal Property</span>
                  <span class="text-primary font-medium">$30,000</span>
                </li>
                <li class="flex justify-between border-b border-outline-variant/30 pb-2">
                  <span class="text-on-surface-variant">Liability</span>
                  <span class="text-primary font-medium">$100,000</span>
                </li>
                <li class="flex justify-between pb-2">
                  <span class="text-on-surface-variant">Deductible</span>
                  <span class="text-primary font-medium">$500</span>
                </li>
              </ul>
              <p class="font-body-md text-[14px] text-on-surface-variant leading-relaxed mt-auto">
                Most {data.name} renters opt for standard coverage limits, balancing adequate protection with affordable premiums.
              </p>
            </div>

            <!-- Card 3: Specific Considerations -->
            <div class="bg-surface-container-lowest rounded-lg p-stack-md shadow-sm border border-outline-variant/30 flex flex-col relative group hover:shadow-md transition-shadow">
              <div class="absolute top-0 right-0 w-16 h-16 bg-primary/5 rounded-bl-full -z-10 transition-transform group-hover:scale-110"></div>
              <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider mb-2">Risk Factors</span>
              <h3 class="font-headline-md text-headline-md text-primary mb-4">{data.abbreviation} Considerations</h3>
              <div class="flex flex-col gap-4">
                <div class="flex gap-3 items-start">
                  <span class="material-symbols-outlined text-error mt-0.5 text-[20px]">volcano</span>
                  <div class="flex flex-col">
                    <span class="font-data-tabular text-[14px] text-primary font-medium">Natural Hazards</span>
                    <span class="font-body-md text-[13px] text-on-surface-variant">Standard policies cover fire and theft, but specific perils like earthquakes or floods require endorsements.</span>
                  </div>
                </div>
                <div class="flex gap-3 items-start">
                  <span class="material-symbols-outlined text-error mt-0.5 text-[20px]">local_fire_department</span>
                  <div class="flex flex-col">
                    <span class="font-data-tabular text-[14px] text-primary font-medium">Urban & Fire Risk</span>
                    <span class="font-body-md text-[13px] text-on-surface-variant">Coverage is essential for high-density living and wildland interface zones.</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- Split Section: Methodology & Image -->
        <section class="grid grid-cols-1 lg:grid-cols-2 gap-stack-lg items-center mt-stack-md pt-stack-lg border-t border-outline-variant/50 scroll-mt-24" id="methodology">
          <div class="flex flex-col gap-stack-md">
            <div class="flex items-center gap-2 mb-2">
              <span class="w-8 h-[2px] bg-outline-variant"></span>
              <span class="font-label-sm text-label-sm tracking-widest uppercase text-on-surface-variant">Process</span>
            </div>
            <h2 class="font-display-lg text-[36px] leading-[44px] text-primary tracking-tight">How we calculate estimates</h2>
            <div class="flex flex-col gap-6 mt-4 relative">
              <div class="absolute left-[11px] top-2 bottom-2 w-[1px] bg-outline-variant/50 -z-10"></div>
              <div class="flex gap-4 items-start bg-surface-container-lowest p-4 rounded-lg shadow-sm border border-outline-variant/30">
                <div class="w-6 h-6 rounded-full bg-primary text-on-primary flex items-center justify-center font-data-tabular text-[12px] shrink-0 mt-0.5">1</div>
                <div class="flex flex-col">
                  <h4 class="font-data-tabular text-[16px] text-primary font-medium">Data Aggregation</h4>
                  <p class="font-body-md text-[14px] text-on-surface-variant mt-1">We collect anonymized quoting data from top carriers across {data.name} ZIP codes, updated quarterly.</p>
                </div>
              </div>
              <div class="flex gap-4 items-start bg-surface-container-lowest p-4 rounded-lg shadow-sm border border-outline-variant/30">
                <div class="w-6 h-6 rounded-full bg-primary text-on-primary flex items-center justify-center font-data-tabular text-[12px] shrink-0 mt-0.5">2</div>
                <div class="flex flex-col">
                  <h4 class="font-data-tabular text-[16px] text-primary font-medium">Actuarial Modeling</h4>
                  <p class="font-body-md text-[14px] text-on-surface-variant mt-1">Base rates are adjusted using proprietary multipliers for coverage limits, deductibles, and local risk factors.</p>
                </div>
              </div>
              <div class="flex gap-4 items-start bg-surface-container-lowest p-4 rounded-lg shadow-sm border border-outline-variant/30">
                <div class="w-6 h-6 rounded-full bg-primary text-on-primary flex items-center justify-center font-data-tabular text-[12px] shrink-0 mt-0.5">3</div>
                <div class="flex flex-col">
                  <h4 class="font-data-tabular text-[16px] text-primary font-medium">Estimate Generation</h4>
                  <p class="font-body-md text-[14px] text-on-surface-variant mt-1">The calculator outputs a localized projection, designed to give you a realistic baseline before seeking official quotes.</p>
                </div>
              </div>
            </div>
          </div>

          <div class="w-full h-full min-h-[400px] bg-surface-container-low rounded-xl shadow-inner relative overflow-hidden flex items-center justify-center">
            <div class="absolute inset-0 bg-cover bg-center opacity-80 mix-blend-luminosity" style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuCV5XOuzo2X2Wf_QBYeMa5HNavdHTJRmHpwzpiDxVw_oMSwJXOwPxKIr0oAvYSWMGMT0sMW-sDKc9-g2y_-GitkYFs-7XeCh_YCkS3p6f4Q4Bvk96ivBo_7wpwmAmhu7tb91SIQ_GWmldWgwb7kaHbo-LK9a62Ov4JhgdLl56SvFW-uFRAAb0Ha32OlKJc3LwvjqPYmppmi4MekXyI7cjXeAqty0jL18uMC3qt6MmNOunVysAbrUsib')"></div>
            <div class="absolute inset-0 bg-gradient-to-br from-primary/10 via-transparent to-primary/5 mix-blend-overlay"></div>
            <div class="relative z-10 bg-white/90 backdrop-blur-md p-6 rounded-lg shadow-xl border border-white/20 max-w-xs transform rotate-1">
              <span class="material-symbols-outlined text-secondary text-[24px] mb-2">database</span>
              <h5 class="font-data-tabular text-[14px] text-primary font-semibold mb-1">Model Integrity</h5>
              <p class="font-body-md text-[12px] text-on-surface-variant">Estimates are non-binding projections based on historical rate filings and aggregated quote data.</p>
            </div>
          </div>
        </section>

        <!-- FAQ Section -->
        <section class="mt-stack-md pt-stack-lg border-t border-outline-variant/50 max-w-4xl mx-auto w-full">
          <div class="text-center mb-stack-md">
            <h2 class="font-headline-lg text-headline-lg text-primary mb-2">Frequently Asked Questions</h2>
            <p class="font-body-md text-on-surface-variant">Common queries regarding {data.name} renters insurance.</p>
          </div>
          <div class="bg-surface-container-lowest rounded-lg shadow-sm border border-outline-variant/30 overflow-hidden">
            <div class="grid grid-cols-1 divide-y divide-outline-variant/30">
              <div class="p-6 hover:bg-surface-bright transition-colors">
                <h3 class="font-data-tabular text-[16px] text-primary font-medium mb-2">Is renters insurance required by law in {data.name}?</h3>
                <p class="font-body-md text-[14px] text-on-surface-variant leading-relaxed">
                  No, state law does not mandate renters insurance. However, the majority of landlords and property management companies require proof of a policy before signing a lease.
                </p>
              </div>
              <div class="p-6 hover:bg-surface-bright transition-colors">
                <h3 class="font-data-tabular text-[16px] text-primary font-medium mb-2">Does standard renters insurance cover natural disasters?</h3>
                <p class="font-body-md text-[14px] text-on-surface-variant leading-relaxed">
                  Standard policies exclude earth movement and floods. You may need a separate policy or endorsement for comprehensive hazard protection.
                </p>
              </div>
              <div class="p-6 hover:bg-surface-bright transition-colors">
                <h3 class="font-data-tabular text-[16px] text-primary font-medium mb-2">How much liability coverage should I have?</h3>
                <p class="font-body-md text-[14px] text-on-surface-variant leading-relaxed">
                  $100,000 is the standard baseline, but raising it to $300,000 often costs only a few extra dollars a month and provides significantly better protection.
                </p>
              </div>
            </div>
          </div>
        </section>
      </div>
    </div>
  </main>

  <PageFooter />
</body>
</html>
