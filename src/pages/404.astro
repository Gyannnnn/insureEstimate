---
import SiteHeader from "../components/SiteHeader.astro";
import PageFooter from "../components/PageFooter.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import "../styles/global.css";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Page Not Found - InsureEstimate</title>
  <meta name="description" content="The page you are looking for could not be found. Return to InsureEstimate home or explore our calculators.">
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap" rel="stylesheet">
  <style>
    body {
      min-height: max(884px, 100dvh);
    }
  </style>
</head>
<body class="bg-background font-body-md text-on-surface">
  <SiteHeader />

  <main class="w-full pt-20 md:pt-24 min-h-[calc(100vh-300px)]">
    <div class="max-w-[1280px] mx-auto px-margin-mobile md:px-margin-desktop pt-2">
      <Breadcrumbs items={[{ label: '404 Page Not Found' }]} />
    </div>
    <!-- LARGE SCREEN: 404 Page Not Found - Desktop (ID: 96dea82c2a004653b22706b4b1216914) -->
    <div class="hidden lg:flex flex-col w-full h-[calc(100vh-300px)] min-h-[600px] items-center justify-center relative overflow-hidden bg-background">
      <!-- Subtle Ambient Background -->
      <div class="absolute inset-0 pointer-events-none opacity-20">
        <svg height="100%" width="100%" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <pattern height="40" id="gridPattern" patternUnits="userSpaceOnUse" width="40">
              <path class="text-outline-variant opacity-30" d="M 40 0 L 0 0 0 40" fill="none" stroke="currentColor" stroke-width="0.5"></path>
            </pattern>
            <radialGradient cx="50%" cy="50%" id="grad1" r="50%">
              <stop offset="0%" stop-color="var(--color-primary-fixed)" stop-opacity="0.1"></stop>
              <stop offset="100%" stop-color="var(--color-background)" stop-opacity="0"></stop>
            </radialGradient>
          </defs>
          <rect fill="url(#gridPattern)" height="100%" width="100%"></rect>
          <circle class="animate-pulse" cx="50%" cy="40%" fill="url(#grad1)" r="40%" style="animation-duration: 8s;"></circle>
        </svg>
      </div>

      <!-- Main Content Container -->
      <div class="max-w-[1280px] w-full px-margin-mobile md:px-margin-desktop relative z-10 flex flex-col lg:flex-row items-center justify-center gap-stack-lg lg:gap-[120px]">
        <!-- Left: Typography & Message -->
        <div class="flex flex-col items-center lg:items-start text-center lg:text-left max-w-lg">
          <div class="flex items-center gap-stack-sm mb-stack-sm opacity-80">
            <span class="material-symbols-outlined text-primary text-[24px]">search_off</span>
            <span class="font-label-sm text-label-sm text-primary uppercase tracking-widest">Error 404</span>
          </div>
          <h1 class="font-display-lg text-display-lg text-primary mb-stack-md leading-none">
            Page Not Found
          </h1>
          <p class="font-body-lg text-body-lg text-on-surface-variant mb-stack-lg max-w-md">
            The insurance calculation or guide you're looking for might have moved, or the link is incorrect. Our data suggests this path no longer exists.
          </p>
          <a class="inline-flex items-center justify-center px-8 py-3 bg-primary text-on-primary font-label-sm text-label-sm rounded-lg hover:bg-primary/90 transition-colors min-w-[200px] h-[48px]" href="/renters-insurance-calculator/">
            Return to Renters Estimator
          </a>
        </div>

        <!-- Right: Geometric Visual & Quick Links -->
        <div class="flex flex-col w-full max-w-md gap-stack-md">
          <!-- Institutional Geometric Graphic -->
          <div class="w-full aspect-[2/1] bg-surface-container-low rounded-xl relative overflow-hidden flex items-center justify-center shadow-sm">
            <div class="absolute w-[60%] h-[1px] bg-outline-variant transform rotate-45 opacity-50"></div>
            <div class="absolute w-[60%] h-[1px] bg-outline-variant transform -rotate-45 opacity-50"></div>
            <div class="w-16 h-16 border border-primary/20 rounded-full flex items-center justify-center bg-surface relative z-10">
              <span class="material-symbols-outlined text-primary text-[32px] font-light">data_alert</span>
            </div>
            <!-- Floating Data Nodes -->
            <div class="absolute top-1/4 left-1/4 w-2 h-2 bg-secondary-fixed rounded-full shadow-sm"></div>
            <div class="absolute bottom-1/3 right-1/4 w-3 h-3 bg-primary-fixed rounded-full shadow-sm"></div>
            <div class="absolute top-1/2 right-1/6 w-1 h-1 bg-tertiary-fixed rounded-full shadow-sm"></div>
          </div>

          <!-- Quick Links Card -->
          <div class="bg-surface-container-lowest rounded-xl p-stack-md shadow-[0_4px_24px_rgba(19,27,46,0.06)] border border-outline-variant/30 flex flex-col gap-stack-sm relative z-20">
            <h3 class="font-label-sm text-label-sm text-on-surface uppercase tracking-wider mb-base border-b border-outline-variant/20 pb-base">
              Quick Links
            </h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-stack-sm">
              <a class="flex items-center gap-stack-sm group p-base -mx-base rounded-lg hover:bg-surface-container-low transition-colors" href="/renters-insurance-calculator/">
                <div class="w-8 h-8 rounded-full bg-primary-fixed/30 flex items-center justify-center group-hover:bg-primary-fixed transition-colors">
                  <span class="material-symbols-outlined text-primary text-[16px]">calculate</span>
                </div>
                <span class="font-body-md text-body-md text-on-surface-variant group-hover:text-primary transition-colors">Renters Calculator</span>
              </a>
              <a class="flex items-center gap-stack-sm group p-base -mx-base rounded-lg hover:bg-surface-container-low transition-colors" href="/business-insurance-calculator/">
                <div class="w-8 h-8 rounded-full bg-secondary-fixed/30 flex items-center justify-center group-hover:bg-secondary-fixed transition-colors">
                  <span class="material-symbols-outlined text-secondary text-[16px]">business_center</span>
                </div>
                <span class="font-body-md text-body-md text-on-surface-variant group-hover:text-primary transition-colors">Business Insurance</span>
              </a>
              <a class="flex items-center gap-stack-sm group p-base -mx-base rounded-lg hover:bg-surface-container-low transition-colors" href="#">
                <div class="w-8 h-8 rounded-full bg-tertiary-fixed/30 flex items-center justify-center group-hover:bg-tertiary-fixed transition-colors">
                  <span class="material-symbols-outlined text-tertiary text-[16px]">menu_book</span>
                </div>
                <span class="font-body-md text-body-md text-on-surface-variant group-hover:text-primary transition-colors">Professional Guides</span>
              </a>
              <a class="flex items-center gap-stack-sm group p-base -mx-base rounded-lg hover:bg-surface-container-low transition-colors" href="#">
                <div class="w-8 h-8 rounded-full bg-surface-variant flex items-center justify-center group-hover:bg-outline-variant transition-colors">
                  <span class="material-symbols-outlined text-on-surface text-[16px]">support_agent</span>
                </div>
                <span class="font-body-md text-body-md text-on-surface-variant group-hover:text-primary transition-colors">Contact Support</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- SMALL SCREEN: 404 Page Not Found - Mobile (ID: e21b35bcdfd24b7cb5cd32f8e12eeae4) -->
    <div class="flex lg:hidden flex-col w-full h-full min-h-[530px] items-center justify-center px-margin-mobile py-stack-lg text-center bg-surface">
      <div class="relative w-full max-w-[400px] flex flex-col items-center gap-stack-md">
        <div class="relative group">
          <div class="absolute -inset-4 bg-primary/5 rounded-full blur-xl transition-all duration-700 opacity-50 group-hover:opacity-100 group-hover:scale-110"></div>
          <h1 class="font-display-lg text-[120px] leading-[1] font-bold text-transparent bg-clip-text bg-gradient-to-br from-primary to-primary-container relative z-10 tracking-tighter mix-blend-multiply">
            404
          </h1>
          <div class="absolute top-0 right-0 -mr-8 -mt-4 w-12 h-12 bg-secondary-container/20 rounded-full blur-md"></div>
          <div class="absolute bottom-0 left-0 -ml-6 -mb-2 w-16 h-16 bg-tertiary-container/10 rounded-full blur-lg"></div>
        </div>
        <div class="flex flex-col gap-stack-sm w-full">
          <h2 class="font-headline-lg-mobile text-headline-lg-mobile text-on-surface">
            Page Not Found
          </h2>
          <p class="font-body-md text-body-md text-on-surface-variant max-w-[280px] mx-auto leading-relaxed">
            We can't seem to find the page you're looking for. It might have been moved or deleted.
          </p>
        </div>
        <div class="w-full mt-stack-sm flex flex-col gap-stack-sm">
          <a class="w-full inline-flex items-center justify-center h-12 px-6 rounded-xl bg-primary text-on-primary font-label-sm text-label-sm shadow-[0_4px_14px_0_rgba(0,0,0,0.15)] hover:shadow-[0_6px_20px_rgba(0,0,0,0.2)] hover:scale-[1.02] transition-all duration-200 active:scale-[0.98]" href="/">
            <span class="material-symbols-outlined mr-2 text-[18px]">home</span>
            Return to Home
          </a>
        </div>
        <div class="w-full mt-stack-md pt-stack-md border-t border-outline-variant/30 flex flex-col gap-stack-sm">
          <h3 class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider mb-2">
            Helpful Links
          </h3>
          <div class="grid grid-cols-1 gap-2 w-full">
            <a class="flex items-center justify-between p-4 rounded-xl bg-surface-container-low hover:bg-surface-container transition-colors group" href="/renters-insurance-calculator/">
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-full bg-primary/5 flex items-center justify-center text-primary group-hover:bg-primary/10 transition-colors">
                  <span class="material-symbols-outlined text-[18px]">calculate</span>
                </div>
                <span class="font-body-md text-body-md text-on-surface font-medium">Calculators</span>
              </div>
              <span class="material-symbols-outlined text-on-surface-variant text-[18px] opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all">arrow_forward</span>
            </a>
            <a class="flex items-center justify-between p-4 rounded-xl bg-surface-container-low hover:bg-surface-container transition-colors group" href="#">
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-full bg-secondary/5 flex items-center justify-center text-secondary group-hover:bg-secondary/10 transition-colors">
                  <span class="material-symbols-outlined text-[18px]">menu_book</span>
                </div>
                <span class="font-body-md text-body-md text-on-surface font-medium">Guides</span>
              </div>
              <span class="material-symbols-outlined text-on-surface-variant text-[18px] opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all">arrow_forward</span>
            </a>
            <a class="flex items-center justify-between p-4 rounded-xl bg-tertiary/5 hover:bg-tertiary/10 transition-colors group" href="#">
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-full bg-tertiary/10 flex items-center justify-center text-tertiary group-hover:bg-tertiary/20 transition-colors">
                  <span class="material-symbols-outlined text-[18px]">support_agent</span>
                </div>
                <span class="font-body-md text-body-md text-on-surface font-medium">Support</span>
              </div>
              <span class="material-symbols-outlined text-on-surface-variant text-[18px] opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all">arrow_forward</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </main>

  <PageFooter />
</body>
</html>
