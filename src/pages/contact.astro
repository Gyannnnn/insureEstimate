---
import SiteHeader from '../components/SiteHeader.astro';
import PageFooter from '../components/PageFooter.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import Fonts from '../components/Fonts.astro';
import SiteSchema from '../components/SiteSchema.astro';
import '../styles/global.css';

const breadcrumbItems = [
  { label: 'Contact Us' }
];

const contactTopics = [
  { value: '', label: 'Select Inquiry Category...' },
  { value: 'general', label: 'General Platform Question' },
  { value: 'feedback', label: 'Calculator Feedback & Suggestion' },
  { value: 'data_update', label: 'State Rate Data Update' },
  { value: 'media', label: 'Media & Press Inquiry' },
  { value: 'privacy', label: 'Data Privacy Request' }
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <GoogleAnalytics />
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Contact Us - InsureEstimate Support & Inquiries</title>
  <meta name="description" content="Get in touch with the InsureEstimate actuarial research team for inquiries, state rate feedback, media requests, or calculator suggestions.">
  <link rel="canonical" href="https://insureestimate.com/contact/" />
  <Fonts />
  <SiteSchema />
</head>
<body class="bg-canvas font-sans text-ink antialiased">
  <SiteHeader active="" />

  <main class="w-full pt-16">
    <div class="container-page pt-8">
      <Breadcrumbs items={breadcrumbItems} />

      <!-- PAGE HEADER -->
      <section class="mb-12 mt-8 border-b border-hairline pb-10">
        <div class="flex max-w-3xl flex-col gap-4">
          <span class="eyebrow">Get In Touch</span>
          <h1 class="title-page">
            Contact InsureEstimate Support
          </h1>
          <p class="lead">
            Have questions about our actuarial calculation methodology, state renters rate data, or business insurance risk models? Send us a message and our email engine will deliver it directly to our team.
          </p>
        </div>
      </section>

      <!-- 2-COLUMN CONTENT SECTION -->
      <div class="grid grid-cols-1 items-start gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.3fr)] lg:gap-12">

        <!-- LEFT COLUMN: CONTACT CARDS -->
        <div class="flex flex-col gap-6">
          <div class="card overflow-hidden">
            <div class="flex flex-col gap-1 border-b border-hairline p-6">
              <span class="eyebrow">Fast Support SLA</span>
              <h2 class="title-card">Direct Channels</h2>
              <p class="text-body-md text-body">Our research and data compliance team reviews every submission promptly.</p>
            </div>

            <div class="flex flex-col divide-y divide-hairline text-body-md">
              <div class="flex items-start gap-4 px-6 py-4">
                <span class="icon-tile h-8 w-8"><span class="material-symbols-outlined text-[18px]">mail</span></span>
                <div class="min-w-0">
                  <span class="block font-medium text-ink">General &amp; Support Inquiries</span>
                  <a href="mailto:hi.gyanaranjanpatra@gmail.com" class="link break-all font-normal">hi.gyanaranjanpatra@gmail.com</a>
                </div>
              </div>

              <div class="flex items-start gap-4 px-6 py-4">
                <span class="icon-tile h-8 w-8"><span class="material-symbols-outlined text-[18px]">security</span></span>
                <div class="min-w-0">
                  <span class="block font-medium text-ink">Data Privacy &amp; Legal Office</span>
                  <a href="mailto:hi.gyanaranjanpatra@gmail.com" class="link break-all font-normal">hi.gyanaranjanpatra@gmail.com</a>
                </div>
              </div>

              <div class="flex items-start gap-4 px-6 py-4">
                <span class="icon-tile h-8 w-8"><span class="material-symbols-outlined text-[18px]">schedule</span></span>
                <div>
                  <span class="block font-medium text-ink">Support Operating Hours</span>
                  <span class="text-body">Mon - Fri: 8:00 AM - 6:00 PM EST</span>
                </div>
              </div>
            </div>
          </div>

          <!-- FAQ SNIPPET CARD -->
          <div class="well flex flex-col gap-4 p-6">
            <h3 class="flex items-center gap-2 text-body-lg font-semibold text-ink">
              <span class="material-symbols-outlined text-[20px] text-mute">help</span>
              Quick Answers
            </h3>
            <div class="flex flex-col divide-y divide-hairline text-body-md">
              <div class="pb-4">
                <p class="font-medium text-ink">Can I request an official insurance quote here?</p>
                <p class="mt-1 text-body">InsureEstimate provides actuarial estimates only. To buy a policy, contact licensed carrier agents directly.</p>
              </div>
              <div class="pt-4">
                <p class="font-medium text-ink">How often are state rates updated?</p>
                <p class="mt-1 text-body">Our state base rates are audited quarterly against state statutory insurance filings.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- RIGHT COLUMN: INTERACTIVE FORM WITH REAL-TIME VALIDATION & RESEND API -->
        <div class="panel p-6 shadow-md md:p-8">
          <div class="mb-6 flex flex-col gap-1">
            <h2 class="title-card">Send Us a Message</h2>
            <p class="text-body-md text-mute">Fill out the form below. All fields marked with <span class="text-error">*</span> are required.</p>
          </div>

          <!-- SERVER ERROR BANNER (HIDDEN INITIALLY) -->
          <div id="contact-api-error-banner" class="hidden mb-6 flex items-start gap-2.5 rounded-lg border border-error/20 bg-error-container p-4 text-body-md text-error" role="alert">
            <span class="material-symbols-outlined shrink-0 text-[20px]">error</span>
            <div class="space-y-0.5">
              <span class="block font-medium">Transmission Failed</span>
              <span id="api-error-text">An unexpected error occurred. Please try again.</span>
            </div>
          </div>

          <!-- SUCCESS BANNER (HIDDEN INITIALLY) -->
          <div id="contact-success-banner" class="hidden flex-col gap-3 rounded-xl border border-brand/30 bg-brand-soft p-6 text-ink" role="status">
            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-ink text-white">
              <span class="material-symbols-outlined text-[22px]">mark_email_read</span>
            </div>
            <h3 class="text-heading-md text-ink">Message Dispatched Successfully!</h3>
            <p class="text-body-md text-body">
              Thank you for contacting InsureEstimate. Your message has been sent to our support team. A team member will reply to your provided email address shortly.
            </p>
            <button
              id="reset-form-btn"
              type="button"
              class="btn-ghost-sm mt-2 self-start"
            >
              Send another message
            </button>
          </div>

          <!-- CONTACT FORM -->
          <form id="contact-form" novalidate class="flex flex-col gap-5">

            <!-- FULL NAME FIELD -->
            <div class="relative flex flex-col gap-2">
              <label for="contact-name" class="field-label">
                Full Name <span class="text-error">*</span>
              </label>
              <div class="relative">
                <input
                  type="text"
                  id="contact-name"
                  name="name"
                  autocomplete="name"
                  placeholder="e.g. Sarah Jenkins"
                  class="field-control pr-10"
                >
                <span id="name-valid-icon" class="hidden material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-[18px] text-brand-ink">check_circle</span>
              </div>
              <span id="name-error" class="hidden flex items-center gap-1 text-body-sm text-error">
                <span class="material-symbols-outlined text-[14px]">error</span>
                <span>Please enter your full name (at least 2 characters).</span>
              </span>
            </div>

            <!-- EMAIL ADDRESS FIELD -->
            <div class="relative flex flex-col gap-2">
              <label for="contact-email" class="field-label">
                Email Address <span class="text-error">*</span>
              </label>
              <div class="relative">
                <input
                  type="email"
                  id="contact-email"
                  name="email"
                  autocomplete="email"
                  placeholder="e.g. sarah.jenkins@example.com"
                  class="field-control pr-10"
                >
                <span id="email-valid-icon" class="hidden material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-[18px] text-brand-ink">check_circle</span>
              </div>
              <span id="email-error" class="hidden flex items-center gap-1 text-body-sm text-error">
                <span class="material-symbols-outlined text-[14px]">error</span>
                <span>Please enter a valid email address (e.g. user@domain.com).</span>
              </span>
            </div>

            <!-- INQUIRY CATEGORY FIELD -->
            <div class="relative flex flex-col gap-2">
              <label for="contact-subject" class="field-label">
                Inquiry Category <span class="text-error">*</span>
              </label>
              <div class="relative">
                <select
                  id="contact-subject"
                  name="subject"
                  class="field-control"
                >
                  {contactTopics.map((topic) => (
                    <option value={topic.value}>{topic.label}</option>
                  ))}
                </select>
              </div>
              <span id="subject-error" class="hidden flex items-center gap-1 text-body-sm text-error">
                <span class="material-symbols-outlined text-[14px]">error</span>
                <span>Please select an inquiry category.</span>
              </span>
            </div>

            <!-- MESSAGE FIELD -->
            <div class="relative flex flex-col gap-2">
              <label for="contact-message" class="field-label">
                Message <span class="text-error">*</span>
              </label>
              <textarea
                id="contact-message"
                name="message"
                rows="5"
                placeholder="Write your question, calculator feedback, or state data inquiry here..."
                class="field-control resize-y"
              ></textarea>
              <div class="flex items-center justify-between">
                <span id="message-error" class="hidden flex items-center gap-1 text-body-sm text-error">
                  <span class="material-symbols-outlined text-[14px]">error</span>
                  <span>Message must be at least 10 characters long.</span>
                </span>
                <span id="char-count" class="num ml-auto font-mono text-[11px] text-mute">0 / 1000</span>
              </div>
            </div>

            <!-- SUBMIT BUTTON WITH LOADING SPINNER ANIMATION -->
            <button
              id="contact-submit-btn"
              type="submit"
              class="btn mt-2 h-11 w-full rounded-md bg-ink px-5 text-body-lg text-white hover:bg-[#383838]"
            >
              <span id="btn-spinner" class="hidden h-4 w-4 animate-spin rounded-full border-2 border-white/30 border-t-white"></span>
              <span id="btn-text">Send Message</span>
              <span id="btn-icon" class="material-symbols-outlined text-[18px]">send</span>
            </button>

          </form>
        </div>

      </div>
    </div>
  </main>

  <PageFooter />

  <!-- CLIENT-SIDE SCRIPT CONNECTED TO RESEND API ENGINE -->
  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const nameInput = document.getElementById('contact-name') as HTMLInputElement | null;
    const emailInput = document.getElementById('contact-email') as HTMLInputElement | null;
    const subjectSelect = document.getElementById('contact-subject') as HTMLSelectElement | null;
    const messageInput = document.getElementById('contact-message') as HTMLTextAreaElement | null;

    const nameError = document.getElementById('name-error');
    const nameIcon = document.getElementById('name-valid-icon');

    const emailError = document.getElementById('email-error');
    const emailIcon = document.getElementById('email-valid-icon');

    const subjectError = document.getElementById('subject-error');

    const messageError = document.getElementById('message-error');
    const charCount = document.getElementById('char-count');

    const submitBtn = document.getElementById('contact-submit-btn') as HTMLButtonElement | null;
    const btnText = document.getElementById('btn-text');
    const btnSpinner = document.getElementById('btn-spinner');
    const btnIcon = document.getElementById('btn-icon');

    const apiErrorBanner = document.getElementById('contact-api-error-banner');
    const apiErrorText = document.getElementById('api-error-text');

    const successBanner = document.getElementById('contact-success-banner');
    const resetBtn = document.getElementById('reset-form-btn');

    // Validation Functions
    function validateName(): boolean {
      if (!nameInput) return false;
      const val = nameInput.value.trim();
      const isValid = val.length >= 2;

      if (isValid) {
        nameInput.classList.remove('border-red-500', 'bg-red-50/20');
        nameInput.classList.add('border-emerald-500', 'bg-emerald-50/20');
        nameError?.classList.add('hidden');
        nameIcon?.classList.remove('hidden');
      } else {
        nameInput.classList.remove('border-emerald-500', 'bg-emerald-50/20');
        if (val.length > 0) {
          nameInput.classList.add('border-red-500', 'bg-red-50/20');
          nameError?.classList.remove('hidden');
        } else {
          nameInput.classList.remove('border-red-500', 'bg-red-50/20');
          nameError?.classList.add('hidden');
        }
        nameIcon?.classList.add('hidden');
      }
      return isValid;
    }

    function validateEmail(): boolean {
      if (!emailInput) return false;
      const val = emailInput.value.trim();
      const regex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      const isValid = regex.test(val);

      if (isValid) {
        emailInput.classList.remove('border-red-500', 'bg-red-50/20');
        emailInput.classList.add('border-emerald-500', 'bg-emerald-50/20');
        emailError?.classList.add('hidden');
        emailIcon?.classList.remove('hidden');
      } else {
        emailInput.classList.remove('border-emerald-500', 'bg-emerald-50/20');
        if (val.length > 0) {
          emailInput.classList.add('border-red-500', 'bg-red-50/20');
          emailError?.classList.remove('hidden');
        } else {
          emailInput.classList.remove('border-red-500', 'bg-red-50/20');
          emailError?.classList.add('hidden');
        }
        emailIcon?.classList.add('hidden');
      }
      return isValid;
    }

    function validateSubject(): boolean {
      if (!subjectSelect) return false;
      const val = subjectSelect.value;
      const isValid = val !== '';

      if (isValid) {
        subjectSelect.classList.remove('border-red-500', 'bg-red-50/20');
        subjectSelect.classList.add('border-emerald-500', 'bg-emerald-50/20');
        subjectError?.classList.add('hidden');
      } else {
        subjectSelect.classList.remove('border-emerald-500', 'bg-emerald-50/20');
        subjectSelect.classList.add('border-red-500', 'bg-red-50/20');
        subjectError?.classList.remove('hidden');
      }
      return isValid;
    }

    function validateMessage(): boolean {
      if (!messageInput) return false;
      const val = messageInput.value.trim();
      const isValid = val.length >= 10;

      if (charCount) charCount.textContent = `${val.length} / 1000`;

      if (isValid) {
        messageInput.classList.remove('border-red-500', 'bg-red-50/20');
        messageInput.classList.add('border-emerald-500', 'bg-emerald-50/20');
        messageError?.classList.add('hidden');
      } else {
        messageInput.classList.remove('border-emerald-500', 'bg-emerald-50/20');
        if (val.length > 0) {
          messageInput.classList.add('border-red-500', 'bg-red-50/20');
          messageError?.classList.remove('hidden');
        } else {
          messageInput.classList.remove('border-red-500', 'bg-red-50/20');
          messageError?.classList.add('hidden');
        }
      }
      return isValid;
    }

    // Attach Real-Time Event Listeners
    nameInput?.addEventListener('input', validateName);
    nameInput?.addEventListener('blur', validateName);

    emailInput?.addEventListener('input', validateEmail);
    emailInput?.addEventListener('blur', validateEmail);

    subjectSelect?.addEventListener('change', validateSubject);

    messageInput?.addEventListener('input', validateMessage);
    messageInput?.addEventListener('blur', validateMessage);

    // Form Submit Handler with Resend Integration
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();

      apiErrorBanner?.classList.add('hidden');

      const isNameValid = validateName();
      const isEmailValid = validateEmail();
      const isSubjectValid = validateSubject();
      const isMessageValid = validateMessage();

      if (!isNameValid && nameInput) {
        nameInput.classList.add('border-red-500', 'bg-red-50/20');
        nameError?.classList.remove('hidden');
      }
      if (!isEmailValid && emailInput) {
        emailInput.classList.add('border-red-500', 'bg-red-50/20');
        emailError?.classList.remove('hidden');
      }
      if (!isSubjectValid && subjectSelect) {
        subjectSelect.classList.add('border-red-500', 'bg-red-50/20');
        subjectError?.classList.remove('hidden');
      }
      if (!isMessageValid && messageInput) {
        messageInput.classList.add('border-red-500', 'bg-red-50/20');
        messageError?.classList.remove('hidden');
      }

      if (!isNameValid || !isEmailValid || !isSubjectValid || !isMessageValid) {
        return;
      }

      // Enter Loading State
      if (submitBtn) submitBtn.disabled = true;
      if (btnText) btnText.textContent = 'Sending Email...';
      btnSpinner?.classList.remove('hidden');
      btnIcon?.classList.add('hidden');

      const payload = {
        name: nameInput?.value.trim(),
        email: emailInput?.value.trim(),
        subject: subjectSelect?.value,
        message: messageInput?.value.trim()
      };

      try {
        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const data = await response.json();

        if (response.ok && data.success) {
          form.classList.add('hidden');
          successBanner?.classList.remove('hidden');
          successBanner?.classList.add('flex');
        } else {
          throw new Error(data.error || 'Server reported failure during dispatch.');
        }
      } catch (err: any) {
        console.error('Submission error:', err);
        if (apiErrorBanner && apiErrorText) {
          apiErrorText.textContent = err.message || 'Network error occurred while connecting to Resend engine.';
          apiErrorBanner.classList.remove('hidden');
        }
      } finally {
        if (submitBtn) submitBtn.disabled = false;
        if (btnText) btnText.textContent = 'Send Message';
        btnSpinner?.classList.add('hidden');
        btnIcon?.classList.remove('hidden');
      }
    });

    // Reset Form Listener
    resetBtn?.addEventListener('click', () => {
      form?.reset();
      form?.classList.remove('hidden');
      successBanner?.classList.add('hidden');
      successBanner?.classList.remove('flex');
      apiErrorBanner?.classList.add('hidden');

      [nameInput, emailInput, subjectSelect, messageInput].forEach(el => {
        el?.classList.remove('border-emerald-500', 'bg-emerald-50/20', 'border-red-500', 'bg-red-50/20');
      });

      nameIcon?.classList.add('hidden');
      emailIcon?.classList.add('hidden');
      if (charCount) charCount.textContent = '0 / 1000';
    });
  </script>
</body>
</html>
