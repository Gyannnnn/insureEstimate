---
import SiteHeader from '../components/SiteHeader.astro';
import PageFooter from '../components/PageFooter.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import Fonts from '../components/Fonts.astro';
import '../styles/global.css';

const breadcrumbItems = [
  { label: 'Terms and Conditions' }
];

const lastUpdated = 'August 30, 2026';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <GoogleAnalytics />
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Terms and Conditions - InsureEstimate</title>
  <meta name="description" content="Read InsureEstimate's Terms and Conditions. Understand our non-binding actuarial estimation disclaimer, terms of use, and intellectual property guidelines.">
  <link rel="canonical" href="https://insureestimate.com/terms-and-conditions/" />
  <Fonts />
</head>
<body class="bg-canvas font-sans text-ink antialiased">
  <SiteHeader active="" />

  <main class="w-full pt-16">
    <div class="container-page pt-8">
      <Breadcrumbs items={breadcrumbItems} />

      <!-- HEADER CONTAINER -->
      <section class="mb-12 mt-8 border-b border-hairline pb-10">
        <div class="flex flex-col gap-3">
          <span class="eyebrow">Legal Framework</span>
          <h1 class="title-page">
            Terms and Conditions
          </h1>
          <p class="font-mono text-body-sm text-mute">
            Last Revised: {lastUpdated} | Terms of Platform Service
          </p>
        </div>
      </section>

      <!-- TERMS CONTENT BODY -->
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-[minmax(0,1fr)_240px] lg:gap-16">
      <div class="max-w-prose space-y-12 text-body-lg text-body [&_strong]:font-semibold [&_strong]:text-ink">
        
        <!-- SECTION 1: ACCEPTANCE OF TERMS -->
        <section id="section-1" class="scroll-mt-24 space-y-4">
          <h2 class="text-2xl font-semibold leading-8 tracking-[-0.9px] text-ink">
            1. Acceptance of Terms
          </h2>
          <p>
            Welcome to <strong>InsureEstimate</strong> ("Platform," "we," "us," or "our"). By accessing or using our website, interactive calculators, state rate indices, profession cost matrices, or related services (collectively, the "Services"), you agree to be bound by these Terms and Conditions ("Terms"). If you do not agree to all of these Terms, do not access or use the Services.
          </p>
        </section>

        <!-- SECTION 2: IMPORTANT NON-BINDING ESTIMATE DISCLAIMER -->
        <section id="section-2" class="scroll-mt-24 space-y-4 border-t border-hairline pt-12">
          <div class="space-y-3 rounded-xl border border-warning/40 bg-warning-soft/40 p-6">
            <div class="flex items-center gap-2 font-mono text-mono-eyebrow uppercase text-warning-deep">
              <span class="material-symbols-outlined text-[20px]">warning</span>
              Critical Educational & Non-Binding Quote Disclaimer
            </div>
            <h2 class="text-heading-md text-ink">
              2. InsureEstimate is Not an Insurance Agency or Carrier
            </h2>
            <p class="text-body-lg text-body">
              InsureEstimate is an independent data research and algorithmic calculation platform. <strong>InsureEstimate is NOT a licensed insurance broker, insurance agent, insurance carrier, or underwriting entity.</strong> We do not issue insurance policies, execute coverage binders, process insurance claims, or solicit insurance products on behalf of specific carriers.
            </p>
            <p class="text-body-lg text-body">
              All calculation outputs, monthly premium ranges, annual projections, and state averages generated by our Renters Insurance Calculator and Business Insurance Calculator are provided <strong>solely for informational, educational, and benchmarking purposes</strong>. They do NOT constitute formal insurance quotes, legal advice, financial advice, or binding contracts to provide insurance.
            </p>
          </div>
        </section>

        <!-- SECTION 3: CALCULATION METHODOLOGY & ACCURACY -->
        <section id="section-3" class="scroll-mt-24 space-y-4 border-t border-hairline pt-12">
          <h2 class="text-2xl font-semibold leading-8 tracking-[-0.9px] text-ink">
            3. Actuarial Calculation Methodology & Rate Variability
          </h2>
          <p>
            Our calculation engine estimates premium ranges using statutory department of insurance filings, regional loss ratios, industry risk multipliers, and standard actuarial formulas. However, actual premium quotes offered by licensed insurance carriers will vary based on carrier-specific underwriting criteria, including but not limited to:
          </p>
          <ul class="list-disc space-y-2 pl-5 marker:text-faint">
            <li>Specific building construction material, building age, fire protection class, and ZIP code micro-location.</li>
            <li>Individual applicant credit-based insurance scores, claims history, and prior coverage lapses.</li>
            <li>Specific business operations, endorsements, umbrella limits, and employee payroll verification.</li>
            <li>Carrier-specific rate filings, promotional discounts, and safety device credits.</li>
          </ul>
        </section>

        <!-- SECTION 4: INTELLECTUAL PROPERTY -->
        <section id="section-4" class="scroll-mt-24 space-y-4 border-t border-hairline pt-12">
          <h2 class="text-2xl font-semibold leading-8 tracking-[-0.9px] text-ink">
            4. Intellectual Property Rights
          </h2>
          <p>
            The Services and their original content, calculation algorithms, UI code, design elements, state database structures, brand elements ("InsureEstimate"), graphics, and text are owned by InsureEstimate and protected by United States and international copyright, trademark, and intellectual property laws.
          </p>
          <p>
            You are granted a limited, non-exclusive, non-transferable license to access and use the Platform for personal, non-commercial use. You may not scrape, reverse-engineer, mirror, re-publish, or commercially exploit any calculation logic or state data without prior written authorization.
          </p>
        </section>

        <!-- SECTION 5: PROHIBITED USES -->
        <section id="section-5" class="scroll-mt-24 space-y-4 border-t border-hairline pt-12">
          <h2 class="text-2xl font-semibold leading-8 tracking-[-0.9px] text-ink">
            5. Prohibited Conduct
          </h2>
          <p>You agree not to:</p>
          <ul class="list-disc space-y-2 pl-5 marker:text-faint">
            <li>Use the Services for any illegal purpose or in violation of any local, state, national, or international law.</li>
            <li>Attempt to probe, scan, or test the vulnerability of our system network or breach security authentication measures.</li>
            <li>Use automated scripts, bots, spiders, or crawlers to extract site data at rates that degrade platform performance.</li>
            <li>Submit false, misleading, or abusive information through our contact or feedback mechanisms.</li>
          </ul>
        </section>

        <!-- SECTION 6: LIMITATION OF LIABILITY -->
        <section id="section-6" class="scroll-mt-24 space-y-4 border-t border-hairline pt-12">
          <h2 class="text-2xl font-semibold leading-8 tracking-[-0.9px] text-ink">
            6. Limitation of Liability & Warranty Disclaimer
          </h2>
          <p>
            THE SERVICES ARE PROVIDED ON AN "AS IS" AND "AS AVAILABLE" BASIS WITHOUT WARRANTIES OF ANY KIND, EITHER EXPRESS OR IMPLIED. TO THE FULLEST EXTENT PERMISSIBLE UNDER APPLICABLE LAW, INSUREESTIMATE DISCLAIMS ALL WARRANTIES, EXPRESS OR IMPLIED, INCLUDING MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE.
          </p>
          <p>
            IN NO EVENT SHALL INSUREESTIMATE, ITS OFFICERS, DIRECTORS, EMPLOYEES, OR AGENTS BE LIABLE FOR ANY INDIRECT, INCIDENTAL, SPECIAL, CONSEQUENTIAL, OR PUNITIVE DAMAGES ARISING OUT OF OR IN CONNECTION WITH YOUR USE OF THE PLATFORM OR RELIANCE ON ANY ESTIMATED PREMIUM PROJECTION.
          </p>
        </section>

        <!-- SECTION 7: GOVERNING LAW -->
        <section id="section-7" class="scroll-mt-24 space-y-4 border-t border-hairline pt-12">
          <h2 class="text-2xl font-semibold leading-8 tracking-[-0.9px] text-ink">
            7. Governing Law & Contact
          </h2>
          <p>
            These Terms shall be governed by and construed in accordance with the laws of the State of Delaware, without regard to its conflict of law principles.
          </p>
          <p>
            If you have questions regarding these Terms and Conditions, please contact us at:
          </p>
          <div class="well space-y-1 p-6 text-body-md">
            <p class="font-medium text-ink">InsureEstimate Legal Department</p>
            <p class="text-body">Email: <a href="mailto:legal@insureestimate.com" class="link">legal@insureestimate.com</a></p>
          </div>
        </section>

      </div>

      <aside class="hidden lg:block">
        <nav class="sticky top-28 flex flex-col gap-3 border-l border-hairline pl-5 text-body-md" aria-label="On this page">
          <span class="text-label-sm text-ink">On this page</span>
          <a href="#section-1" class="link-quiet">1. Acceptance of Terms</a>
          <a href="#section-2" class="link-quiet">2. InsureEstimate is Not an Insurance Agency or Carrier</a>
          <a href="#section-3" class="link-quiet">3. Actuarial Calculation Methodology &amp; Rate Variability</a>
          <a href="#section-4" class="link-quiet">4. Intellectual Property Rights</a>
          <a href="#section-5" class="link-quiet">5. Prohibited Conduct</a>
          <a href="#section-6" class="link-quiet">6. Limitation of Liability &amp; Warranty Disclaimer</a>
          <a href="#section-7" class="link-quiet">7. Governing Law &amp; Contact</a>
        </nav>
      </aside>
      </div>
    </div>
  </main>

  <PageFooter />
</body>
</html>
