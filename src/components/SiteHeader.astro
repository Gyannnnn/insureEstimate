---
interface Props {
  active?: 'Renters Insurance' | 'Business Insurance' | 'Home' | string;
}

const { active = '' } = Astro.props;

const topStates = [
  { name: 'California', slug: 'california', code: 'CA' },
  { name: 'Texas', slug: 'texas', code: 'TX' },
  { name: 'Florida', slug: 'florida', code: 'FL' },
  { name: 'New York', slug: 'new-york', code: 'NY' },
  { name: 'Illinois', slug: 'illinois', code: 'IL' },
  { name: 'Georgia', slug: 'georgia', code: 'GA' },
  { name: 'Ohio', slug: 'ohio', code: 'OH' },
  { name: 'Pennsylvania', slug: 'pennsylvania', code: 'PA' },
  { name: 'North Carolina', slug: 'north-carolina', code: 'NC' },
  { name: 'Michigan', slug: 'michigan', code: 'MI' },
  { name: 'Washington', slug: 'washington', code: 'WA' },
  { name: 'Colorado', slug: 'colorado', code: 'CO' },
  { name: 'Arizona', slug: 'arizona', code: 'AZ' },
  { name: 'Massachusetts', slug: 'massachusetts', code: 'MA' },
  { name: 'Virginia', slug: 'virginia', code: 'VA' },
  { name: 'New Jersey', slug: 'new-jersey', code: 'NJ' },
  { name: 'Tennessee', slug: 'tennessee', code: 'TN' },
  { name: 'Indiana', slug: 'indiana', code: 'IN' },
  { name: 'Missouri', slug: 'missouri', code: 'MO' },
  { name: 'Maryland', slug: 'maryland', code: 'MD' },
];

const topProfessions = [
  { name: 'Freelance Photographer', slug: 'freelance-photographer', icon: 'photo_camera', tag: 'Creative' },
  { name: 'IT Consultant', slug: 'it-consultant', icon: 'computer', tag: 'Tech' },
  { name: 'General Contractor', slug: 'general-contractor', icon: 'construction', tag: 'Trades' },
  { name: 'Business Consultant', slug: 'business-consultant', icon: 'work', tag: 'Services' },
  { name: 'Electrician', slug: 'electrician', icon: 'bolt', tag: 'Trades' },
  { name: 'Graphic Designer', slug: 'graphic-designer', icon: 'palette', tag: 'Creative' },
  { name: 'Hair Stylist', slug: 'hair-stylist', icon: 'content_cut', tag: 'Personal' },
  { name: 'Cleaning Service', slug: 'cleaning-service-owner', icon: 'cleaning_services', tag: 'Trades' },
  { name: 'Landscaper', slug: 'landscaper', icon: 'yard', tag: 'Trades' },
  { name: 'Real Estate Agent', slug: 'real-estate-agent', icon: 'real_estate_agent', tag: 'Services' },
];
---

<header class="fixed top-0 w-full z-50 bg-white/90 backdrop-blur-xl border-b border-outline-variant/30 shadow-sm transition-all duration-300">
  <div class="h-16 max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop flex items-center justify-between gap-4">
    
    <!-- BRAND LOGO -->
    <a href="/" class="flex items-center gap-3 group shrink-0 focus:outline-none">
      <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-primary to-primary/80 flex items-center justify-center text-on-primary font-bold text-sm shadow-md group-hover:scale-105 transition-transform duration-300">
        IE
      </div>
      <div class="flex flex-col">
        <span class="font-headline-md text-base md:text-lg tracking-tight text-primary font-bold leading-none">InsureEstimate</span>
        <span class="text-[10px] text-on-surface-variant font-data-tabular leading-tight">Actuarial Intelligence</span>
      </div>
    </a>

    <!-- DESKTOP SHADCN-STYLE NAVIGATION MENU (CENTER) -->
    <nav aria-label="Main Navigation" class="hidden lg:flex items-center gap-1">
      
      <!-- HOME LINK -->
      <a 
        href="/" 
        class:list={[
          'px-4 py-2 rounded-lg text-sm font-medium transition-all flex items-center gap-1.5',
          active === 'Home' 
            ? 'bg-surface-container-high text-primary font-semibold' 
            : 'text-on-surface-variant hover:text-primary hover:bg-surface-container-low'
        ]}
      >
        <span class="material-symbols-outlined text-[18px]">home</span>
        <span>Home</span>
      </a>

      <!-- RENTERS INSURANCE MEGA MENU DROP-DOWN -->
      <div class="relative group/nav-renters py-3">
        <a 
          href="/renters-insurance-calculator/" 
          class:list={[
            'px-4 py-2 rounded-lg text-sm font-medium transition-all inline-flex items-center gap-1.5 cursor-pointer',
            active === 'Renters Insurance' 
              ? 'bg-surface-container-high text-primary font-semibold' 
              : 'text-on-surface-variant hover:text-primary hover:bg-surface-container-low'
          ]}
        >
          <span class="material-symbols-outlined text-[18px]">home_work</span>
          <span>Renters Insurance</span>
          <span class="material-symbols-outlined text-[16px] text-on-surface-variant group-hover/nav-renters:rotate-180 transition-transform duration-200">expand_more</span>
        </a>

        <!-- MEGA MENU PANEL -->
        <div class="absolute left-1/2 -translate-x-1/2 top-full w-[860px] opacity-0 invisible group-hover/nav-renters:opacity-100 group-hover/nav-renters:visible transition-all duration-200 ease-out translate-y-2 group-hover/nav-renters:translate-y-0 pointer-events-none group-hover/nav-renters:pointer-events-auto">
          <div class="bg-surface-container-lowest rounded-2xl border border-outline-variant/30 shadow-2xl p-5 grid grid-cols-[240px_1fr] gap-6 backdrop-blur-2xl">
            
            <!-- Featured Spotlight Column -->
            <div class="bg-surface-container-low p-4 rounded-xl border border-outline-variant/20 flex flex-col justify-between">
              <div class="flex flex-col gap-2">
                <span class="px-2 py-0.5 rounded-full bg-secondary/10 text-secondary text-[10px] font-label-sm font-bold uppercase tracking-wider w-max">
                  Residential Baseline
                </span>
                <h3 class="font-headline-md text-base font-bold text-primary">Renters Estimator</h3>
                <p class="text-xs text-on-surface-variant leading-relaxed">
                  Compare rates across all 50 US states modeled with local actuarial filing data.
                </p>
              </div>
              <a 
                href="/renters-insurance-calculator/" 
                class="mt-4 inline-flex items-center justify-between w-full p-2.5 bg-primary text-on-primary rounded-lg text-xs font-medium hover:bg-primary/90 transition-colors"
              >
                <span>National Index</span>
                <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
              </a>
            </div>

            <!-- States Directory Column (20 Popular States in 4-Column Grid) -->
            <div class="flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between pb-2 mb-3 border-b border-outline-variant/20">
                  <span class="text-xs font-semibold text-primary uppercase tracking-wider font-label-sm">Top State Estimators</span>
                  <span class="text-[11px] text-on-surface-variant font-data-tabular">20 Popular States</span>
                </div>
                <div class="grid grid-cols-4 gap-2">
                  {topStates.map((st) => (
                    <a 
                      href={`/renters-insurance-calculator/${st.slug}/`}
                      class="flex items-center justify-between p-1.5 px-2 rounded-lg bg-surface-container-lowest border border-outline-variant/20 hover:border-primary/40 hover:bg-surface-container-low transition-all group/st"
                    >
                      <span class="text-xs font-medium text-on-surface group-hover/st:text-primary transition-colors truncate">{st.name}</span>
                      <span class="text-[10px] font-data-tabular text-on-surface-variant/70 group-hover/st:text-primary ml-1 shrink-0">{st.code}</span>
                    </a>
                  ))}
                </div>
              </div>
              <a 
                href="/renters-insurance-calculator/#browse-states" 
                class="mega-scroll-link mt-3 pt-2.5 border-t border-outline-variant/20 flex items-center justify-between text-xs font-semibold text-primary hover:text-secondary transition-colors"
              >
                <span>View All 50 US States</span>
                <span class="material-symbols-outlined text-[16px]">chevron_right</span>
              </a>
            </div>

          </div>
        </div>
      </div>

      <!-- BUSINESS INSURANCE MEGA MENU DROP-DOWN -->
      <div class="relative group/nav-business py-3">
        <a 
          href="/business-insurance-calculator/" 
          class:list={[
            'px-4 py-2 rounded-lg text-sm font-medium transition-all inline-flex items-center gap-1.5 cursor-pointer',
            active === 'Business Insurance' 
              ? 'bg-surface-container-high text-primary font-semibold' 
              : 'text-on-surface-variant hover:text-primary hover:bg-surface-container-low'
          ]}
        >
          <span class="material-symbols-outlined text-[18px]">business_center</span>
          <span>Business Insurance</span>
          <span class="material-symbols-outlined text-[16px] text-on-surface-variant group-hover/nav-business:rotate-180 transition-transform duration-200">expand_more</span>
        </a>

        <!-- MEGA MENU PANEL -->
        <div class="absolute left-1/2 -translate-x-1/2 top-full w-[800px] opacity-0 invisible group-hover/nav-business:opacity-100 group-hover/nav-business:visible transition-all duration-200 ease-out translate-y-2 group-hover/nav-business:translate-y-0 pointer-events-none group-hover/nav-business:pointer-events-auto">
          <div class="bg-surface-container-lowest rounded-2xl border border-outline-variant/30 shadow-2xl p-5 grid grid-cols-[240px_1fr] gap-6 backdrop-blur-2xl">
            
            <!-- Featured Spotlight Column -->
            <div class="bg-surface-container-low p-4 rounded-xl border border-outline-variant/20 flex flex-col justify-between">
              <div class="flex flex-col gap-2">
                <span class="px-2 py-0.5 rounded-full bg-primary/10 text-primary text-[10px] font-label-sm font-bold uppercase tracking-wider w-max">
                  Commercial Models
                </span>
                <h3 class="font-headline-md text-base font-bold text-primary">Business Estimator</h3>
                <p class="text-xs text-on-surface-variant leading-relaxed">
                  Tailored General Liability &amp; E&amp;O cost projections for freelancers and small businesses.
                </p>
              </div>
              <a 
                href="/business-insurance-calculator/" 
                class="mt-4 inline-flex items-center justify-between w-full p-2.5 bg-primary text-on-primary rounded-lg text-xs font-medium hover:bg-primary/90 transition-colors"
              >
                <span>Profession Index</span>
                <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
              </a>
            </div>

            <!-- Professions Directory Column -->
            <div class="flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between pb-2 mb-3 border-b border-outline-variant/20">
                  <span class="text-xs font-semibold text-primary uppercase tracking-wider font-label-sm">Popular Business Profiles</span>
                  <span class="text-[11px] text-on-surface-variant font-data-tabular">35+ Industries</span>
                </div>
                <div class="grid grid-cols-2 gap-2">
                  {topProfessions.map((prof) => (
                    <a 
                      href={`/business-insurance-calculator/${prof.slug}/`}
                      class="flex items-center gap-2.5 p-2 rounded-lg bg-surface-container-lowest border border-outline-variant/20 hover:border-primary/40 hover:bg-surface-container-low transition-all group/prof"
                    >
                      <div class="w-7 h-7 rounded-md bg-primary/10 text-primary flex items-center justify-center shrink-0 group-hover/prof:bg-primary group-hover/prof:text-on-primary transition-colors">
                        <span class="material-symbols-outlined text-[16px]">{prof.icon}</span>
                      </div>
                      <div class="flex flex-col min-w-0">
                        <span class="text-xs font-medium text-on-surface group-hover/prof:text-primary transition-colors truncate">{prof.name}</span>
                        <span class="text-[10px] text-on-surface-variant/70 font-data-tabular">{prof.tag}</span>
                      </div>
                    </a>
                  ))}
                </div>
              </div>
              <a 
                href="/business-insurance-calculator/#profession-search-section" 
                class="mega-scroll-link mt-3 pt-2.5 border-t border-outline-variant/20 flex items-center justify-between text-xs font-semibold text-primary hover:text-secondary transition-colors"
              >
                <span>Explore All 35+ Profession Profiles</span>
                <span class="material-symbols-outlined text-[16px]">chevron_right</span>
              </a>
            </div>

          </div>
        </div>
      </div>

    </nav>

    <!-- RIGHT ACTION AREA -->
    <div class="hidden sm:flex items-center gap-3 shrink-0">
      <a 
        href="/renters-insurance-calculator" 
        class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-primary text-on-primary text-xs font-medium hover:bg-primary/90 transition-all shadow-sm hover:shadow-md hover:scale-[1.02] active:scale-[0.98]"
      >
        <span class="material-symbols-outlined text-[18px]">calculate</span>
        <span>Get Instant Estimate</span>
      </a>
    </div>

    <!-- MOBILE HAMBURGER BUTTON -->
    <div class="flex lg:hidden items-center gap-2">
      <button 
        id="mobile-menu-toggle"
        type="button" 
        class="w-10 h-10 flex items-center justify-center text-primary rounded-xl hover:bg-surface-container transition-colors focus:outline-none border border-outline-variant/30" 
        aria-label="Toggle Navigation Menu"
      >
        <span id="menu-icon-open" class="material-symbols-outlined text-[24px]">menu</span>
        <span id="menu-icon-close" class="material-symbols-outlined text-[24px] hidden">close</span>
      </button>
    </div>

  </div>

  <!-- MOBILE NAVIGATION DRAWER -->
  <div 
    id="mobile-menu" 
    class="hidden lg:hidden border-t border-outline-variant/30 bg-white/95 backdrop-blur-2xl px-margin-mobile py-5 flex-col gap-4 shadow-xl max-h-[85vh] overflow-y-auto"
  >
    <a 
      href="/" 
      class:list={[
        'p-3 rounded-xl font-medium text-sm flex items-center justify-between transition-colors',
        active === 'Home' ? 'bg-surface-container-high text-primary font-semibold' : 'text-on-surface hover:bg-surface-container-low'
      ]}
    >
      <div class="flex items-center gap-3">
        <span class="material-symbols-outlined text-primary text-[20px]">home</span>
        <span>Home</span>
      </div>
      <span class="material-symbols-outlined text-on-surface-variant text-[18px]">chevron_right</span>
    </a>

    <!-- Mobile Renters Section -->
    <div class="flex flex-col gap-2 p-3 bg-surface-container-low/50 rounded-xl border border-outline-variant/20">
      <a 
        href="/renters-insurance-calculator/#browse-states" 
        class="mega-scroll-link flex items-center justify-between font-semibold text-sm text-primary"
      >
        <div class="flex items-center gap-2.5">
          <span class="material-symbols-outlined text-primary text-[20px]">home_work</span>
          <span>Renters Insurance</span>
        </div>
        <span class="text-xs font-normal text-secondary font-data-tabular">All 50 States →</span>
      </a>
      <div class="grid grid-cols-2 gap-1.5 mt-2 pt-2 border-t border-outline-variant/20">
        {topStates.slice(0, 8).map((st) => (
          <a 
            href={`/renters-insurance-calculator/${st.slug}/`}
            class="text-xs text-on-surface-variant hover:text-primary py-1 px-2 rounded bg-surface-container-lowest border border-outline-variant/20 flex items-center justify-between"
          >
            <span class="truncate">{st.name}</span>
            <span class="text-[10px] text-on-surface-variant/60 font-data-tabular ml-1">{st.code}</span>
          </a>
        ))}
      </div>
    </div>

    <!-- Mobile Business Section -->
    <div class="flex flex-col gap-2 p-3 bg-surface-container-low/50 rounded-xl border border-outline-variant/20">
      <a 
        href="/business-insurance-calculator/#profession-search-section" 
        class="mega-scroll-link flex items-center justify-between font-semibold text-sm text-primary"
      >
        <div class="flex items-center gap-2.5">
          <span class="material-symbols-outlined text-primary text-[20px]">business_center</span>
          <span>Business Insurance</span>
        </div>
        <span class="text-xs font-normal text-secondary font-data-tabular">35+ Profiles →</span>
      </a>
      <div class="grid grid-cols-1 gap-1.5 mt-2 pt-2 border-t border-outline-variant/20">
        {topProfessions.slice(0, 4).map((prof) => (
          <a 
            href={`/business-insurance-calculator/${prof.slug}/`}
            class="text-xs text-on-surface-variant hover:text-primary py-1.5 px-2 rounded bg-surface-container-lowest border border-outline-variant/20 flex items-center gap-2"
          >
            <span class="material-symbols-outlined text-[16px] text-primary">{prof.icon}</span>
            <span>{prof.name}</span>
          </a>
        ))}
      </div>
    </div>

    <!-- Mobile CTA -->
    <div class="pt-2">
      <a 
        href="/renters-insurance-calculator/#calculator" 
        class="flex items-center justify-center gap-2 w-full py-3 bg-primary text-on-primary font-medium text-sm rounded-xl shadow-md"
      >
        <span class="material-symbols-outlined text-[18px]">calculate</span>
        <span>Get Instant Estimate</span>
      </a>
    </div>
  </div>
</header>

<script>
  // Mobile drawer toggle
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  if (toggleBtn && menu && iconOpen && iconClose) {
    toggleBtn.addEventListener('click', () => {
      const isHidden = menu.classList.contains('hidden');
      if (isHidden) {
        menu.classList.remove('hidden');
        menu.classList.add('flex');
        iconOpen.classList.add('hidden');
        iconClose.classList.remove('hidden');
      } else {
        menu.classList.add('hidden');
        menu.classList.remove('flex');
        iconOpen.classList.remove('hidden');
        iconClose.classList.add('hidden');
      }
    });
  }

  // Smooth scroll handler for anchor links
  document.querySelectorAll('.mega-scroll-link').forEach((link) => {
    link.addEventListener('click', (e) => {
      const href = link.getAttribute('href');
      if (!href) return;
      
      const url = new URL(href, window.location.href);
      if (url.pathname === window.location.pathname && url.hash) {
        e.preventDefault();
        const targetEl = document.querySelector(url.hash);
        if (targetEl) {
          targetEl.scrollIntoView({ behavior: 'smooth' });
          // Close mobile menu if open
          if (menu && !menu.classList.contains('hidden')) {
            menu.classList.add('hidden');
            menu.classList.remove('flex');
            iconOpen?.classList.remove('hidden');
            iconClose?.classList.add('hidden');
          }
        }
      }
    });
  });
</script>
