---
interface Props {
  active?: 'Renters Insurance' | 'Business Insurance' | 'Home' | string;
}

const { active = '' } = Astro.props;

const topStates = [
  { name: 'California', slug: 'california', code: 'CA' },
  { name: 'Texas', slug: 'texas', code: 'TX' },
  { name: 'Florida', slug: 'florida', code: 'FL' },
  { name: 'New York', slug: 'new-york', code: 'NY' },
  { name: 'Illinois', slug: 'illinois', code: 'IL' },
  { name: 'Georgia', slug: 'georgia', code: 'GA' },
  { name: 'Ohio', slug: 'ohio', code: 'OH' },
  { name: 'Pennsylvania', slug: 'pennsylvania', code: 'PA' },
  { name: 'North Carolina', slug: 'north-carolina', code: 'NC' },
  { name: 'Michigan', slug: 'michigan', code: 'MI' },
  { name: 'Washington', slug: 'washington', code: 'WA' },
  { name: 'Colorado', slug: 'colorado', code: 'CO' },
  { name: 'Arizona', slug: 'arizona', code: 'AZ' },
  { name: 'Massachusetts', slug: 'massachusetts', code: 'MA' },
  { name: 'Virginia', slug: 'virginia', code: 'VA' },
  { name: 'New Jersey', slug: 'new-jersey', code: 'NJ' },
  { name: 'Tennessee', slug: 'tennessee', code: 'TN' },
  { name: 'Indiana', slug: 'indiana', code: 'IN' },
  { name: 'Missouri', slug: 'missouri', code: 'MO' },
  { name: 'Maryland', slug: 'maryland', code: 'MD' },
];

const topProfessions = [
  { name: 'Freelance Photographer', slug: 'freelance-photographer', icon: 'photo_camera', tag: 'Creative' },
  { name: 'IT Consultant', slug: 'it-consultant', icon: 'computer', tag: 'Tech' },
  { name: 'General Contractor', slug: 'general-contractor', icon: 'construction', tag: 'Trades' },
  { name: 'Business Consultant', slug: 'business-consultant', icon: 'work', tag: 'Services' },
  { name: 'Electrician', slug: 'electrician', icon: 'bolt', tag: 'Trades' },
  { name: 'Graphic Designer', slug: 'graphic-designer', icon: 'palette', tag: 'Creative' },
  { name: 'Hair Stylist', slug: 'hair-stylist', icon: 'content_cut', tag: 'Personal' },
  { name: 'Cleaning Service', slug: 'cleaning-service-owner', icon: 'cleaning_services', tag: 'Trades' },
  { name: 'Landscaper', slug: 'landscaper', icon: 'yard', tag: 'Trades' },
  { name: 'Real Estate Agent', slug: 'real-estate-agent', icon: 'real_estate_agent', tag: 'Services' },
];
---

<!-- Import Google Font for Brand Logo -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet">

<header class="fixed top-0 w-full z-50 bg-white/90 backdrop-blur-xl border-b border-slate-200/80 shadow-[0_4px_20px_-4px_rgba(0,0,0,0.03)] transition-all duration-300">
  <!-- Subtle Top Emerald Accent Line -->
  <div class="h-[2px] w-full bg-gradient-to-r from-emerald-500/0 via-emerald-600/60 to-emerald-500/0"></div>

  <div class="h-16 max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop flex items-center justify-between gap-4">
    
    <!-- BRAND LOGO: InsureEstimate -->
    <a href="/" class="flex items-center gap-2.5 group shrink-0 focus:outline-none py-1">
      <!-- Professional Typography Logo -->
      <div class="flex items-center font-['Plus_Jakarta_Sans',sans-serif]">
        <span class="text-xl md:text-2xl font-bold tracking-tight text-slate-900">Insure</span>
        <span class="text-xl md:text-2xl font-extrabold tracking-tight text-emerald-700">Estimate</span>
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 inline-block ml-0.5 self-baseline mb-1"></span>
      </div>
    </a>

    <!-- DESKTOP NAVIGATION MENU (CENTER) -->
    <nav aria-label="Main Navigation" class="hidden lg:flex items-center gap-1.5">
      
      <!-- HOME LINK -->
      <a 
        href="/" 
        class:list={[
          'px-4 py-2 rounded-xl text-sm font-medium transition-all flex items-center gap-2',
          active === 'Home' 
            ? 'bg-emerald-50/80 text-emerald-900 font-semibold border border-emerald-200/60 shadow-xs' 
            : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100/70'
        ]}
      >
        <span class="material-symbols-outlined text-[18px] text-slate-500">home</span>
        <span>Home</span>
      </a>

      <!-- RENTERS INSURANCE MEGA MENU DROP-DOWN -->
      <div class="relative group/nav-renters py-3">
        <a 
          href="/renters-insurance-calculator/" 
          class:list={[
            'px-4 py-2 rounded-xl text-sm font-medium transition-all inline-flex items-center gap-2 cursor-pointer',
            active === 'Renters Insurance' 
              ? 'bg-emerald-50/80 text-emerald-900 font-semibold border border-emerald-200/60 shadow-xs' 
              : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100/70'
          ]}
        >
          <span class="material-symbols-outlined text-[18px] text-slate-500">home_work</span>
          <span>Renters Insurance</span>
          <span class="material-symbols-outlined text-[16px] text-slate-400 group-hover/nav-renters:rotate-180 group-hover/nav-renters:text-emerald-700 transition-transform duration-200">expand_more</span>
        </a>

        <!-- MEGA MENU PANEL -->
        <div class="absolute left-1/2 -translate-x-1/2 top-full w-[860px] opacity-0 invisible group-hover/nav-renters:opacity-100 group-hover/nav-renters:visible transition-all duration-200 ease-out translate-y-2 group-hover/nav-renters:translate-y-0 pointer-events-none group-hover/nav-renters:pointer-events-auto">
          <div class="bg-white/95 rounded-2xl border border-slate-200/90 shadow-2xl p-5 grid grid-cols-[240px_1fr] gap-6 backdrop-blur-2xl">
            
            <!-- Featured Spotlight Column -->
            <div class="bg-gradient-to-br from-emerald-50/60 via-slate-50 to-white p-4 rounded-xl border border-emerald-100 flex flex-col justify-between">
              <div class="flex flex-col gap-2">
                <span class="px-2.5 py-0.5 rounded-full bg-emerald-100/80 text-emerald-800 text-[10px] font-semibold uppercase tracking-wider w-max border border-emerald-200/60">
                  Residential Baseline
                </span>
                <h3 class="font-headline-md text-base font-bold text-slate-900">Renters Estimator</h3>
                <p class="text-xs text-slate-600 leading-relaxed">
                  Compare rates across all 50 US states modeled with localized actuarial filing data.
                </p>
              </div>
              <a 
                href="/renters-insurance-calculator/" 
                class="mt-4 inline-flex items-center justify-between w-full p-2.5 bg-slate-900 text-white rounded-lg text-xs font-semibold hover:bg-slate-800 transition-colors shadow-sm"
              >
                <span>National Index</span>
                <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
              </a>
            </div>

            <!-- States Directory Column (20 Popular States in 4-Column Grid) -->
            <div class="flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between pb-2 mb-3 border-b border-slate-100">
                  <span class="text-xs font-bold text-slate-900 uppercase tracking-wider font-label-sm">Top State Estimators</span>
                  <span class="text-[11px] text-slate-500 font-data-tabular">20 Popular States</span>
                </div>
                <div class="grid grid-cols-4 gap-2">
                  {topStates.map((st) => (
                    <a 
                      href={`/renters-insurance-calculator/${st.slug}/`}
                      class="flex items-center justify-between p-1.5 px-2 rounded-lg bg-slate-50/60 border border-slate-200/60 hover:border-emerald-500/50 hover:bg-emerald-50/40 transition-all group/st"
                    >
                      <span class="text-xs font-medium text-slate-700 group-hover/st:text-emerald-800 transition-colors truncate">{st.name}</span>
                      <span class="text-[10px] font-data-tabular text-slate-400 group-hover/st:text-emerald-700 ml-1 shrink-0">{st.code}</span>
                    </a>
                  ))}
                </div>
              </div>
              <a 
                href="/renters-insurance-calculator/#browse-states" 
                class="mega-scroll-link mt-3 pt-2.5 border-t border-slate-100 flex items-center justify-between text-xs font-bold text-emerald-700 hover:text-emerald-800 transition-colors"
              >
                <span>View All 50 US States</span>
                <span class="material-symbols-outlined text-[16px]">chevron_right</span>
              </a>
            </div>

          </div>
        </div>
      </div>

      <!-- BUSINESS INSURANCE MEGA MENU DROP-DOWN -->
      <div class="relative group/nav-business py-3">
        <a 
          href="/business-insurance-calculator/" 
          class:list={[
            'px-4 py-2 rounded-xl text-sm font-medium transition-all inline-flex items-center gap-2 cursor-pointer',
            active === 'Business Insurance' 
              ? 'bg-emerald-50/80 text-emerald-900 font-semibold border border-emerald-200/60 shadow-xs' 
              : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100/70'
          ]}
        >
          <span class="material-symbols-outlined text-[18px] text-slate-500">business_center</span>
          <span>Business Insurance</span>
          <span class="material-symbols-outlined text-[16px] text-slate-400 group-hover/nav-business:rotate-180 group-hover/nav-business:text-emerald-700 transition-transform duration-200">expand_more</span>
        </a>

        <!-- MEGA MENU PANEL -->
        <div class="absolute left-1/2 -translate-x-1/2 top-full w-[800px] opacity-0 invisible group-hover/nav-business:opacity-100 group-hover/nav-business:visible transition-all duration-200 ease-out translate-y-2 group-hover/nav-business:translate-y-0 pointer-events-none group-hover/nav-business:pointer-events-auto">
          <div class="bg-white/95 rounded-2xl border border-slate-200/90 shadow-2xl p-5 grid grid-cols-[240px_1fr] gap-6 backdrop-blur-2xl">
            
            <!-- Featured Spotlight Column -->
            <div class="bg-gradient-to-br from-emerald-50/60 via-slate-50 to-white p-4 rounded-xl border border-emerald-100 flex flex-col justify-between">
              <div class="flex flex-col gap-2">
                <span class="px-2.5 py-0.5 rounded-full bg-emerald-100/80 text-emerald-800 text-[10px] font-semibold uppercase tracking-wider w-max border border-emerald-200/60">
                  Commercial Models
                </span>
                <h3 class="font-headline-md text-base font-bold text-slate-900">Business Estimator</h3>
                <p class="text-xs text-slate-600 leading-relaxed">
                  Tailored General Liability &amp; E&amp;O cost projections for freelancers and small businesses.
                </p>
              </div>
              <a 
                href="/business-insurance-calculator/" 
                class="mt-4 inline-flex items-center justify-between w-full p-2.5 bg-slate-900 text-white rounded-lg text-xs font-semibold hover:bg-slate-800 transition-colors shadow-sm"
              >
                <span>Profession Index</span>
                <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
              </a>
            </div>

            <!-- Professions Directory Column -->
            <div class="flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between pb-2 mb-3 border-b border-slate-100">
                  <span class="text-xs font-bold text-slate-900 uppercase tracking-wider font-label-sm">Popular Business Profiles</span>
                  <span class="text-[11px] text-slate-500 font-data-tabular">35+ Industries</span>
                </div>
                <div class="grid grid-cols-2 gap-2">
                  {topProfessions.map((prof) => (
                    <a 
                      href={`/business-insurance-calculator/${prof.slug}/`}
                      class="flex items-center gap-2.5 p-2 rounded-lg bg-slate-50/60 border border-slate-200/60 hover:border-emerald-500/50 hover:bg-emerald-50/40 transition-all group/prof"
                    >
                      <div class="w-7 h-7 rounded-md bg-emerald-100/80 text-emerald-800 flex items-center justify-center shrink-0 group-hover/prof:bg-emerald-700 group-hover/prof:text-white transition-colors">
                        <span class="material-symbols-outlined text-[16px]">{prof.icon}</span>
                      </div>
                      <div class="flex flex-col min-w-0">
                        <span class="text-xs font-medium text-slate-700 group-hover/prof:text-emerald-900 transition-colors truncate">{prof.name}</span>
                        <span class="text-[10px] text-slate-400 font-data-tabular">{prof.tag}</span>
                      </div>
                    </a>
                  ))}
                </div>
              </div>
              <a 
                href="/business-insurance-calculator/#profession-search-section" 
                class="mega-scroll-link mt-3 pt-2.5 border-t border-slate-100 flex items-center justify-between text-xs font-bold text-emerald-700 hover:text-emerald-800 transition-colors"
              >
                <span>Explore All 35+ Profession Profiles</span>
                <span class="material-symbols-outlined text-[16px]">chevron_right</span>
              </a>
            </div>

          </div>
        </div>
      </div>

    </nav>

    <!-- RIGHT ACTION AREA -->
    <div class="hidden sm:flex items-center gap-3 shrink-0">
      <a 
        href="/renters-insurance-calculator" 
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-slate-900 text-white text-xs font-semibold hover:bg-slate-800 transition-all shadow-sm hover:shadow-md border border-slate-800 group"
      >
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span class="material-symbols-outlined text-[18px] text-slate-300 group-hover:text-white transition-colors">calculate</span>
        <span>Get Instant Estimate</span>
      </a>
    </div>

    <!-- MOBILE HAMBURGER BUTTON -->
    <div class="flex lg:hidden items-center gap-2">
      <button 
        id="mobile-menu-toggle"
        type="button" 
        class="w-10 h-10 flex items-center justify-center text-slate-900 rounded-xl hover:bg-slate-100 transition-colors focus:outline-none border border-slate-200" 
        aria-label="Toggle Navigation Menu"
      >
        <span id="menu-icon-open" class="material-symbols-outlined text-[24px]">menu</span>
        <span id="menu-icon-close" class="material-symbols-outlined text-[24px] hidden">close</span>
      </button>
    </div>

  </div>

  <!-- MOBILE NAVIGATION DRAWER -->
  <div 
    id="mobile-menu" 
    class="hidden lg:hidden border-t border-slate-200 bg-white/95 backdrop-blur-2xl px-margin-mobile py-5 flex-col gap-4 shadow-xl max-h-[85vh] overflow-y-auto"
  >
    <a 
      href="/" 
      class:list={[
        'p-3 rounded-xl font-medium text-sm flex items-center justify-between transition-colors',
        active === 'Home' ? 'bg-emerald-50 text-emerald-900 font-semibold border border-emerald-200' : 'text-slate-700 hover:bg-slate-50'
      ]}
    >
      <div class="flex items-center gap-3">
        <span class="material-symbols-outlined text-slate-500 text-[20px]">home</span>
        <span>Home</span>
      </div>
      <span class="material-symbols-outlined text-slate-400 text-[18px]">chevron_right</span>
    </a>

    <!-- Mobile Renters Section -->
    <div class="flex flex-col gap-2 p-3.5 bg-slate-50 rounded-xl border border-slate-200/80">
      <a 
        href="/renters-insurance-calculator/#browse-states" 
        class="mega-scroll-link flex items-center justify-between font-bold text-sm text-slate-900"
      >
        <div class="flex items-center gap-2.5">
          <span class="material-symbols-outlined text-emerald-700 text-[20px]">home_work</span>
          <span>Renters Insurance</span>
        </div>
        <span class="text-xs font-semibold text-emerald-700 font-data-tabular">All 50 States →</span>
      </a>
      <div class="grid grid-cols-2 gap-1.5 mt-2 pt-2.5 border-t border-slate-200/60">
        {topStates.slice(0, 8).map((st) => (
          <a 
            href={`/renters-insurance-calculator/${st.slug}/`}
            class="text-xs text-slate-700 hover:text-emerald-800 py-1 px-2 rounded bg-white border border-slate-200/80 flex items-center justify-between"
          >
            <span class="truncate">{st.name}</span>
            <span class="text-[10px] text-slate-400 font-data-tabular ml-1">{st.code}</span>
          </a>
        ))}
      </div>
    </div>

    <!-- Mobile Business Section -->
    <div class="flex flex-col gap-2 p-3.5 bg-slate-50 rounded-xl border border-slate-200/80">
      <a 
        href="/business-insurance-calculator/#profession-search-section" 
        class="mega-scroll-link flex items-center justify-between font-bold text-sm text-slate-900"
      >
        <div class="flex items-center gap-2.5">
          <span class="material-symbols-outlined text-emerald-700 text-[20px]">business_center</span>
          <span>Business Insurance</span>
        </div>
        <span class="text-xs font-semibold text-emerald-700 font-data-tabular">35+ Profiles →</span>
      </a>
      <div class="grid grid-cols-1 gap-1.5 mt-2 pt-2.5 border-t border-slate-200/60">
        {topProfessions.slice(0, 4).map((prof) => (
          <a 
            href={`/business-insurance-calculator/${prof.slug}/`}
            class="text-xs text-slate-700 hover:text-emerald-800 py-1.5 px-2 rounded bg-white border border-slate-200/80 flex items-center gap-2"
          >
            <span class="material-symbols-outlined text-[16px] text-emerald-700">{prof.icon}</span>
            <span>{prof.name}</span>
          </a>
        ))}
      </div>
    </div>

    <!-- Mobile CTA -->
    <div class="pt-2">
      <a 
        href="/renters-insurance-calculator/#calculator" 
        class="flex items-center justify-center gap-2 w-full py-3 bg-slate-900 text-white font-semibold text-sm rounded-xl shadow-md border border-slate-800"
      >
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span class="material-symbols-outlined text-[18px]">calculate</span>
        <span>Get Instant Estimate</span>
      </a>
    </div>
  </div>
</header>

<script>
  // Mobile drawer toggle
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  if (toggleBtn && menu && iconOpen && iconClose) {
    toggleBtn.addEventListener('click', () => {
      const isHidden = menu.classList.contains('hidden');
      if (isHidden) {
        menu.classList.remove('hidden');
        menu.classList.add('flex');
        iconOpen.classList.add('hidden');
        iconClose.classList.remove('hidden');
      } else {
        menu.classList.add('hidden');
        menu.classList.remove('flex');
        iconOpen.classList.remove('hidden');
        iconClose.classList.add('hidden');
      }
    });
  }

  // Smooth scroll handler for anchor links
  document.querySelectorAll('.mega-scroll-link').forEach((link) => {
    link.addEventListener('click', (e) => {
      const href = link.getAttribute('href');
      if (!href) return;
      
      const url = new URL(href, window.location.href);
      if (url.pathname === window.location.pathname && url.hash) {
        e.preventDefault();
        const targetEl = document.querySelector(url.hash);
        if (targetEl) {
          targetEl.scrollIntoView({ behavior: 'smooth' });
          // Close mobile menu if open
          if (menu && !menu.classList.contains('hidden')) {
            menu.classList.add('hidden');
            menu.classList.remove('flex');
            iconOpen?.classList.remove('hidden');
            iconClose?.classList.add('hidden');
          }
        }
      }
    });
  });
</script>
