---
interface Props {
  active?: 'Renters Insurance' | 'Business Insurance' | 'Home' | string;
}

const { active = '' } = Astro.props;

const topStates = [
  { name: 'California', slug: 'california', code: 'CA' },
  { name: 'Texas', slug: 'texas', code: 'TX' },
  { name: 'Florida', slug: 'florida', code: 'FL' },
  { name: 'New York', slug: 'new-york', code: 'NY' },
  { name: 'Illinois', slug: 'illinois', code: 'IL' },
  { name: 'Georgia', slug: 'georgia', code: 'GA' },
  { name: 'Ohio', slug: 'ohio', code: 'OH' },
  { name: 'Pennsylvania', slug: 'pennsylvania', code: 'PA' },
  { name: 'North Carolina', slug: 'north-carolina', code: 'NC' },
  { name: 'Michigan', slug: 'michigan', code: 'MI' },
  { name: 'Washington', slug: 'washington', code: 'WA' },
  { name: 'Colorado', slug: 'colorado', code: 'CO' },
  { name: 'Arizona', slug: 'arizona', code: 'AZ' },
  { name: 'Massachusetts', slug: 'massachusetts', code: 'MA' },
  { name: 'Virginia', slug: 'virginia', code: 'VA' },
  { name: 'New Jersey', slug: 'new-jersey', code: 'NJ' },
  { name: 'Tennessee', slug: 'tennessee', code: 'TN' },
  { name: 'Indiana', slug: 'indiana', code: 'IN' },
  { name: 'Missouri', slug: 'missouri', code: 'MO' },
  { name: 'Maryland', slug: 'maryland', code: 'MD' },
];

const topProfessions = [
  { name: 'Freelance Photographer', slug: 'freelance-photographer', icon: 'photo_camera', tag: 'Creative' },
  { name: 'IT Consultant', slug: 'it-consultant', icon: 'computer', tag: 'Tech' },
  { name: 'General Contractor', slug: 'general-contractor', icon: 'construction', tag: 'Trades' },
  { name: 'Business Consultant', slug: 'business-consultant', icon: 'work', tag: 'Services' },
  { name: 'Electrician', slug: 'electrician', icon: 'bolt', tag: 'Trades' },
  { name: 'Graphic Designer', slug: 'graphic-designer', icon: 'palette', tag: 'Creative' },
  { name: 'Hair Stylist', slug: 'hair-stylist', icon: 'content_cut', tag: 'Personal' },
  { name: 'Cleaning Service', slug: 'cleaning-service-owner', icon: 'cleaning_services', tag: 'Trades' },
  { name: 'Landscaper', slug: 'landscaper', icon: 'yard', tag: 'Trades' },
  { name: 'Real Estate Agent', slug: 'real-estate-agent', icon: 'real_estate_agent', tag: 'Services' },
];

const navLink = (isActive: boolean) => [
  'inline-flex h-8 items-center gap-1 rounded-full px-3 text-body-md transition-colors',
  isActive ? 'bg-hairline-soft font-medium text-ink' : 'text-body hover:bg-hairline-soft hover:text-ink',
];
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-hairline bg-canvas/80 backdrop-blur-md supports-[backdrop-filter]:bg-canvas/70">
  <div class="container-page flex h-16 items-center justify-between gap-4">

    <!-- Wordmark -->
    <a href="/" class="flex shrink-0 items-center rounded-md py-1" aria-label="InsureEstimate home">
      <span class="text-[20px] font-semibold leading-none tracking-[-0.6px] text-ink">Insure</span>
      <span class="text-[20px] font-semibold leading-none tracking-[-0.6px] text-brand-ink">Estimate</span>
      <span class="mb-0.5 ml-0.5 inline-block h-1.5 w-1.5 self-end rounded-full bg-brand" aria-hidden="true"></span>
    </a>

    <!-- Desktop navigation -->
    <nav aria-label="Main Navigation" class="hidden items-center gap-1 lg:flex">
      <a href="/" class:list={navLink(active === 'Home')} aria-current={active === 'Home' ? 'page' : undefined}>Home</a>

      <!-- Renters mega menu -->
      <div class="group/nav-renters relative py-3">
        <a
          href="/renters-insurance-calculator/"
          class:list={navLink(active === 'Renters Insurance')}
          aria-haspopup="true"
          aria-current={active === 'Renters Insurance' ? 'page' : undefined}
        >
          Renters Insurance
          <span class="material-symbols-outlined text-[18px] text-mute transition-transform duration-200 group-hover/nav-renters:rotate-180 group-focus-within/nav-renters:rotate-180">expand_more</span>
        </a>

        <div class="pointer-events-none invisible absolute left-1/2 top-full w-[820px] -translate-x-1/2 translate-y-1 opacity-0 transition duration-150 ease-out group-hover/nav-renters:pointer-events-auto group-hover/nav-renters:visible group-hover/nav-renters:translate-y-0 group-hover/nav-renters:opacity-100 group-focus-within/nav-renters:pointer-events-auto group-focus-within/nav-renters:visible group-focus-within/nav-renters:translate-y-0 group-focus-within/nav-renters:opacity-100">
          <div class="grid grid-cols-[232px_1fr] gap-2 rounded-xl border border-hairline bg-elevated p-2 shadow-2xl">
            <div class="flex flex-col justify-between rounded-lg bg-canvas p-5">
              <div class="flex flex-col gap-2">
                <span class="eyebrow">Residential baseline</span>
                <h3 class="text-heading-md text-ink">Renters Estimator</h3>
                <p class="text-body-md text-body">
                  Compare rates across all 50 US states modeled with localized actuarial filing data.
                </p>
              </div>
              <a href="/renters-insurance-calculator/" class="btn-sm mt-6 w-full justify-between">
                <span>National Index</span>
                <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
              </a>
            </div>

            <div class="flex flex-col justify-between p-3">
              <div>
                <div class="mb-2 flex items-center justify-between px-2">
                  <span class="text-label-sm text-ink">Top State Estimators</span>
                  <span class="font-mono text-body-sm text-mute">20 popular states</span>
                </div>
                <div class="grid grid-cols-4 gap-0.5">
                  {topStates.map((st) => (
                    <a
                      href={`/renters-insurance-calculator/${st.slug}/`}
                      class="flex items-center rounded-md px-2 py-1.5 text-body-md text-body transition-colors hover:bg-hairline-soft hover:text-ink"
                    >
                      <span class="truncate">{st.name}</span>
                    </a>
                  ))}
                </div>
              </div>
              <a
                href="/renters-insurance-calculator/#browse-states"
                class="mega-scroll-link mt-3 flex items-center justify-between rounded-md border-t border-hairline px-2 pt-3 text-body-md font-medium text-ink hover:text-brand-ink"
              >
                <span>View All 50 US States</span>
                <span class="material-symbols-outlined text-[18px]">chevron_right</span>
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Business mega menu -->
      <div class="group/nav-business relative py-3">
        <a
          href="/business-insurance-calculator/"
          class:list={navLink(active === 'Business Insurance')}
          aria-haspopup="true"
          aria-current={active === 'Business Insurance' ? 'page' : undefined}
        >
          Business Insurance
          <span class="material-symbols-outlined text-[18px] text-mute transition-transform duration-200 group-hover/nav-business:rotate-180 group-focus-within/nav-business:rotate-180">expand_more</span>
        </a>

        <div class="pointer-events-none invisible absolute left-1/2 top-full w-[760px] -translate-x-1/2 translate-y-1 opacity-0 transition duration-150 ease-out group-hover/nav-business:pointer-events-auto group-hover/nav-business:visible group-hover/nav-business:translate-y-0 group-hover/nav-business:opacity-100 group-focus-within/nav-business:pointer-events-auto group-focus-within/nav-business:visible group-focus-within/nav-business:translate-y-0 group-focus-within/nav-business:opacity-100">
          <div class="grid grid-cols-[232px_1fr] gap-2 rounded-xl border border-hairline bg-elevated p-2 shadow-2xl">
            <div class="flex flex-col justify-between rounded-lg bg-canvas p-5">
              <div class="flex flex-col gap-2">
                <span class="eyebrow">Commercial models</span>
                <h3 class="text-heading-md text-ink">Business Estimator</h3>
                <p class="text-body-md text-body">
                  Tailored General Liability &amp; E&amp;O cost projections for freelancers and small businesses.
                </p>
              </div>
              <a href="/business-insurance-calculator/" class="btn-sm mt-6 w-full justify-between">
                <span>Profession Index</span>
                <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
              </a>
            </div>

            <div class="flex flex-col justify-between p-3">
              <div>
                <div class="mb-2 flex items-center justify-between px-2">
                  <span class="text-label-sm text-ink">Popular Business Profiles</span>
                  <span class="font-mono text-body-sm text-mute">35+ industries</span>
                </div>
                <div class="grid grid-cols-2 gap-0.5">
                  {topProfessions.map((prof) => (
                    <a
                      href={`/business-insurance-calculator/${prof.slug}/`}
                      class="group/prof flex items-center gap-3 rounded-md px-2 py-1.5 transition-colors hover:bg-hairline-soft"
                    >
                      <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-md border border-hairline bg-elevated text-body group-hover/prof:text-ink">
                        <span class="material-symbols-outlined text-[18px]">{prof.icon}</span>
                      </span>
                      <span class="flex min-w-0 flex-col">
                        <span class="truncate text-body-md font-medium text-ink">{prof.name}</span>
                        <span class="text-body-sm text-mute">{prof.tag}</span>
                      </span>
                    </a>
                  ))}
                </div>
              </div>
              <a
                href="/business-insurance-calculator/#profession-search-section"
                class="mega-scroll-link mt-3 flex items-center justify-between rounded-md border-t border-hairline px-2 pt-3 text-body-md font-medium text-ink hover:text-brand-ink"
              >
                <span>Explore All 35+ Profession Profiles</span>
                <span class="material-symbols-outlined text-[18px]">chevron_right</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </nav>

    <!-- Right actions -->
    <div class="flex items-center gap-2">
      <a href="/renters-insurance-calculator" class="btn-sm hidden sm:inline-flex">
        Get Instant Estimate
      </a>

      <button
        id="mobile-menu-toggle"
        type="button"
        class="flex h-9 w-9 items-center justify-center rounded-md border border-hairline bg-elevated text-ink transition-colors hover:bg-hairline-soft lg:hidden"
        aria-label="Toggle Navigation Menu"
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <span id="menu-icon-open" class="material-symbols-outlined text-[20px]">menu</span>
        <span id="menu-icon-close" class="material-symbols-outlined hidden text-[20px]">close</span>
      </button>
    </div>
  </div>

  <!-- Mobile navigation drawer -->
  <div
    id="mobile-menu"
    class="hidden max-h-[calc(100dvh-4rem)] flex-col gap-6 overflow-y-auto border-t border-hairline bg-canvas px-4 pb-6 pt-4 sm:px-6 lg:hidden"
  >
    <a
      href="/"
      class:list={[
        'flex items-center justify-between rounded-lg px-3 py-2.5 text-body-lg font-medium',
        active === 'Home' ? 'bg-hairline-soft text-ink' : 'text-ink hover:bg-hairline-soft',
      ]}
    >
      <span>Home</span>
      <span class="material-symbols-outlined text-[20px] text-mute">chevron_right</span>
    </a>

    <div class="flex flex-col gap-3">
      <a
        href="/renters-insurance-calculator/#browse-states"
        class="mega-scroll-link flex items-center justify-between px-3 text-body-lg font-medium text-ink"
      >
        <span>Renters Insurance</span>
        <span class="font-mono text-body-sm text-mute">All 50 states</span>
      </a>
      <div class="grid grid-cols-2 gap-2">
        {topStates.slice(0, 8).map((st) => (
          <a href={`/renters-insurance-calculator/${st.slug}/`} class="row-link py-2">
            <span class="truncate">{st.name}</span>
          </a>
        ))}
      </div>
    </div>

    <div class="flex flex-col gap-3">
      <a
        href="/business-insurance-calculator/#profession-search-section"
        class="mega-scroll-link flex items-center justify-between px-3 text-body-lg font-medium text-ink"
      >
        <span>Business Insurance</span>
        <span class="font-mono text-body-sm text-mute">35+ profiles</span>
      </a>
      <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
        {topProfessions.slice(0, 4).map((prof) => (
          <a href={`/business-insurance-calculator/${prof.slug}/`} class="row-link justify-start gap-3 py-2">
            <span class="material-symbols-outlined text-[18px] text-mute">{prof.icon}</span>
            <span>{prof.name}</span>
          </a>
        ))}
      </div>
    </div>

    <a href="/renters-insurance-calculator/#calculator" class="btn-primary w-full">
      Get Instant Estimate
    </a>
  </div>
</header>

<script>
  // Mobile drawer toggle
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  const setMenuOpen = (open: boolean) => {
    if (!menu || !iconOpen || !iconClose) return;
    menu.classList.toggle('hidden', !open);
    menu.classList.toggle('flex', open);
    iconOpen.classList.toggle('hidden', open);
    iconClose.classList.toggle('hidden', !open);
    toggleBtn?.setAttribute('aria-expanded', String(open));
  };

  if (toggleBtn && menu && iconOpen && iconClose) {
    toggleBtn.addEventListener('click', () => {
      setMenuOpen(menu.classList.contains('hidden'));
    });
  }

  // Smooth scroll handler for anchor links
  document.querySelectorAll('.mega-scroll-link').forEach((link) => {
    link.addEventListener('click', (e) => {
      const href = link.getAttribute('href');
      if (!href) return;

      const url = new URL(href, window.location.href);
      if (url.pathname === window.location.pathname && url.hash) {
        e.preventDefault();
        const targetEl = document.querySelector(url.hash);
        if (targetEl) {
          targetEl.scrollIntoView({ behavior: 'smooth' });
          // Close mobile menu if open
          if (menu && !menu.classList.contains('hidden')) {
            setMenuOpen(false);
          }
        }
      }
    });
  });
</script>
