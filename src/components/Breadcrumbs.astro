---
export interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items?: BreadcrumbItem[];
  class?: string;
  showHome?: boolean;
}

const { items = [], class: className = '', showHome = true } = Astro.props;

// Build full breadcrumb list starting with Home
const allItems: BreadcrumbItem[] = showHome
  ? [{ label: 'Home', href: '/' }, ...items]
  : items;

// Generate Schema.org BreadcrumbList JSON-LD for SEO
const siteUrl = Astro.site ? Astro.site.origin : 'https://insureestimate.com';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': allItems.map((item, index) => ({
    '@type': 'ListItem',
    'position': index + 1,
    'name': item.label,
    'item': item.href ? new URL(item.href, siteUrl).href : (Astro.url ? Astro.url.href : siteUrl)
  }))
};
---

<nav aria-label="Breadcrumb" class:list={["relative z-20 w-full", className]}>
  <!-- Schema.org JSON-LD for Search Engine Microdata -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

  <ol class="flex flex-wrap items-center gap-1.5 text-body-md text-mute">
    {allItems.map((item, index) => {
      const isLast = index === allItems.length - 1;

      return (
        <li class="inline-flex min-w-0 items-center gap-1.5">
          {index > 0 && (
            <span class="shrink-0 select-none text-faint" aria-hidden="true">/</span>
          )}

          {isLast ? (
            <span class="max-w-[220px] truncate font-medium text-ink sm:max-w-xs md:max-w-none" aria-current="page">
              {item.label}
            </span>
          ) : (
            <a href={item.href || '/'} class="rounded-sm transition-colors hover:text-ink">
              {item.label}
            </a>
          )}
        </li>
      );
    })}
  </ol>
</nav>
