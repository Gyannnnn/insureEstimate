---
interface Props {
  title: string;
  subtitle: string;
  category: string;
  badgeText?: string;
  statValue?: string;
  statLabel?: string;
  bgImage?: string;
}

const {
  title,
  subtitle,
  category,
  badgeText = '2026 Actuarial Model',
  statValue = '$15–$25',
  statLabel = 'Average Monthly Premium',
  bgImage
} = Astro.props;
---

<section class="container-page relative z-10 pb-10 pt-6 md:pb-12 md:pt-8">
  <div class="grid grid-cols-1 items-end gap-6 lg:grid-cols-[minmax(0,1fr)_320px] lg:gap-12">
    <div class="flex max-w-3xl flex-col gap-4">
      <div class="flex flex-wrap items-center gap-2">
        <span class="badge">{category}</span>
        <span class="font-mono text-body-sm text-mute">{badgeText}</span>
      </div>

      <h1 class="title-page">
        {title}
      </h1>

      <p class="lead">
        {subtitle}
      </p>
    </div>

    <!-- Stat highlight -->
    <div class="card relative flex flex-col justify-between gap-4 overflow-hidden p-5 sm:p-6">
      {bgImage && (
        <div class="absolute inset-0 bg-cover bg-center opacity-10" style={`background-image: url('${bgImage}')`}></div>
      )}
      <div class="relative z-10 flex flex-col gap-2">
        <span class="eyebrow">{statLabel}</span>
        <div class="num text-[32px] font-semibold leading-9 tracking-[-1.28px] text-ink lg:text-[36px] lg:leading-10">
          {statValue}
        </div>
      </div>
      <div class="relative z-10 flex items-center gap-2 border-t border-hairline pt-3 text-body-md text-body">
        <span class="material-symbols-outlined text-[16px] text-brand-ink">verified</span>
        Data-backed planning baseline
      </div>
    </div>
  </div>
</section>
