---
interface Props {
  title?: string;
  subtitle?: string;
  type?: 'renters' | 'business';
  entityName?: string;
  baseRate?: number;
  riskFactor?: number;
  defaultMinPrice?: string;
  defaultMaxPrice?: string;
  period?: string;
}

const {
  title = 'Insurance Cost Estimator',
  subtitle = 'Adjust parameters to model coverage projections.',
  type = 'renters',
  entityName = 'Selected Profile',
  baseRate = 180,
  riskFactor = 1.0,
  period = type === 'renters' ? '/ mo' : '/ yr'
} = Astro.props;
---

<div class="w-full py-stack-md z-10 relative">
  <div class="bg-surface-container-lowest rounded-2xl p-6 md:p-8 shadow-lg border border-outline-variant/30 scroll-mt-24" id="calculator-card">
    <div class="flex flex-col lg:flex-row gap-8 items-start justify-between">
      <!-- Controls Panel -->
      <div class="flex-1 w-full flex flex-col gap-6">
        <div>
          <span class="font-label-sm text-xs text-secondary uppercase tracking-widest block mb-1 font-semibold">
            Actuarial Calculation Engine
          </span>
          <h2 class="font-headline-lg text-headline-lg text-primary">{title}</h2>
          <p class="font-body-md text-on-surface-variant mt-1 text-sm">{subtitle}</p>
        </div>

        {type === 'renters' ? (
          <div class="flex flex-col gap-5" data-calc-type="renters" data-base-rate={baseRate}>
            <!-- Property Value Selector -->
            <div class="flex flex-col gap-2">
              <label class="font-label-sm text-xs text-on-surface" for="card-property-select">Personal Property Coverage</label>
              <select id="card-property-select" class="h-11 px-4 rounded-xl border border-outline-variant bg-surface-container-low text-on-surface text-sm focus:outline-none focus:ring-2 focus:ring-primary/20">
                <option value="10000">$10,000 (Minimal)</option>
                <option value="20000" selected>$20,000 (Standard Baseline)</option>
                <option value="30000">$30,000 (Recommended)</option>
                <option value="50000">$50,000 (High Asset)</option>
              </select>
            </div>

            <!-- Liability Selector & Deductible -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="flex flex-col gap-2">
                <label class="font-label-sm text-xs text-on-surface" for="card-liability-select">Liability Limit</label>
                <select id="card-liability-select" class="h-11 px-4 rounded-xl border border-outline-variant bg-surface-container-low text-on-surface text-sm focus:outline-none focus:ring-2 focus:ring-primary/20">
                  <option value="100000">$100,000 (Standard)</option>
                  <option value="300000" selected>$300,000 (Recommended)</option>
                  <option value="500000">$500,000 (Maximum)</option>
                </select>
              </div>

              <div class="flex flex-col gap-2">
                <label class="font-label-sm text-xs text-on-surface" for="card-deductible-select">Deductible Tier</label>
                <select id="card-deductible-select" class="h-11 px-4 rounded-xl border border-outline-variant bg-surface-container-low text-on-surface text-sm focus:outline-none focus:ring-2 focus:ring-primary/20">
                  <option value="500">$500 Deductible</option>
                  <option value="1000" selected>$1,000 Deductible (Standard)</option>
                  <option value="2500">$2,500 Deductible (High Savings)</option>
                </select>
              </div>
            </div>
          </div>
        ) : (
          <div class="flex flex-col gap-5" data-calc-type="business" data-risk-factor={riskFactor}>
            <!-- Revenue Tier Selector -->
            <div class="flex flex-col gap-2">
              <label class="font-label-sm text-xs text-on-surface" for="card-revenue-tier">Annual Revenue Tier</label>
              <select id="card-revenue-tier" class="h-11 px-4 rounded-xl border border-outline-variant bg-surface-container-low text-on-surface text-sm focus:outline-none focus:ring-2 focus:ring-primary/20">
                <option value="0-50k">$0 – $50,000 (Micro / Solo)</option>
                <option value="50-150k" selected>$50,000 – $150,000 (Growing Service)</option>
                <option value="150-500k">$150,000 – $500,000 (Mid-Sized Operations)</option>
                <option value="500k+">$500,000+ (High Revenue Tier)</option>
              </select>
            </div>

            <!-- Employee Count & Coverage Selector -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="flex flex-col gap-2">
                <label class="font-label-sm text-xs text-on-surface" for="card-employee-count">Employee Count</label>
                <input id="card-employee-count" type="number" min="0" max="500" step="1" value="1" class="h-11 px-4 rounded-xl border border-outline-variant bg-surface-container-low text-on-surface text-sm focus:outline-none focus:ring-2 focus:ring-primary/20" />
              </div>

              <div class="flex flex-col gap-2">
                <label class="font-label-sm text-xs text-on-surface" for="card-coverage-type">Coverage Type</label>
                <select id="card-coverage-type" class="h-11 px-4 rounded-xl border border-outline-variant bg-surface-container-low text-on-surface text-sm focus:outline-none focus:ring-2 focus:ring-primary/20">
                  <option value="GL">General Liability Only (GL)</option>
                  <option value="GL+EO" selected>General Liability + E&amp;O (GL+EO)</option>
                </select>
              </div>
            </div>
          </div>
        )}
      </div>

      <!-- Live Calculation Card Output Shell -->
      <div class="w-full lg:w-[380px] bg-surface-container-low rounded-xl p-6 border border-outline-variant/40 flex flex-col gap-4 shadow-sm shrink-0">
        <div class="flex items-center justify-between pb-3 border-b border-outline-variant/30">
          <span class="font-label-sm text-xs text-on-surface-variant uppercase font-semibold">Live Actuarial Estimate</span>
          <span class="material-symbols-outlined text-primary text-[20px]">analytics</span>
        </div>

        <!-- Inline Error Banner -->
        <div id="calc-error-banner" class="hidden p-3 rounded-lg bg-error-container text-error text-xs flex items-center gap-2">
          <span class="material-symbols-outlined text-[18px]">warning</span>
          <span id="calc-error-text">Invalid calculation input.</span>
        </div>

        <div id="calc-result-container">
          <div class="flex items-baseline gap-2">
            <span id="card-result-min" class="font-headline-lg text-[34px] font-bold text-primary font-data-tabular">$0</span>
            <span class="text-on-surface-variant font-body-md">–</span>
            <span id="card-result-max" class="font-headline-lg text-[34px] font-bold text-primary font-data-tabular">$0</span>
            <span id="card-result-period" class="text-on-surface-variant text-sm font-body-md">{period}</span>
          </div>
          <p class="font-body-md text-on-surface-variant text-[12px] mt-1">Calculated projection for {entityName}</p>
        </div>

        <!-- Dynamic Breakdown Section -->
        <div class="space-y-2 border-t border-outline-variant/30 pt-3 text-xs">
          <span class="font-label-sm text-[11px] text-primary uppercase font-bold tracking-wider block mb-1">Calculation Breakdown</span>
          <div id="calc-breakdown-list" class="space-y-1.5 text-on-surface-variant">
            <!-- Rendered dynamically -->
          </div>
        </div>

        <!-- Dynamic Disclaimer -->
        <div class="p-3 bg-surface-container-lowest rounded-lg border border-outline-variant/20 text-[11px] text-on-surface-variant flex gap-2 items-start leading-relaxed">
          <span class="material-symbols-outlined text-secondary text-[16px] shrink-0 mt-0.5">info</span>
          <span id="calc-disclaimer">Estimates are for informational purposes only and do not constitute binding insurance quotes.</span>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { calculateRentersPremium } from '../lib/calculators/rentersInsurance';
  import { calculateBusinessPremium } from '../lib/calculators/businessInsurance';

  document.addEventListener('DOMContentLoaded', () => {
    const rentersContainer = document.querySelector('[data-calc-type="renters"]');
    const businessContainer = document.querySelector('[data-calc-type="business"]');
    
    const minDisplay = document.getElementById('card-result-min');
    const maxDisplay = document.getElementById('card-result-max');
    const breakdownList = document.getElementById('calc-breakdown-list');
    const disclaimerText = document.getElementById('calc-disclaimer');
    const errorBanner = document.getElementById('calc-error-banner');
    const errorText = document.getElementById('calc-error-text');

    const updateRenters = () => {
      if (!rentersContainer || !minDisplay || !maxDisplay || !breakdownList || !disclaimerText) return;
      const baseRate = parseFloat(rentersContainer.getAttribute('data-base-rate') || '180');
      const propVal = parseInt((document.getElementById('card-property-select') as HTMLSelectElement)?.value || '20000');
      const liabVal = parseInt((document.getElementById('card-liability-select') as HTMLSelectElement)?.value || '300000');
      const dedVal = parseInt((document.getElementById('card-deductible-select') as HTMLSelectElement)?.value || '1000');

      try {
        if (errorBanner) errorBanner.classList.add('hidden');
        const res = calculateRentersPremium({
          stateBaseRate: baseRate,
          propertyValue: propVal as any,
          liabilityCoverage: liabVal as any,
          deductible: dedVal as any,
        });

        minDisplay.textContent = `$${Math.round(res.monthlyLow)}`;
        maxDisplay.textContent = `$${Math.round(res.monthlyHigh)}`;
        disclaimerText.textContent = res.disclaimer;

        breakdownList.innerHTML = res.breakdown
          .map(item => `
            <div class="flex justify-between items-center text-on-surface-variant">
              <span>${item.label}:</span>
              <span class="font-data-tabular text-on-surface font-medium">${item.value}</span>
            </div>
          `).join('');
      } catch (err: any) {
        if (errorBanner && errorText) {
          errorText.textContent = err.message || 'Validation error in input values.';
          errorBanner.classList.remove('hidden');
        }
      }
    };

    const updateBusiness = () => {
      if (!businessContainer || !minDisplay || !maxDisplay || !breakdownList || !disclaimerText) return;
      const riskFactor = parseFloat(businessContainer.getAttribute('data-risk-factor') || '1.0');
      const revTier = (document.getElementById('card-revenue-tier') as HTMLSelectElement)?.value || '50-150k';
      const empInputVal = (document.getElementById('card-employee-count') as HTMLInputElement)?.value;
      const empCount = empInputVal === '' || empInputVal === undefined ? 0 : parseFloat(empInputVal);
      const covType = (document.getElementById('card-coverage-type') as HTMLSelectElement)?.value || 'GL+EO';

      try {
        if (errorBanner) errorBanner.classList.add('hidden');
        const res = calculateBusinessPremium({
          professionRiskFactor: riskFactor,
          revenueTier: revTier as any,
          employeeCount: empCount,
          coverageType: covType as any,
        });

        minDisplay.textContent = `$${Math.round(res.low)}`;
        maxDisplay.textContent = `$${Math.round(res.high)}`;
        disclaimerText.textContent = res.disclaimer;

        breakdownList.innerHTML = res.breakdown
          .map(item => `
            <div class="flex justify-between items-center text-on-surface-variant">
              <span class="truncate pr-2">${item.label}:</span>
              <span class="font-data-tabular text-on-surface font-medium shrink-0">$${item.value}</span>
            </div>
          `).join('');
      } catch (err: any) {
        if (errorBanner && errorText) {
          errorText.textContent = err.message || 'Validation error in input values.';
          errorBanner.classList.remove('hidden');
        }
      }
    };

    if (rentersContainer) {
      document.getElementById('card-property-select')?.addEventListener('change', updateRenters);
      document.getElementById('card-liability-select')?.addEventListener('change', updateRenters);
      document.getElementById('card-deductible-select')?.addEventListener('change', updateRenters);
      updateRenters();
    }

    if (businessContainer) {
      document.getElementById('card-revenue-tier')?.addEventListener('change', updateBusiness);
      document.getElementById('card-employee-count')?.addEventListener('input', updateBusiness);
      document.getElementById('card-coverage-type')?.addEventListener('change', updateBusiness);
      updateBusiness();
    }
  });
</script>
