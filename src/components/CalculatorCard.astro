---
import { calculateRentersPremium } from '../lib/calculators/rentersInsurance';
import { calculateBusinessPremium } from '../lib/calculators/businessInsurance';

interface Props {
  title?: string;
  subtitle?: string;
  type?: 'renters' | 'business';
  entityName?: string;
  baseRate?: number;
  riskFactor?: number;
  defaultMinPrice?: string;
  defaultMaxPrice?: string;
  period?: string;
}

const {
  title = 'Insurance Cost Estimator',
  subtitle = 'Adjust parameters to model coverage projections.',
  type = 'renters',
  entityName = 'Selected Profile',
  baseRate = 180,
  riskFactor = 1.0,
  period = type === 'renters' ? '/ mo' : '/ yr'
} = Astro.props;

// Pre-render the estimate for the default control values below so the HTML carries a real
// number for crawlers and no-JS visitors. Invalid factors throw here and fail the build.
const initial = type === 'renters'
  ? calculateRentersPremium({ stateBaseRate: baseRate, propertyValue: 20000, liabilityCoverage: 300000, deductible: 1000 })
  : calculateBusinessPremium({ professionRiskFactor: riskFactor, revenueTier: '50-150k', employeeCount: 1, coverageType: 'GL+EO' });
const initialMin = Math.round(type === 'renters' ? initial.monthlyLow : initial.low);
const initialMax = Math.round(type === 'renters' ? initial.monthlyHigh : initial.high);

// Display-only formatting for breakdown values; must match formatValue() in the client script.
const formatValue = (label: string, value: number) => {
  if (type === 'business') return `$${value.toLocaleString('en-US')}`;
  return label === 'State base rate' ? `$${value.toLocaleString('en-US')}` : `×${value.toFixed(2)}`;
};
---

<div class="relative z-10 w-full">
  <div class="panel scroll-mt-24 overflow-hidden shadow-md" id="calculator-card">
    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_400px]">
      <!-- Controls -->
      <div class="flex flex-col gap-8 p-5 sm:p-8">
        <div class="flex flex-col gap-2">
          <span class="eyebrow">Actuarial Calculation Engine</span>
          <h2 class="text-2xl font-semibold leading-8 tracking-[-0.9px] text-ink">{title}</h2>
          <p class="text-body-md text-body">{subtitle}</p>
        </div>

        {type === 'renters' ? (
          <div class="flex flex-col gap-7" data-calc-type="renters" data-base-rate={baseRate}>
            <!-- 1. Personal property coverage -->
            <div class="flex flex-col gap-3">
              <div class="flex items-center justify-between gap-3">
                <label class="field-label" for="card-property-slider">Personal Property Coverage</label>
                <div class="num inline-flex items-baseline gap-1.5 text-body-md">
                  <span id="card-property-val" class="font-semibold text-ink">$20,000</span>
                  <span id="card-property-badge-label" class="text-mute">(Standard)</span>
                </div>
              </div>

              <input
                id="card-property-slider"
                type="range"
                min="0"
                max="3"
                step="1"
                value="1"
                class="range"
                style="--fill: 33.333%"
              />

              <div class="flex justify-between font-mono text-[11px] leading-4 text-mute">
                <span>$10k</span>
                <span>$20k</span>
                <span>$30k</span>
                <span>$50k</span>
              </div>
            </div>

            <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
              <!-- 2. Liability limit -->
              <div class="flex flex-col gap-2">
                <label class="field-label" for="card-liability-select">Liability Limit</label>
                <select id="card-liability-select" class="field-control">
                  <option value="100000">$100,000 (Standard)</option>
                  <option value="300000" selected>$300,000 (Recommended)</option>
                  <option value="500000">$500,000 (Maximum)</option>
                </select>
              </div>

              <!-- 3. Deductible tier -->
              <div class="flex flex-col gap-2">
                <label class="field-label" for="card-deductible-select">Deductible Tier</label>
                <select id="card-deductible-select" class="field-control">
                  <option value="500">$500 Deductible</option>
                  <option value="1000" selected>$1,000 Deductible (Standard)</option>
                  <option value="2500">$2,500 Deductible (High Savings)</option>
                </select>
              </div>
            </div>
          </div>
        ) : (
          <div class="flex flex-col gap-7" data-calc-type="business" data-risk-factor={riskFactor}>
            <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
              <!-- 1. Annual revenue tier -->
              <div class="flex flex-col gap-2">
                <label class="field-label" for="card-revenue-tier">Annual Revenue Tier</label>
                <select id="card-revenue-tier" class="field-control">
                  <option value="0-50k">$0 – $50,000 (Micro / Solo)</option>
                  <option value="50-150k" selected>$50,000 – $150,000 (Growing Service)</option>
                  <option value="150-500k">$150,000 – $500,000 (Mid-Sized Operations)</option>
                  <option value="500k+">$500,000+ (High Revenue Tier)</option>
                </select>
              </div>

              <!-- 2. Coverage type -->
              <div class="flex flex-col gap-2">
                <label class="field-label" for="card-coverage-type">Coverage Type</label>
                <select id="card-coverage-type" class="field-control">
                  <option value="GL">General Liability Only (GL)</option>
                  <option value="GL+EO" selected>General Liability + E&amp;O (GL+EO)</option>
                </select>
              </div>
            </div>

            <!-- 3. Employee count -->
            <div class="flex flex-col gap-3">
              <div class="flex items-center justify-between gap-3">
                <label class="field-label" for="card-employee-count">Employee Count</label>
                <div class="num inline-flex items-baseline gap-1.5 text-body-md">
                  <span id="card-employee-count-val" class="font-semibold text-ink">1</span>
                  <span id="card-employee-label" class="text-mute">employee</span>
                </div>
              </div>

              <input
                id="card-employee-count"
                type="range"
                min="0"
                max="100"
                step="1"
                value="1"
                class="range"
                style="--fill: 1%"
              />

              <div class="flex justify-between font-mono text-[11px] leading-4 text-mute">
                <span>0 (Solo)</span>
                <span>25</span>
                <span>50</span>
                <span>75</span>
                <span>100+</span>
              </div>
            </div>
          </div>
        )}
      </div>

      <!-- Live estimate -->
      <div class="flex flex-col gap-6 border-t border-hairline bg-canvas p-5 sm:p-8 lg:border-l lg:border-t-0">
        <div class="flex items-center justify-between">
          <span class="eyebrow">Live Actuarial Estimate</span>
          <span class="inline-flex items-center gap-1.5 font-mono text-[11px] uppercase text-mute">
            <span class="h-1.5 w-1.5 rounded-full bg-brand" aria-hidden="true"></span>
            Live
          </span>
        </div>

        <!-- Inline Error Banner -->
        <div id="calc-error-banner" class="hidden flex items-center gap-2 rounded-lg border border-error/20 bg-error-container p-3 text-body-md text-error" role="alert">
          <span class="material-symbols-outlined text-[18px]">warning</span>
          <span id="calc-error-text"></span>
        </div>

        <div id="calc-result-container" aria-live="polite">
          <div class="num flex flex-wrap items-baseline gap-x-2 text-ink">
            <span id="card-result-min" class="text-[40px] font-semibold leading-[44px] tracking-[-1.8px] sm:text-[48px] sm:leading-[52px] sm:tracking-[-2.4px]">${initialMin}</span>
            <span class="text-[28px] font-normal text-faint" aria-hidden="true">–</span>
            <span id="card-result-max" class="text-[40px] font-semibold leading-[44px] tracking-[-1.8px] sm:text-[48px] sm:leading-[52px] sm:tracking-[-2.4px]">${initialMax}</span>
            <span id="card-result-period" class="text-body-lg text-mute">{period}</span>
          </div>
          <p class="mt-2 text-body-md text-body">Calculated projection for {entityName}</p>
        </div>

        <!-- Breakdown -->
        <div class="flex flex-col gap-2">
          <span class="text-label-sm text-ink">Calculation Breakdown</span>
          <div id="calc-breakdown-list" class="divide-y divide-hairline rounded-lg border border-hairline bg-elevated">
            {initial.breakdown.map(item => (
              <div class="flex items-center justify-between gap-3 px-3 py-2.5 text-body-md">
                <span class={`text-body${type === 'business' ? ' min-w-0 truncate' : ''}`}>{item.label}</span>
                <span class="num shrink-0 font-mono text-[13px] font-medium text-ink">{formatValue(item.label, item.value)}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Disclaimer -->
        <p class="mt-auto flex items-start gap-2 text-body-sm text-mute">
          <span class="material-symbols-outlined mt-px shrink-0 text-[16px]">info</span>
          <span id="calc-disclaimer">{initial.disclaimer}</span>
        </p>
      </div>
    </div>
  </div>
</div>

<script>
  import { calculateRentersPremium } from '../lib/calculators/rentersInsurance';
  import { calculateBusinessPremium } from '../lib/calculators/businessInsurance';

  document.addEventListener('DOMContentLoaded', () => {
    const rentersContainer = document.querySelector('[data-calc-type="renters"]');
    const businessContainer = document.querySelector('[data-calc-type="business"]');

    const minDisplay = document.getElementById('card-result-min');
    const maxDisplay = document.getElementById('card-result-max');
    const breakdownList = document.getElementById('calc-breakdown-list');
    const disclaimerText = document.getElementById('calc-disclaimer');
    const errorBanner = document.getElementById('calc-error-banner');
    const errorText = document.getElementById('calc-error-text');

    const PROPERTY_TIERS = [10000, 20000, 30000, 50000];
    const PROPERTY_LABELS = ['(Minimal)', '(Standard)', '(Recommended)', '(High Asset)'];

    // Display-only helpers: paint the filled part of a range track, format breakdown values.
    const paintRange = (el: HTMLInputElement | null) => {
      if (!el) return;
      const min = Number(el.min || 0);
      const max = Number(el.max || 100);
      const pct = max > min ? ((Number(el.value) - min) / (max - min)) * 100 : 0;
      el.style.setProperty('--fill', `${pct}%`);
    };
    const formatValue = (type: 'renters' | 'business', label: string, value: number) => {
      if (type === 'business') return `$${value.toLocaleString('en-US')}`;
      return label === 'State base rate' ? `$${value.toLocaleString('en-US')}` : `×${value.toFixed(2)}`;
    };
    const renderBreakdown = (type: 'renters' | 'business', items: { label: string; value: number }[]) =>
      items
        .map(item => `
          <div class="flex items-center justify-between gap-3 px-3 py-2.5 text-body-md">
            <span class="text-body${type === 'business' ? ' min-w-0 truncate' : ''}">${item.label}</span>
            <span class="num shrink-0 font-mono text-[13px] font-medium text-ink">${formatValue(type, item.label, item.value)}</span>
          </div>
        `).join('');

    const updateRenters = () => {
      if (!rentersContainer || !minDisplay || !maxDisplay || !breakdownList || !disclaimerText) return;
      const baseRate = parseFloat(rentersContainer.getAttribute('data-base-rate') || '180');

      const propSlider = document.getElementById('card-property-slider') as HTMLInputElement;
      const sliderIdx = parseInt(propSlider?.value || '1');
      const propVal = PROPERTY_TIERS[sliderIdx] || 20000;
      paintRange(propSlider);

      const propValDisplay = document.getElementById('card-property-val');
      const propBadgeLabel = document.getElementById('card-property-badge-label');
      if (propValDisplay) {
        propValDisplay.textContent = `$${propVal.toLocaleString('en-US')}`;
      }
      if (propBadgeLabel) {
        propBadgeLabel.textContent = PROPERTY_LABELS[sliderIdx] || '';
      }

      const liabVal = parseInt((document.getElementById('card-liability-select') as HTMLSelectElement)?.value || '300000');
      const dedVal = parseInt((document.getElementById('card-deductible-select') as HTMLSelectElement)?.value || '1000');

      try {
        if (errorBanner) errorBanner.classList.add('hidden');
        const res = calculateRentersPremium({
          stateBaseRate: baseRate,
          propertyValue: propVal as any,
          liabilityCoverage: liabVal as any,
          deductible: dedVal as any,
        });

        minDisplay.textContent = `$${Math.round(res.monthlyLow)}`;
        maxDisplay.textContent = `$${Math.round(res.monthlyHigh)}`;
        disclaimerText.textContent = res.disclaimer;

        breakdownList.innerHTML = renderBreakdown('renters', res.breakdown);
      } catch (err: any) {
        if (errorBanner && errorText) {
          errorText.textContent = err.message || 'Validation error in input values.';
          errorBanner.classList.remove('hidden');
        }
      }
    };

    const updateBusiness = () => {
      if (!businessContainer || !minDisplay || !maxDisplay || !breakdownList || !disclaimerText) return;
      const riskFactor = parseFloat(businessContainer.getAttribute('data-risk-factor') || '1.0');
      const revTier = (document.getElementById('card-revenue-tier') as HTMLSelectElement)?.value || '50-150k';
      const empInput = document.getElementById('card-employee-count') as HTMLInputElement | null;
      const empInputVal = empInput?.value;
      const empCount = empInputVal === '' || empInputVal === undefined ? 0 : parseFloat(empInputVal);
      const covType = (document.getElementById('card-coverage-type') as HTMLSelectElement)?.value || 'GL+EO';
      paintRange(empInput);

      const empValDisplay = document.getElementById('card-employee-count-val');
      const empLabelDisplay = document.getElementById('card-employee-label');
      if (empValDisplay) {
        empValDisplay.textContent = Math.round(empCount).toString();
      }
      if (empLabelDisplay) {
        empLabelDisplay.textContent = Math.round(empCount) === 1 ? 'employee' : 'employees';
      }

      try {
        if (errorBanner) errorBanner.classList.add('hidden');
        const res = calculateBusinessPremium({
          professionRiskFactor: riskFactor,
          revenueTier: revTier as any,
          employeeCount: empCount,
          coverageType: covType as any,
        });

        minDisplay.textContent = `$${Math.round(res.low)}`;
        maxDisplay.textContent = `$${Math.round(res.high)}`;
        disclaimerText.textContent = res.disclaimer;

        breakdownList.innerHTML = renderBreakdown('business', res.breakdown);
      } catch (err: any) {
        if (errorBanner && errorText) {
          errorText.textContent = err.message || 'Validation error in input values.';
          errorBanner.classList.remove('hidden');
        }
      }
    };

    if (rentersContainer) {
      const propSlider = document.getElementById('card-property-slider');
      if (propSlider) {
        propSlider.addEventListener('input', updateRenters);
        propSlider.addEventListener('change', updateRenters);
      }
      document.getElementById('card-liability-select')?.addEventListener('change', updateRenters);
      document.getElementById('card-deductible-select')?.addEventListener('change', updateRenters);
      updateRenters();
    }

    if (businessContainer) {
      document.getElementById('card-revenue-tier')?.addEventListener('change', updateBusiness);
      const empInput = document.getElementById('card-employee-count');
      if (empInput) {
        empInput.addEventListener('input', updateBusiness);
        empInput.addEventListener('change', updateBusiness);
      }
      document.getElementById('card-coverage-type')?.addEventListener('change', updateBusiness);
      updateBusiness();
    }
  });
</script>
