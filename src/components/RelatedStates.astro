---
import { getRelatedStatesForPage, type StateData } from '../lib/relatedStates';

interface Props {
  currentState: StateData;
  allStates: StateData[];
}

const { currentState, allStates } = Astro.props;
const { regionalStates, similarRateStates, popularStates, regionGroups } = getRelatedStatesForPage(currentState, allStates);

const currentRegion = currentState.data.region;


function getRateDiffLabel(targetMonthly: number, currentMonthlyVal: number): { text: string; isHigher: boolean; isSame: boolean } {
  const diff = targetMonthly - currentMonthlyVal;
  if (Math.abs(diff) <= 1) {
    return { text: 'Similar rate', isHigher: false, isSame: true };
  }
  if (diff > 0) {
    return { text: `+$${diff}/mo`, isHigher: true, isSame: false };
  }
  return { text: `-$${Math.abs(diff)}/mo`, isHigher: false, isSame: false };
}

const currentMonthly = Math.round(currentState.data.baseRate * 0.088);

const tabs = [
  { id: 'regional', icon: 'explore', label: `Regional & Nearby (${regionalStates.length})` },
  { id: 'similar', icon: 'equalizer', label: `Similar Price Tier (${similarRateStates.length})` },
  { id: 'popular', icon: 'trending_up', label: `National Benchmarks (${popularStates.length})` },
];

const cardClass = 'card-link group flex flex-col justify-between gap-5 p-5';
const tagClass = 'rounded-full px-2 py-0.5 font-mono text-[11px] font-medium leading-4';
---

<section id="related-states" class="w-full scroll-mt-24 border-t border-hairline pt-16">
  <div class="mb-8 flex max-w-3xl flex-col gap-3">
    <span class="eyebrow">State Comparison Matrix</span>
    <h2 class="title-section">
      Compare Renters Insurance with Other States
    </h2>
    <p class="lead">
      Renters insurance rates vary widely across state lines due to regional perils, weather trends, and housing age. Explore localized calculator profiles in neighboring {currentRegion} states and similar cost tiers.
    </p>
  </div>

  <div class="flex w-full flex-col gap-6">
    <!-- Tab controls -->
    <div class="inline-flex max-w-full flex-wrap gap-1 self-start rounded-lg border border-hairline bg-hairline-soft p-1" role="tablist" aria-label="Compare states">
      {tabs.map((tab, i) => (
        <button
          type="button"
          role="tab"
          id={`rs-tab-${tab.id}`}
          aria-controls={`rs-panel-${tab.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          data-rs-tab={tab.id}
          class="inline-flex h-8 items-center gap-1.5 rounded-md px-3 text-body-md text-body transition-colors hover:text-ink aria-selected:bg-elevated aria-selected:font-medium aria-selected:text-ink aria-selected:shadow-sm"
        >
          <span class="material-symbols-outlined text-[16px]">{tab.icon}</span>
          <span>{tab.label}</span>
        </button>
      ))}
    </div>

    <!-- Regional & nearby states -->
    <div id="rs-panel-regional" role="tabpanel" aria-labelledby="rs-tab-regional" data-rs-panel="regional" class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {regionalStates.map(state => {
        const diff = getRateDiffLabel(state.monthlyCost, currentMonthly);
        return (
          <a href={state.href} class={cardClass}>
            <div class="flex flex-col gap-4">
              <div class="flex items-center justify-between gap-2">
                <span class={`${tagClass} bg-hairline-soft uppercase text-body`}>{state.region}</span>
                <span class:list={[
                  tagClass,
                  diff.isSame ? 'bg-hairline-soft text-body' : diff.isHigher ? 'bg-warning-soft text-warning-deep' : 'bg-brand-soft text-brand-ink',
                ]}>
                  {diff.text} vs {currentState.data.abbreviation}
                </span>
              </div>
              <div>
                <h3 class="text-heading-md text-ink">{state.name}</h3>
                <span class="text-body-md text-mute">{state.abbreviation} State Profile</span>
              </div>
            </div>
            <div class="flex items-center justify-between border-t border-hairline pt-4">
              <div class="num flex items-baseline gap-1.5">
                <span class="text-body-lg font-semibold text-ink">${state.annualCost}</span>
                <span class="text-body-md text-mute">/yr (${state.monthlyCost}/mo)</span>
              </div>
              <span class="inline-flex items-center text-body-md font-medium text-ink">
                View Rates <span class="material-symbols-outlined ml-0.5 text-[18px] text-mute group-hover:text-ink">chevron_right</span>
              </span>
            </div>
          </a>
        );
      })}
    </div>

    <!-- Similar price tier -->
    <div id="rs-panel-similar" role="tabpanel" aria-labelledby="rs-tab-similar" data-rs-panel="similar" hidden class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {similarRateStates.map(state => (
        <a href={state.href} class={cardClass}>
          <div class="flex flex-col gap-4">
            <div class="flex items-center justify-between gap-2">
              <span class={`${tagClass} bg-hairline-soft uppercase text-body`}>{state.region}</span>
              <span class={`${tagClass} bg-hairline-soft text-ink`}>Matching Base Rate</span>
            </div>
            <div>
              <h3 class="text-heading-md text-ink">{state.name}</h3>
              <span class="text-body-md text-mute">{state.abbreviation} State Profile</span>
            </div>
          </div>
          <div class="flex items-center justify-between border-t border-hairline pt-4">
            <div class="num flex items-baseline gap-1.5">
              <span class="text-body-lg font-semibold text-ink">${state.annualCost}</span>
              <span class="text-body-md text-mute">/yr (${state.monthlyCost}/mo)</span>
            </div>
            <span class="inline-flex items-center text-body-md font-medium text-ink">
              View Rates <span class="material-symbols-outlined ml-0.5 text-[18px] text-mute group-hover:text-ink">chevron_right</span>
            </span>
          </div>
        </a>
      ))}
    </div>

    <!-- National benchmarks -->
    <div id="rs-panel-popular" role="tabpanel" aria-labelledby="rs-tab-popular" data-rs-panel="popular" hidden class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {popularStates.map(state => (
        <a href={state.href} class={cardClass}>
          <div class="flex flex-col gap-4">
            <div class="flex items-center justify-between gap-2">
              <span class={`${tagClass} bg-hairline-soft uppercase text-body`}>{state.region}</span>
              <span class={`${tagClass} bg-brand-soft text-brand-ink`}>Benchmark</span>
            </div>
            <div>
              <h3 class="text-heading-md text-ink">{state.name}</h3>
              <span class="text-body-md text-mute">{state.abbreviation} State Profile</span>
            </div>
          </div>
          <div class="flex items-center justify-between border-t border-hairline pt-4">
            <div class="num flex items-baseline gap-1.5">
              <span class="text-body-lg font-semibold text-ink">${state.annualCost}</span>
              <span class="text-body-md text-mute">/yr (${state.monthlyCost}/mo)</span>
            </div>
            <span class="inline-flex items-center text-body-md font-medium text-ink">
              View Rates <span class="material-symbols-outlined ml-0.5 text-[18px] text-mute group-hover:text-ink">chevron_right</span>
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>

  <!-- Full 50-state directory for crawling and quick access -->
  <div class="panel mt-12 p-5 sm:p-8">
    <div class="mb-6 flex flex-col justify-between gap-4 border-b border-hairline pb-6 md:flex-row md:items-end">
      <div>
        <h3 class="text-heading-md text-ink">All 50 State Renters Insurance Calculators</h3>
        <p class="mt-1 text-body-md text-body">
          Select any US state below to view actuarial rate breakdowns and personalized policy estimates.
        </p>
      </div>
      <a href="/renters-insurance-calculator/" class="btn-ghost-sm shrink-0">
        View Full Index
      </a>
    </div>

    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {Object.entries(regionGroups).map(([regionName, items]) => (
        <div class="flex flex-col gap-2">
          <h4 class="flex items-center justify-between border-b border-hairline pb-2 text-label-sm text-ink">
            <span>{regionName} Region</span>
            <span class="font-mono text-[11px] font-normal text-mute">{items.length} states</span>
          </h4>
          <ul class="flex flex-col text-body-md">
            {items.map(item => {
              const isCurrent = item.slug === currentState.data.slug;
              return (
                <li>
                  {isCurrent ? (
                    <span class="-mx-2 flex items-center justify-between rounded-md bg-hairline-soft px-2 py-1.5 font-medium text-ink" aria-current="page">
                      <span>{item.name} ({item.abbreviation})</span>
                      <span class="font-mono text-[10px] uppercase text-mute">Current</span>
                    </span>
                  ) : (
                    <a
                      href={item.href}
                      class="group -mx-2 flex items-center justify-between rounded-md px-2 py-1.5 text-body transition-colors hover:bg-hairline-soft hover:text-ink"
                    >
                      <span>{item.name}</span>
                      <span class="num font-mono text-[11px] text-faint group-hover:text-mute">${item.monthlyCost}/mo</span>
                    </a>
                  )}
                </li>
              );
            })}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  // Tab switcher for the comparison clusters.
  const tabButtons = document.querySelectorAll<HTMLButtonElement>('#related-states [data-rs-tab]');
  const tabPanels = document.querySelectorAll<HTMLElement>('#related-states [data-rs-panel]');

  tabButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.rsTab;
      tabButtons.forEach((b) => b.setAttribute('aria-selected', String(b === btn)));
      tabPanels.forEach((panel) => {
        panel.hidden = panel.dataset.rsPanel !== target;
      });
    });
  });
</script>
