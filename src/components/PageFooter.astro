---
import { getCollection } from 'astro:content';

const allStatesRaw = await getCollection('states');
const allStates = allStatesRaw.sort((a, b) => a.data.name.localeCompare(b.data.name));

const allProfessionsRaw = await getCollection('professions');
const allProfessions = allProfessionsRaw.sort((a, b) => a.data.name.localeCompare(b.data.name));


const linkClass = 'text-body-md text-body transition-colors hover:text-ink';
---

<footer class="relative z-10 mt-24 w-full border-t border-hairline bg-canvas">
  <div class="container-page flex flex-col gap-12 py-16">

    <!-- Brand + primary link groups -->
    <div class="grid grid-cols-1 gap-10 md:grid-cols-[1.6fr_1fr_1fr]">
      <div class="flex max-w-md flex-col gap-4">
        <a href="/" class="flex w-max items-center rounded-md py-0.5" aria-label="InsureEstimate home">
          <span class="text-[20px] font-semibold leading-none tracking-[-0.6px] text-ink">Insure</span>
          <span class="text-[20px] font-semibold leading-none tracking-[-0.6px] text-brand-ink">Estimate</span>
          <span class="mb-0.5 ml-0.5 inline-block h-1.5 w-1.5 self-end rounded-full bg-brand" aria-hidden="true"></span>
        </a>
        <p class="text-body-md text-body">
          Providing transparent, data-driven insurance premium estimates across all 50 US States and 35+ professional categories based on statutory insurance filings and actuarial risk benchmarks.
        </p>
        <div class="flex flex-wrap items-center gap-2">
          <span class="badge">50 US States</span>
          <span class="badge">35+ Business Models</span>
        </div>
      </div>

      <div class="flex flex-col gap-4">
        <h4 class="text-label-sm text-ink">Core Estimator Hubs</h4>
        <nav class="flex flex-col gap-3" aria-label="Calculators">
          <a class={linkClass} href="/renters-insurance-calculator/">Renters Insurance Calculator</a>
          <a class={linkClass} href="/business-insurance-calculator/">Business Insurance Calculator</a>
          <a class={linkClass} href="/renters-insurance-calculator/#browse-states">State Renters Directory</a>
        </nav>
      </div>

      <div class="flex flex-col gap-4">
        <h4 class="text-label-sm text-ink">Company &amp; Governance</h4>
        <nav class="flex flex-col gap-3" aria-label="Company">
          <a class={linkClass} href="/about/">About Us</a>
          <a class={linkClass} href="/contact/">Contact Support</a>
          <a class={linkClass} href="/privacy-policy/">Privacy Policy</a>
          <a class={linkClass} href="/terms-and-conditions/">Terms &amp; Conditions</a>
        </nav>
      </div>
    </div>

    <!-- All 50 states -->
    <div class="flex flex-col gap-4 border-t border-hairline pt-10">
      <h3 class="text-label-sm text-ink">Renters Insurance by State</h3>
      <div class="grid grid-cols-2 gap-x-6 gap-y-2.5 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5">
        {allStates.map((st) => (
          <a href={`/renters-insurance-calculator/${st.data.slug}/`} class={`${linkClass} w-max`}>
            {st.data.name}
          </a>
        ))}
      </div>
    </div>

    <!-- All professions -->
    <div class="flex flex-col gap-4 border-t border-hairline pt-10">
      <h3 class="text-label-sm text-ink">Business Insurance by Profession</h3>
      <div class="grid grid-cols-2 gap-x-6 gap-y-2.5 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5">
        {allProfessions.map((prof) => (
          <a href={`/business-insurance-calculator/${prof.data.slug}/`} class={`${linkClass} w-max max-w-full truncate`}>
            {prof.data.name}
          </a>
        ))}
      </div>
    </div>

    <!-- Legal row -->
    <div class="flex flex-col gap-6 border-t border-hairline pt-8 md:flex-row md:items-start md:justify-between">
      <p class="max-w-2xl text-body-sm text-mute">
        Disclaimer: InsureEstimate premium projections are calculated using statutory regulatory filings, state loss ratios, and industry actuarial risk models. Estimates are for informational purposes and do not constitute binding insurance quotes.
      </p>
      <div class="flex shrink-0 flex-wrap items-center gap-x-5 gap-y-2 text-body-sm">
        <span class="text-body">© {new Date().getFullYear()} InsureEstimate.</span>
        <a href="/privacy-policy/" class="text-mute transition-colors hover:text-ink">Privacy</a>
        <a href="/terms-and-conditions/" class="text-mute transition-colors hover:text-ink">Terms</a>
        <a href="/contact/" class="text-mute transition-colors hover:text-ink">Contact</a>
      </div>
    </div>

  </div>
</footer>
