---
import { getCollection } from 'astro:content';

const allStatesRaw = await getCollection('states');
const allStates = allStatesRaw.sort((a, b) => a.data.name.localeCompare(b.data.name));

const allProfessionsRaw = await getCollection('professions');
const allProfessions = allProfessionsRaw.sort((a, b) => a.data.name.localeCompare(b.data.name));
---

<footer class="w-full bg-white border-t border-outline-variant/30 mt-stack-lg relative z-10">
  <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-stack-lg flex flex-col gap-8">
    
    <!-- TOP ROW: BRAND & QUICK LINKS -->
    <div class="grid grid-cols-1 md:grid-cols-[1.5fr_1fr_1fr] gap-8 border-b border-outline-variant/20 pb-8">
      
      <!-- Brand Column -->
      <div class="flex flex-col gap-3">
        <a href="/" class="flex items-center gap-3 group focus:outline-none w-max">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-primary to-primary/80 flex items-center justify-center text-on-primary font-bold text-sm shadow-md group-hover:scale-105 transition-transform duration-300">
            IE
          </div>
          <div class="flex flex-col">
            <span class="font-headline-md text-lg tracking-tight text-primary font-bold leading-none">InsureEstimate</span>
            <span class="text-[11px] text-on-surface-variant font-data-tabular mt-0.5">Actuarial Cost Intelligence Engine</span>
          </div>
        </a>
        <p class="text-xs text-on-surface-variant leading-relaxed max-w-md">
          Providing transparent, data-driven insurance premium estimates across all 50 US States and 35+ professional categories based on statutory insurance filings and actuarial risk benchmarks.
        </p>
        <div class="flex items-center gap-2 mt-1">
          <span class="px-2.5 py-1 rounded-full bg-primary/10 text-primary text-[10px] font-label-sm font-semibold uppercase tracking-wider">
            50 US States
          </span>
          <span class="px-2.5 py-1 rounded-full bg-secondary/10 text-secondary text-[10px] font-label-sm font-semibold uppercase tracking-wider">
            35+ Business Models
          </span>
        </div>
      </div>

      <!-- Calculators Column -->
      <div class="flex flex-col gap-3">
        <h4 class="font-label-sm text-xs text-primary uppercase font-bold tracking-wider">Core Estimator Hubs</h4>
        <nav class="flex flex-col gap-2.5 text-xs">
          <a class="group text-on-surface-variant hover:text-primary transition-colors font-medium flex items-center gap-2 w-max" href="/renters-insurance-calculator/">
            <span class="material-symbols-outlined text-[16px] text-secondary">home_work</span>
            <span class="relative after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-[1.5px] after:bg-primary after:transition-all after:duration-300 group-hover:after:w-full">
              Renters Insurance Calculator
            </span>
          </a>
          <a class="group text-on-surface-variant hover:text-primary transition-colors font-medium flex items-center gap-2 w-max" href="/business-insurance-calculator/">
            <span class="material-symbols-outlined text-[16px] text-primary">business_center</span>
            <span class="relative after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-[1.5px] after:bg-primary after:transition-all after:duration-300 group-hover:after:w-full">
              Business Insurance Calculator
            </span>
          </a>
          <a class="group text-on-surface-variant hover:text-primary transition-colors font-medium flex items-center gap-2 w-max" href="/renters-insurance-calculator/#browse-states">
            <span class="material-symbols-outlined text-[16px] text-on-surface-variant">map</span>
            <span class="relative after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-[1.5px] after:bg-primary after:transition-all after:duration-300 group-hover:after:w-full">
              State Renters Directory
            </span>
          </a>
        </nav>
      </div>

      <!-- Platform Links -->
      <div class="flex flex-col gap-3">
        <h4 class="font-label-sm text-xs text-primary uppercase font-bold tracking-wider">Platform &amp; Navigation</h4>
        <nav class="flex flex-col gap-2.5 text-xs">
          <a class="group text-on-surface-variant hover:text-primary transition-colors font-medium w-max" href="/">
            <span class="relative after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-[1.5px] after:bg-primary after:transition-all after:duration-300 group-hover:after:w-full">
              Home Page
            </span>
          </a>
          <a class="group text-on-surface-variant hover:text-primary transition-colors font-medium w-max" href="/business-insurance-calculator/#profession-search-section">
            <span class="relative after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-[1.5px] after:bg-primary after:transition-all after:duration-300 group-hover:after:w-full">
              Profession Search
            </span>
          </a>
          <a class="group text-on-surface-variant hover:text-primary transition-colors font-medium w-max" href="/#methodology">
            <span class="relative after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-[1.5px] after:bg-primary after:transition-all after:duration-300 group-hover:after:w-full">
              Actuarial Methodology
            </span>
          </a>
        </nav>
      </div>

    </div>

    <!-- SECTION 1: ALL 50 STATES RENTERS INSURANCE DIRECTORY -->
    <div class="flex flex-col gap-3 border-b border-outline-variant/20 pb-8">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-1">
        <div class="flex items-center gap-2">
          <span class="material-symbols-outlined text-secondary text-[20px]">location_on</span>
          <h3 class="font-headline-md text-xs font-bold text-primary uppercase tracking-wider font-label-sm">
            Renters Insurance by State
          </h3>
          <span class="px-2 py-0.5 rounded bg-surface-container-high text-on-surface-variant text-[10px] font-data-tabular font-semibold">
            All 50 States
          </span>
        </div>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-x-6 gap-y-2">
        {allStates.map((st) => (
          <a 
            href={`/renters-insurance-calculator/${st.data.slug}/`}
            class="text-xs text-on-surface-variant hover:text-primary transition-colors font-medium py-0.5 group w-max"
          >
            <span class="relative after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-[1.5px] after:bg-primary after:transition-all after:duration-300 group-hover:after:w-full">
              {st.data.name}
            </span>
          </a>
        ))}
      </div>
    </div>

    <!-- SECTION 2: ALL BUSINESS PROFESSIONS DIRECTORY -->
    <div class="flex flex-col gap-3 border-b border-outline-variant/20 pb-8">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-1">
        <div class="flex items-center gap-2">
          <span class="material-symbols-outlined text-primary text-[20px]">work</span>
          <h3 class="font-headline-md text-xs font-bold text-primary uppercase tracking-wider font-label-sm">
            Business Insurance by Profession
          </h3>
          <span class="px-2 py-0.5 rounded bg-surface-container-high text-on-surface-variant text-[10px] font-data-tabular font-semibold">
            {allProfessions.length} Professions
          </span>
        </div>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-x-6 gap-y-2">
        {allProfessions.map((prof) => (
          <a 
            href={`/business-insurance-calculator/${prof.data.slug}/`}
            class="text-xs text-on-surface-variant hover:text-primary transition-colors font-medium py-0.5 group w-max"
          >
            <span class="relative after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-[1.5px] after:bg-primary after:transition-all after:duration-300 group-hover:after:w-full">
              {prof.data.name}
            </span>
          </a>
        ))}
      </div>
    </div>

    <!-- BOTTOM LEGAL & COPYRIGHT ROW -->
    <div class="flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-on-surface-variant text-center md:text-left pt-2">
      <p class="font-body-md italic max-w-2xl text-[11px]">
        Disclaimer: InsureEstimate premium projections are calculated using statutory regulatory filings, state loss ratios, and industry actuarial risk models. Estimates are for informational purposes and do not constitute binding insurance quotes.
      </p>
      <div class="flex items-center gap-3 shrink-0">
        <span class="font-data-tabular font-medium text-[11px]">
          © {new Date().getFullYear()} InsureEstimate. All rights reserved.
        </span>
      </div>
    </div>

  </div>
</footer>
